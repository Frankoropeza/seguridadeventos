---
export interface Props {
  titulo: string;
  descripcion: string;
  slug: string;
  categoria?: string;
  imagen?: string;
  readTime?: number;
}

const { titulo, descripcion, slug, categoria = "Blog", imagen, readTime = 5 } = Astro.props;
---

<article class="group flex flex-col bg-primary border border-primary-light rounded-xl overflow-hidden hover:border-secondary/40 transition-all duration-300 hover:shadow-lg hover:shadow-secondary/10">
  <!-- Imagen o placeholder -->
  <div class="relative h-48 overflow-hidden bg-primary-light">
    {imagen ? (
      <img
        src={imagen}
        alt={titulo}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        decoding="async"
        width="480"
        height="270"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="1" opacity="0.3" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
    )}
    <div class="absolute top-3 left-3">
      <span class="bg-secondary text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
        {categoria}
      </span>
    </div>
  </div>

  <!-- Contenido -->
  <div class="flex flex-col flex-1 p-5">
    <h3 class="text-light font-bold text-base leading-tight mb-2 group-hover:text-secondary transition-colors line-clamp-2">
      <a href={`/blog/${slug}`} class="stretched-link after:absolute after:inset-0">
        {titulo}
      </a>
    </h3>
    <p class="text-accent text-sm leading-relaxed flex-1 line-clamp-3">{descripcion}</p>

    <div class="flex items-center justify-between mt-4 pt-4 border-t border-primary-light">
      <span class="text-accent text-xs flex items-center gap-1">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
        </svg>
        {readTime} min de lectura
      </span>
      <span class="text-secondary text-xs font-semibold flex items-center gap-1">
        Leer artículo
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </div>
</article>
