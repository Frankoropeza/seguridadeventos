---
import SectionHeader from '@/components/SectionHeader.astro';

const testimonios = [
  {
    nombre: "Rodrigo Valenzuela",
    cargo: "Director de Operaciones",
    empresa: "Turbo Racing México",
    empresaUrl: "",
    texto: "Nuestros eventos mezclan público general, expositores y equipos técnicos de alto valor en espacios abiertos — un escenario complejo para cualquier empresa de seguridad. SEPRIEV entendió la dinámica desde el diagnóstico previo: diferenciaron zonas de competencia, acceso de pilotos y área de espectadores sin interrumpir la experiencia. El operativo en el Corporate Drone Challenge en Parque La Mexicana fue impecable.",
    evento: "Corporate Drone Challenge · CDMX",
    rating: 5,
  },
  {
    nombre: "Ing. Marco Herrera",
    cargo: "Director Comercial",
    empresa: "SeguridadPrivadaMX",
    empresaUrl: "https://seguridadprivadamx.com",
    texto: "Nosotros cubrimos la seguridad permanente de condominios, pero cuando nuestros clientes organizan asambleas masivas, inauguraciones o eventos sociales de gran aforo, referimos a SEPRIEV. La coordinación entre ambos equipos ha sido impecable: ellos entienden la dinámica de un recinto residencial, respetan los protocolos que ya tenemos instalados y entregan un reporte de cierre al terminar. Es el complemento perfecto para lo que ofrecemos.",
    evento: "Referidos B2B · Eventos en condominios CDMX",
    rating: 5,
  },
  {
    nombre: "Eduardo Castillo",
    cargo: "Coordinador de Proyectos de Eventos",
    empresa: "PantallaLED",
    empresaUrl: "https://pantalla-led.com",
    texto: "Cuando desplegamos pantallas LED en eventos masivos, el equipo sobre el escenario puede valer varios millones de pesos. Necesitamos que el acceso a backstage esté controlado desde el primer módulo instalado hasta que el último camión sale del recinto. SEPRIEV ha cubierto montaje, función y desmontaje en más de diez de nuestros proyectos — conciertos, convenciones y activaciones de marca — sin un solo incidente con el equipo.",
    evento: "Renta de pantallas LED · Eventos en CDMX y GDL",
    rating: 5,
  },
  {
    nombre: "Lic. Patricia Fuentes",
    cargo: "Directora de Operaciones",
    empresa: "GUPRI Seguridad Privada",
    empresaUrl: "",
    texto: "Con más de 30 años en seguridad residencial, sabemos perfectamente cuándo un operativo supera el alcance del servicio de condominio. Para nuestro evento anual de clientes con más de 400 asistentes, contratamos a SEPRIEV. La coordinación entre ambos equipos fue natural: ellos entienden los protocolos de seguridad privada, respetan la jerarquía del operativo y no improvisan. Es la empresa que recomendamos cuando nuestros clientes organizan eventos de gran aforo.",
    evento: "Gala anual de clientes · 400 asistentes",
    rating: 5,
  },
  {
    nombre: "Carlos Vega",
    cargo: "Director de Producción",
    empresa: "REDEIL",
    empresaUrl: "",
    texto: "En producción de eventos la coordinación entre proveedores lo es todo. Cuando montamos iluminación y audio para conciertos o eventos corporativos de gran formato, necesitamos que el equipo de seguridad entienda los tiempos de producción y respete el acceso técnico sin generar fricciones. SEPRIEV lleva varios proyectos con nosotros y siempre llegan antes que nadie — conocen la diferencia entre un técnico de escenario y un invitado sin credencial.",
    evento: "Producción AV · Eventos CDMX y Edomex",
    rating: 5,
  },
  {
    nombre: "Adriana Flores",
    cargo: "Coordinadora de Eventos",
    empresa: "BRINCOLINS",
    empresaUrl: "https://brincolins.com",
    texto: "En kermeses escolares y family days corporativos con 300 o más asistentes, tener inflables activos y niños corriendo por todos lados exige un operativo de seguridad que entienda la dinámica. SEPRIEV gestiona el control de acceso alrededor de los equipos, mantiene zonas despejadas y reacciona rápido si algo se sale del orden — sin alarmar a los papás ni interrumpir la fiesta. Los recomendamos a todos nuestros clientes de eventos grandes.",
    evento: "Kermeses y family days · CDMX y Edomex",
    rating: 5,
  },
];
---

<section class="py-20 bg-primary/30">
  <div class="w-full px-[5%] xl:px-[7%]">
    <SectionHeader
      eyebrow="Clientes satisfechos"
      titulo="Lo que dicen nuestros clientes"
      lead="Más de 500 eventos protegidos y la confianza de empresas que vuelven a contratarnos."
      parrafos={[
        "La mejor referencia de una empresa de seguridad son sus clientes recurrentes. Productoras, organizadores y empresas de eventos confían en SEPRIEV porque entendemos la dinámica de cada operativo y entregamos resultados medibles, sin incidentes.",
        "Desde activaciones de marca y convenciones corporativas hasta conciertos masivos, nuestros clientes destacan la coordinación, la discreción del personal y el cumplimiento estricto de protocolos. Cada testimonio corresponde a un evento real ejecutado por nuestro equipo.",
      ]}
    />


    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonios.map(t => (
        <blockquote class="flex flex-col bg-dark border border-primary-light rounded-xl p-6">
          <!-- Stars -->
          <div class="flex gap-1 mb-4" aria-label={`${t.rating} de 5 estrellas`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true">
                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
            ))}
          </div>

          <p class="text-accent text-sm leading-relaxed flex-1 mb-5 italic">"{t.texto}"</p>

          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="text-light font-bold text-sm">{t.nombre}</div>
              <div class="text-accent text-xs">{t.cargo} · {t.empresa}</div>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-primary-light flex items-center justify-between gap-3">
            <span class="text-xs text-secondary/70 font-semibold">{t.evento}</span>
            {t.empresaUrl && (
              <a
                href={t.empresaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[10px] font-bold uppercase tracking-widest text-white/25 hover:text-secondary/60 transition-colors"
              >
                {t.empresaUrl.replace('https://', '')} ↗
              </a>
            )}
          </div>
        </blockquote>
      ))}
    </div>
  </div>
</section>
