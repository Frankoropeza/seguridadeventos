---
const testimonios = [
  {
    nombre: "Carlos Mendoza",
    cargo: "Director de Operaciones",
    empresa: "Grupo Empresarial del Norte",
    texto: "Contratamos a SeguridadEventos para nuestra convención anual con 1,200 asistentes. El despliegue fue impecable, el personal muy profesional y la coordinación con el venue excelente. Sin incidentes en los 3 días del evento.",
    evento: "Convención corporativa 1,200 asistentes",
    rating: 5,
  },
  {
    nombre: "Ana García",
    cargo: "Productora de Eventos",
    empresa: "AG Entertainment",
    texto: "Trabajamos con ellos en 8 conciertos consecutivos. Siempre puntuales, con el personal correcto y respondiendo rápido a cualquier situación. Los contratamos en cada producción que hacemos.",
    evento: "Gira de 8 conciertos · Aforo 3,000-8,000",
    rating: 5,
  },
  {
    nombre: "Roberto Sánchez",
    cargo: "Gerente de Logística",
    empresa: "Expo Manufactura",
    texto: "Para nuestra feria industrial de 4 días necesitábamos seguridad especializada para expositores internacionales. El servicio superó nuestras expectativas. Muy recomendables.",
    evento: "Feria industrial · 250 expositores",
    rating: 5,
  },
  {
    nombre: "Sofía Torres",
    cargo: "Wedding Planner",
    empresa: "ST Eventos",
    texto: "Mis clientes siempre quedan satisfechos con el servicio de seguridad discreta que ofrece SeguridadEventos. Se integran al ambiente sin interrumpir, pero están siempre atentos.",
    evento: "Bodas y eventos sociales premium",
    rating: 5,
  },
  {
    nombre: "Miguel Ángel Reyes",
    cargo: "Director de Venue",
    empresa: "Centro de Convenciones Metropolitano",
    texto: "Son nuestros proveedores de seguridad para todos los eventos que recibimos. Su profesionalismo y capacidad de adaptarse a eventos de distinta escala los hace insustituibles.",
    evento: "Proveedor oficial del venue",
    rating: 5,
  },
  {
    nombre: "Laura Vega",
    cargo: "Coordinadora de Eventos",
    empresa: "Gobierno del Estado · Protocolo",
    texto: "Para eventos gubernamentales los protocolos son muy estrictos. SeguridadEventos cumplió todos los requerimientos de seguridad institucional con absoluta discreción y eficiencia.",
    evento: "Eventos gubernamentales · Protocolo oficial",
    rating: 5,
  },
];
---

<section class="py-20 bg-primary/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <span class="text-secondary text-xs font-bold uppercase tracking-widest">Clientes satisfechos</span>
      <h2 class="text-3xl sm:text-4xl font-black text-light mt-2">Lo que dicen nuestros clientes</h2>
      <p class="text-accent mt-3 max-w-xl mx-auto">Más de 500 eventos protegidos. La confianza de nuestros clientes es nuestro mayor activo.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonios.map(t => (
        <blockquote class="flex flex-col bg-dark border border-primary-light rounded-xl p-6 hover:border-secondary/30 transition-colors">
          <!-- Stars -->
          <div class="flex gap-1 mb-4" aria-label={`${t.rating} de 5 estrellas`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" aria-hidden="true">
                <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
              </svg>
            ))}
          </div>

          <p class="text-accent text-sm leading-relaxed flex-1 mb-5 italic">"{t.texto}"</p>

          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="text-light font-bold text-sm">{t.nombre}</div>
              <div class="text-accent text-xs">{t.cargo} · {t.empresa}</div>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-primary-light">
            <span class="text-xs text-secondary/70 font-semibold">{t.evento}</span>
          </div>
        </blockquote>
      ))}
    </div>
  </div>
</section>
