---
const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-dark/95 backdrop-blur-sm border-b border-primary/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-2xl sm:text-3xl">🛡️</span>
        <div class="flex flex-col leading-tight">
          <span class="text-light font-extrabold text-sm sm:text-lg tracking-tight group-hover:text-secondary transition-colors">SEGURIDAD EVENTOS</span>
          <span class="text-accent text-[10px] sm:text-xs tracking-widest uppercase">Protección profesional</span>
        </div>
      </a>

      <!-- Nav Desktop -->
      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-accent hover:text-light font-medium text-sm uppercase tracking-wider transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA + Teléfono -->
      <div class="flex items-center gap-4">
        <a
          href="tel:+525512345678"
          class="hidden sm:flex items-center gap-2 text-accent hover:text-light transition-colors text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          55 1234 5678
        </a>
        <a
          href="#contacto"
          class="bg-secondary hover:bg-red-700 text-light px-4 py-2 rounded text-sm font-semibold uppercase tracking-wider transition-colors"
        >
          Cotizar
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-accent hover:text-light p-2"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Nav -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4 border-t border-primary/30 pt-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block py-2 text-accent hover:text-light font-medium text-sm uppercase tracking-wider transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a href="tel:+525512345678" class="block py-2 text-accent hover:text-light text-sm">
        📞 55 1234 5678
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
