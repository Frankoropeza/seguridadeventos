---
import { getCollection } from 'astro:content';
import { SERVICIOS_NAV, ZONAS_NAV, WHATSAPP_NUMBER } from '@/lib/config';

const allPosts = await getCollection('blog', ({ data }: { data: { draft: boolean } }) => !data.draft);

// Recent posts (last 5, excluding current if provided)
interface Props {
  currentSlug?: string;
}
const { currentSlug } = Astro.props;

const recentPosts = allPosts
  .filter((p: any) => p.slug !== currentSlug)
  .slice(0, 5);

// Categories with counts
const categoryCounts: Record<string, number> = {};
allPosts.forEach((p: any) => {
  const cat = p.data.categoria || 'Blog';
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);

const totalPosts = allPosts.length;
---

<aside class="flex flex-col gap-6">

  <!-- Buscador rápido / CTA superior -->
  <div class="bg-gradient-to-br from-secondary/20 to-secondary/5 border border-secondary/30 rounded-xl p-5">
    <div class="flex items-center gap-2 mb-3">
      <div class="w-8 h-8 bg-secondary rounded-lg flex items-center justify-center flex-shrink-0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
      </div>
      <h3 class="text-light font-bold text-sm">¿Necesitas seguridad?</h3>
    </div>
    <p class="text-accent text-xs leading-relaxed mb-4">
      Cotiza tu evento y recibe propuesta personalizada en menos de 24 hrs.
    </p>
    <a
      href="/cotizar"
      class="w-full block bg-secondary hover:bg-red-700 text-white text-center px-4 py-2.5 rounded-lg text-sm font-bold uppercase tracking-wide transition-colors"
    >
      Cotizar ahora
    </a>
    <a
      href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C+me+interes%C3%B3+un+art%C3%ADculo+del+blog+y+necesito+informaci%C3%B3n`}
      target="_blank"
      rel="noopener"
      class="w-full mt-2 flex items-center justify-center gap-2 border border-green-600/40 hover:border-green-500 hover:bg-green-900/20 text-green-400 px-4 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      WhatsApp directo
    </a>
  </div>

  <!-- Categorías -->
  <div class="bg-primary border border-primary-light rounded-xl p-5">
    <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4 flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-secondary" aria-hidden="true">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
      </svg>
      Categorías
    </h3>
    <ul class="flex flex-col gap-1">
      <li>
        <a
          href="/blog"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-sm text-accent hover:text-light hover:bg-white/5 transition-colors group"
        >
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary/50 group-hover:bg-secondary transition-colors"></span>
            Todos los artículos
          </span>
          <span class="bg-white/5 text-accent text-xs px-2 py-0.5 rounded-full">{totalPosts}</span>
        </a>
      </li>
      {categories.map(([cat, count]) => (
        <li>
          <a
            href={`/blog?cat=${encodeURIComponent(cat)}`}
            class="flex items-center justify-between px-3 py-2 rounded-lg text-sm text-accent hover:text-light hover:bg-white/5 transition-colors group"
            data-cat-link={cat}
          >
            <span class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-secondary/50 group-hover:bg-secondary transition-colors"></span>
              {cat}
            </span>
            <span class="bg-white/5 text-accent text-xs px-2 py-0.5 rounded-full">{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Artículos recientes -->
  <div class="bg-primary border border-primary-light rounded-xl p-5">
    <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4 flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-secondary" aria-hidden="true">
        <path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
      </svg>
      Artículos Recientes
    </h3>
    <ul class="flex flex-col gap-4">
      {recentPosts.map((post: any) => (
        <li>
          <a href={`/blog/${post.slug}`} class="flex gap-3 items-start">
            <div class="w-14 h-14 rounded-lg bg-primary-light flex items-center justify-center flex-shrink-0">
              {post.data.imagen ? (
                <picture>
                  <source type="image/avif" srcset={`${post.data.imagen}-640.avif`} />
                  <img
                    src={`${post.data.imagen}-640.jpg`}
                    alt={post.data.title}
                    class="w-full h-full object-cover rounded-lg"
                    loading="lazy"
                    decoding="async"
                    width="112"
                    height="112"
                  />
                </picture>
              ) : (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="1.5" opacity="0.5" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-light text-xs font-semibold leading-snug line-clamp-2">
                {post.data.title}
              </p>
              <div class="flex items-center gap-2 mt-1.5">
                <span class="text-accent text-xs flex items-center gap-1">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
                  </svg>
                  {post.data.readTime || 5} min
                </span>
                <span class="text-secondary/70 text-xs">{post.data.categoria || 'Blog'}</span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/blog"
      class="mt-4 flex items-center gap-1.5 text-secondary text-xs font-semibold hover:text-red-400 transition-colors"
    >
      Ver todos los artículos
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>

  <!-- Servicios populares -->
  <div class="bg-primary border border-primary-light rounded-xl p-5">
    <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4 flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-secondary" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      Nuestros Servicios
    </h3>
    <ul class="flex flex-col gap-1">
      {SERVICIOS_NAV.slice(0, 7).map(s => (
        <li>
          <a
            href={`/servicios/${s.slug}`}
            class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-accent hover:text-light hover:bg-white/5 transition-colors group"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-secondary/40 group-hover:bg-secondary transition-colors flex-shrink-0"></span>
            {s.nombre}
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/servicios"
      class="mt-3 flex items-center gap-1.5 text-secondary text-xs font-semibold hover:text-red-400 transition-colors px-3"
    >
      Ver todos los servicios →
    </a>
  </div>

  <!-- Zonas de cobertura -->
  <div class="bg-primary border border-primary-light rounded-xl p-5">
    <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-3 flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-secondary" aria-hidden="true">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
      </svg>
      Cobertura Nacional
    </h3>
    <div class="flex flex-wrap gap-2">
      {ZONAS_NAV.map(z => (
        <a
          href={`/zonas/${z.slug}`}
          class="bg-white/5 hover:bg-secondary/20 hover:border-secondary/40 border border-white/10 text-accent hover:text-light text-xs px-3 py-1.5 rounded-full transition-all"
        >
          {z.nombre}
        </a>
      ))}
    </div>
  </div>

</aside>
