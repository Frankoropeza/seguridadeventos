---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark border-t border-primary/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Marca -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="text-2xl">🛡️</span>
          <span class="text-light font-extrabold text-lg">SEGURIDAD EVENTOS</span>
        </div>
        <p class="text-accent text-sm leading-relaxed">
          Empresa líder en seguridad privada y control de acceso para eventos en México.
          Más de 15 años protegiendo lo que más importa.
        </p>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="text-light font-semibold text-sm uppercase tracking-wider mb-4">Servicios</h3>
        <ul class="space-y-2 text-accent text-sm">
          <li>Control de Acceso</li>
          <li>Vigilancia Perimetral</li>
          <li>Guardias de Seguridad</li>
          <li>Protección VIP</li>
          <li>Protección Ejecutiva</li>
          <li>Cámaras CCTV</li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-light font-semibold text-sm uppercase tracking-wider mb-4">Contacto</h3>
        <ul class="space-y-2 text-accent text-sm">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            55 1234 5678
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            contacto@seguridadeventos.com.mx
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Ciudad de México, México
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-primary/30 text-center text-accent text-xs">
      <p>&copy; {currentYear} Seguridad Eventos. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
