---
import { VACANTES } from '@/lib/vacantes';
import { PHONE_PRIMARY, PHONE_DISPLAY, WHATSAPP_URL } from '@/lib/config';

const currentYear = new Date().getFullYear();

const VACANTE_CORTO: Record<string, string> = {
  'guardia-de-seguridad-para-eventos': 'Guardia de Seguridad',
  'supervisor-operativo': 'Supervisor Operativo',
  'escolta-proteccion-vip': 'Escolta / Protección VIP',
  'monitorista-cctv': 'Monitorista CCTV',
  'coordinador-de-eventos-logistica': 'Coordinador de Eventos',
  'personal-control-acceso-acreditacion': 'Control de Acceso',
};
---

<footer class="bg-dark border-t border-primary/30">
  <div class="w-full px-[5%] xl:px-[7%] py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Marca -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <svg class="w-7 h-7 text-secondary" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.67-3.13 8.42-7 9.88-3.87-1.46-7-5.21-7-9.88V6.3l7-3.12z"/>
          </svg>
          <span class="text-light font-extrabold text-lg">SEGURIDAD EVENTOS</span>
        </div>
        <p class="text-accent text-sm leading-relaxed mb-4">
          Empresa lider en seguridad privada y control de acceso para eventos en Mexico.
          Mas de 15 anos protegiendo lo que mas importa.
        </p>
        <a
          href={WHATSAPP_URL()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white text-xs font-semibold px-3 py-2 rounded transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 00.611.611l4.458-1.495A11.952 11.952 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-2.316 0-4.457-.764-6.182-2.054l-.432-.334-3.097 1.038 1.038-3.097-.334-.432A9.955 9.955 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          WhatsApp
        </a>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="text-light font-semibold text-sm uppercase tracking-wider mb-4">Servicios</h3>
        <ul class="space-y-2 text-accent text-sm">
          <li><a href="/servicios/seguridad-conciertos-festivales" class="hover:text-light transition-colors">Conciertos y Festivales</a></li>
          <li><a href="/servicios/seguridad-eventos-corporativos" class="hover:text-light transition-colors">Eventos Corporativos</a></li>
          <li><a href="/servicios/control-acceso-eventos" class="hover:text-light transition-colors">Control de Acceso</a></li>
          <li><a href="/servicios/seguridad-vip" class="hover:text-light transition-colors">Seguridad VIP</a></li>
          <li><a href="/servicios/proteccion-ejecutiva" class="hover:text-light transition-colors">Proteccion Ejecutiva</a></li>
          <li><a href="/servicios" class="text-secondary hover:text-red-400 transition-colors font-medium">Ver todos →</a></li>
        </ul>
      </div>

      <!-- Zonas -->
      <div>
        <h3 class="text-light font-semibold text-sm uppercase tracking-wider mb-4">Cobertura</h3>
        <ul class="space-y-2 text-accent text-sm">
          <li><a href="/zonas/cdmx" class="hover:text-light transition-colors">Ciudad de Mexico</a></li>
          <li><a href="/zonas/guadalajara" class="hover:text-light transition-colors">Guadalajara</a></li>
          <li><a href="/zonas/monterrey" class="hover:text-light transition-colors">Monterrey</a></li>
          <li><a href="/zonas/puebla" class="hover:text-light transition-colors">Puebla</a></li>
          <li><a href="/zonas/cancun" class="hover:text-light transition-colors">Cancun</a></li>
        </ul>
      </div>

      <!-- Bolsa de Trabajo -->
      <div>
        <h3 class="text-light font-semibold text-sm uppercase tracking-wider mb-4">Bolsa de Trabajo</h3>
        <ul class="space-y-2 text-accent text-sm">
          {VACANTES.map((v) => (
            <li><a href={`/bolsa-de-trabajo/${v.slug}`} class="hover:text-light transition-colors">{VACANTE_CORTO[v.slug] ?? v.puesto}</a></li>
          ))}
          <li><a href="/bolsa-de-trabajo" class="text-secondary hover:text-red-400 transition-colors font-medium">Ver todas →</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-light font-semibold text-sm uppercase tracking-wider mb-4">Contacto</h3>
        <ul class="space-y-2 text-accent text-sm">
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href={`tel:${PHONE_PRIMARY}`} class="hover:text-light transition-colors">+52 {PHONE_DISPLAY}</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:contacto@seguridadeventos.com" class="hover:text-light transition-colors">contacto@seguridadeventos.com</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Ciudad de Mexico, Mexico
          </li>
        </ul>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/nosotros" class="text-accent hover:text-light text-xs transition-colors">Nosotros</a>
          <span class="text-accent/30">|</span>
          <a href="/certificaciones" class="text-accent hover:text-light text-xs transition-colors">Certificaciones</a>
          <span class="text-accent/30">|</span>
          <a href="/cotizar" class="text-accent hover:text-light text-xs transition-colors">Cotizar</a>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-primary/30 text-center text-accent text-xs">
      <p>&copy; {currentYear} SEPRIEV. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
