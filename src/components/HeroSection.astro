---
export interface Props {
  titulo?: string;
  subtitulo?: string;
}

const {
  titulo = "Seguridad Privada Profesional para Eventos en México",
  subtitulo = "Protección integral, discreta y certificada para cualquier tipo y escala de evento.",
} = Astro.props;
---

<section class="relative min-h-[88vh] flex items-center overflow-hidden bg-dark">

  <!-- Imagen de fondo con overlay -->
  <div class="absolute inset-0" aria-hidden="true">
    <picture>
      <source type="image/avif" srcset="/img/eventos/seguridad-conciertos-festivales-1200.avif" />
      <img src="/img/eventos/seguridad-conciertos-festivales-1200.jpg" alt="" class="w-full h-full object-cover opacity-25" loading="eager" fetchpriority="high" width="1200" height="675" />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-r from-dark via-dark/95 to-dark/70"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-dark/60"></div>
  </div>

  <!-- Línea vertical decorativa izquierda -->
  <div class="absolute left-0 top-0 h-full w-px bg-gradient-to-b from-transparent via-secondary/40 to-transparent" aria-hidden="true"></div>

  <!-- Línea vertical decorativa derecha -->
  <div class="absolute right-0 top-0 h-full w-px bg-gradient-to-b from-transparent via-white/5 to-transparent" aria-hidden="true"></div>

  <!-- Gradiente sutil de fondo -->
  <div class="absolute inset-0 bg-gradient-to-br from-secondary/5 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

  <!-- Línea horizontal superior -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-secondary/30 to-transparent" aria-hidden="true"></div>

  <div class="relative z-10 w-full px-[5%] xl:px-[7%] py-24 lg:py-32">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- Columna izquierda -->
      <div>

        <!-- Eyebrow -->
        <p class="text-secondary text-xs font-bold uppercase tracking-[0.3em] mb-4">
          SEPRIEV — Seguridad Privada para Eventos
        </p>

        <!-- Título principal -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-black text-light leading-[1.1] mb-4 tracking-tight">
          {titulo}
        </h1>

        <!-- Línea divisora -->
        <div class="w-16 h-0.5 bg-secondary mb-5"></div>

        <!-- Subtítulo -->
        <p class="text-accent text-lg leading-relaxed max-w-lg">
          {subtitulo}
        </p>

      </div>

      <!-- Columna derecha: texto institucional -->
      <div class="border-l border-white/10 pl-10 lg:pl-16 flex flex-col gap-4">

        <p class="text-accent text-base leading-relaxed">
          SEPRIEV es una empresa mexicana con <strong class="text-light font-semibold">más de 30 años de trayectoria</strong> en la seguridad privada para eventos. Fundada por profesionales egresados de las fuerzas de seguridad del Estado, hemos desarrollado metodologías propias que nos permiten proteger cualquier tipo de evento, desde reuniones corporativas de alto nivel hasta festivales masivos con decenas de miles de asistentes, con la misma precisión y discreción que nos caracteriza.
        </p>

        <p class="text-accent text-base leading-relaxed">
          Contamos con <strong class="text-light font-semibold">licencia DGSSP federal vigente</strong> y personal certificado ante la Secretaría del Trabajo, lo que nos acredita como una de las empresas de seguridad privada para eventos con mayor solidez institucional en México. Operamos en todo el territorio nacional con presencia permanente en Ciudad de México, Guadalajara, Monterrey, Puebla y Cancún, coordinando cada operación con las autoridades locales y los protocolos de Protección Civil.
        </p>

      </div>
    </div>
  </div>

  <!-- Línea horizontal inferior -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent" aria-hidden="true"></div>

</section>
