---

---

<section class="relative min-h-screen flex items-center justify-center bg-dark overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, #94A3B8 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <!-- Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-b from-dark via-dark/90 to-primary/20"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-20">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 bg-primary/50 border border-accent/20 rounded-full px-4 py-1.5 mb-8">
      <span class="w-2 h-2 bg-secondary rounded-full animate-pulse"></span>
      <span class="text-accent text-xs sm:text-sm font-medium uppercase tracking-wider">Seguridad privada certificada</span>
    </div>

    <!-- Headline -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-light leading-tight mb-6">
      Protegemos tu evento,
      <br />
      <span class="text-secondary">tú disfruta el momento</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-accent text-lg sm:text-xl max-w-2xl mx-auto mb-10 leading-relaxed">
      Somos la empresa líder en seguridad privada y control de acceso para eventos en México.
      Personal certificado, tecnología avanzada y más de 15 años de experiencia.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="#contacto"
        class="w-full sm:w-auto bg-secondary hover:bg-red-700 text-light px-8 py-4 rounded-lg text-lg font-bold uppercase tracking-wider transition-all hover:scale-105 shadow-lg shadow-secondary/25"
      >
        Solicitar Cotización
      </a>
      <a
        href="#servicios"
        class="w-full sm:w-auto border-2 border-accent/30 hover:border-accent text-light px-8 py-4 rounded-lg text-lg font-semibold uppercase tracking-wider transition-all hover:bg-primary/30"
      >
        Nuestros Servicios
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-4 sm:gap-8 max-w-2xl mx-auto">
      <div class="text-center">
        <div class="text-3xl sm:text-4xl md:text-5xl font-black text-light">500+</div>
        <div class="text-accent text-xs sm:text-sm mt-1 uppercase tracking-wider">Eventos protegidos</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl md:text-5xl font-black text-light">1,000+</div>
        <div class="text-accent text-xs sm:text-sm mt-1 uppercase tracking-wider">Guardias activos</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl md:text-5xl font-black text-light">15+</div>
        <div class="text-accent text-xs sm:text-sm mt-1 uppercase tracking-wider">Años experiencia</div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-accent/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
