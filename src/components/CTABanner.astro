---
import { WHATSAPP_NUMBER, PHONE_DISPLAY } from '@/lib/config';

export interface Props {
  titulo?: string;
  subtitulo?: string;
  ctaLabel?: string;
  ctaHref?: string;
  variant?: 'red' | 'dark';
}

const {
  titulo = "¿Listo para proteger tu evento?",
  subtitulo = "Cotización personalizada en menos de 24 horas. Sin compromiso.",
  ctaLabel = "Solicitar Cotización",
  ctaHref = "/cotizar",
  variant = 'red',
} = Astro.props;
---

<section class={`py-16 ${variant === 'red' ? 'bg-secondary' : 'bg-primary'} relative overflow-hidden`}>
  <!-- Decoración -->
  <div class="absolute inset-0 opacity-5 pointer-events-none" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="cta-pattern" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M30 5L5 55h50L30 5z" fill="none" stroke="white" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cta-pattern)"/>
    </svg>
  </div>
  <!-- Glow effect -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent" aria-hidden="true"></div>

  <div class="relative w-[90%] mx-auto text-center">
    <h2 class="text-3xl sm:text-4xl font-black text-white mb-4">{titulo}</h2>
    <p class={`text-lg mb-10 ${variant === 'red' ? 'text-red-100' : 'text-accent'}`}>{subtitulo}</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={ctaHref}
        class={`w-full sm:w-auto flex items-center justify-center gap-2 px-8 py-4 rounded-lg text-base font-bold uppercase tracking-wide transition-all duration-200 hover:-translate-y-0.5 ${
          variant === 'red'
            ? 'bg-white text-secondary hover:bg-gray-100 shadow-lg shadow-black/20'
            : 'bg-secondary hover:bg-red-700 text-white shadow-lg shadow-secondary/30'
        }`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        {ctaLabel}
      </a>
      <a
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C+quiero+cotizar+seguridad+para+mi+evento`}
        target="_blank"
        rel="noopener"
        class="w-full sm:w-auto flex items-center justify-center gap-2 border-2 border-white/30 hover:border-white text-white px-8 py-4 rounded-lg text-base font-semibold transition-all duration-200 hover:-translate-y-0.5"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp directo
      </a>
    </div>

    <p class="mt-6 text-xs text-white/60">Respuesta en menos de 24 horas · Sin compromiso · Presupuesto gratuito</p>
  </div>
</section>
