---
const items = [
  {
    label: "Nuestros Servicios",
    desc: "Seguridad para conciertos, corporativos, VIP y eventos masivos",
    href: "#servicios",
  },
  {
    label: "Cobertura Nacional",
    desc: "CDMX, Guadalajara, Monterrey, Puebla y Cancún",
    href: "/zonas/",
  },
  {
    label: "30 Años de Experiencia",
    desc: "Quiénes somos y nuestras certificaciones",
    href: "/nosotros/",
  },
  {
    label: "Solicitar Cotización",
    desc: "Propuesta personalizada en menos de 24 horas",
    href: "/cotizar/",
  },
];
---

<nav class="w-full bg-primary border-y border-white/8" aria-label="Secciones principales">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-white/8">
    {items.map((item) => (
      <a
        href={item.href}
        class="flex items-center justify-between gap-4 px-8 py-6 hover:bg-white/4"
      >
        <div>
          <p class="text-light text-sm font-bold tracking-wide">
            {item.label}
          </p>
          <p class="text-accent text-xs mt-1 leading-relaxed">
            {item.desc}
          </p>
        </div>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="text-accent flex-shrink-0"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    ))}
  </div>
</nav>
