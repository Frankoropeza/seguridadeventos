---
export interface Feature {
  title: string;
  text: string;
}

export interface Props {
  title: string;
  intro: string;
  features?: Feature[];
  href: string;
  hero: string;
  small1: string;
  small2: string;
  badge?: string;
  featured?: boolean;
  eyebrow?: string;
}

const {
  title,
  intro,
  features = [],
  href,
  hero,
  small1,
  small2,
  badge,
  featured = false,
  eyebrow = 'Servicio destacado',
} = Astro.props;
---

<div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 mt-20 pt-16 border-t ${featured ? 'border-secondary/30' : 'border-white/8'}`}>

  <!-- Columna izquierda: servicio destacado -->
  <div class="flex flex-col h-full">
    <div class="flex items-center gap-3 mb-2">
      <span class="text-secondary text-xs font-bold uppercase tracking-widest">{eyebrow}</span>
      {badge && (
        <span class="bg-secondary text-white text-[10px] font-black uppercase tracking-widest px-2 py-0.5">{badge}</span>
      )}
    </div>
    <div class="w-8 h-0.5 bg-secondary mb-3"></div>
    <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-4">
      {title}
    </h2>

    <p class="text-light/80 text-base leading-relaxed mb-5">
      {intro}
    </p>

    <ul class="flex flex-col gap-5 mb-6">
      {features.map((f) => (
        <li class="flex flex-col gap-1.5">
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
            <span class="text-light text-base font-semibold">{f.title}</span>
          </div>
          <p class="text-light/70 text-sm leading-relaxed pl-4">
            {f.text}
          </p>
        </li>
      ))}
    </ul>

    <div class="flex flex-col sm:flex-row gap-4 mt-auto">
      <a href={href} class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
        Ver servicio
      </a>
      <a href="/cotizar/" class="inline-flex items-center justify-center gap-2 border border-white/20 hover:border-white/40 text-accent hover:text-light px-7 py-3 text-sm font-semibold transition-colors">
        Solicitar Cotización
      </a>
    </div>
  </div>

  <!-- Columna derecha: galería 1 grande + 2 pequeñas -->
  <div class="flex flex-col gap-4">

    <!-- Imagen grande -->
    <div class="relative w-full aspect-[16/9] overflow-hidden bg-primary">
      <picture>
        <source type="image/avif" srcset={`${hero}-640.avif 640w, ${hero}-1200.avif 1200w`} sizes="(max-width: 1024px) 100vw, 600px" />
        <source type="image/jpeg" srcset={`${hero}-640.jpg 640w, ${hero}-1200.jpg 1200w`} sizes="(max-width: 1024px) 100vw, 600px" />
        <img src={`${hero}-1200.jpg`} alt={`${title} — seguridad para eventos SEPRIEV`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="1200" height="675" />
      </picture>
    </div>

    <!-- Dos imágenes pequeñas -->
    <div class="grid grid-cols-2 gap-4">
      <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
        <picture>
          <source type="image/avif" srcset={`${small1}-640.avif`} />
          <img src={`${small1}-640.jpg`} alt={`${title} — SEPRIEV`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
        </picture>
      </div>
      <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
        <picture>
          <source type="image/avif" srcset={`${small2}-640.avif`} />
          <img src={`${small2}-640.jpg`} alt={`${title} — SEPRIEV`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
        </picture>
      </div>
    </div>

  </div>
</div>
