---
import SectionHeader from '@/components/SectionHeader.astro';
// Sección de confianza: certificaciones + números + logos de clientes
---

<!-- Certificaciones -->
<section class="py-16 bg-primary/40 border-y border-primary">
  <div class="w-full px-[5%] xl:px-[7%]">
    <SectionHeader
      eyebrow="Respaldo oficial"
      titulo="Certificaciones y Licencias"
      lead="Licencia federal vigente y personal certificado: el respaldo legal que distingue a una empresa de seguridad seria."
      parrafos={[
        "SEPRIEV opera con licencia DGSSP federal y todo su personal está certificado ante la STPS. Estos registros no son un trámite opcional: son el requisito legal mínimo para prestar servicios de seguridad privada en México, y operar sin ellos expone al organizador a sanciones.",
        "Cada credencial es verificable y se mantiene vigente mediante capacitación y auditorías continuas. Trabajar con una empresa certificada garantiza protocolos homologados con Protección Civil y autoridades locales, y protege legalmente a quien contrata el servicio.",
      ]}
    />

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
      {[
        { siglas: "DGSSP", nombre: "Dirección General de Seguridad Privada", color: "secondary", desc: "Licencia federal vigente" },
        { siglas: "STPS", nombre: "Secretaría del Trabajo", color: "gold", desc: "Personal certificado" },
        { siglas: "ISO 9001", nombre: "Gestión de Calidad", color: "green", desc: "Procesos certificados" },
        { siglas: "DGSP", nombre: "Seguridad Pública CDMX", color: "blue", desc: "Registro municipal" },
      ].map(cert => (
        <div class="flex flex-col items-center text-center p-6 bg-dark rounded-xl border border-primary">
          <div class={`w-16 h-16 rounded-full flex items-center justify-center mb-3 ${
            cert.color === 'secondary' ? 'bg-secondary/20 border-2 border-secondary/40' :
            cert.color === 'gold' ? 'bg-gold/20 border-2 border-gold/40' :
            cert.color === 'green' ? 'bg-green-900/30 border-2 border-green-700/40' :
            'bg-blue-900/30 border-2 border-blue-700/40'
          }`}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class={
              cert.color === 'secondary' ? 'text-secondary' :
              cert.color === 'gold' ? 'text-gold' :
              cert.color === 'green' ? 'text-green-400' : 'text-blue-400'
            } aria-hidden="true">
              <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div class="text-light font-black text-base">{cert.siglas}</div>
          <div class="text-accent text-xs mt-1">{cert.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>
