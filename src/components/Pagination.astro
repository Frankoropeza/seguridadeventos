---
export interface Props {
  currentPage: number;
  totalPages: number;
  /** Base del listado. Página 1 = `${basePath}/`, resto = `${basePath}/page/N`. */
  basePath?: string;
}
const { currentPage, totalPages, basePath = '/blog' } = Astro.props;

const href = (n: number) => (n <= 1 ? `${basePath}/` : `${basePath}/page/${n}/`);

// Lista de páginas con elipsis: 1 … (cur-1) cur (cur+1) … last
const win = 1;
const items: Array<number | 'gap'> = [];
for (let n = 1; n <= totalPages; n++) {
  const near = n >= currentPage - win && n <= currentPage + win;
  if (n === 1 || n === totalPages || near) {
    items.push(n);
  } else if (items[items.length - 1] !== 'gap') {
    items.push('gap');
  }
}

const prev = currentPage > 1 ? href(currentPage - 1) : null;
const next = currentPage < totalPages ? href(currentPage + 1) : null;

const numBase =
  'min-w-[42px] h-[42px] px-3 inline-flex items-center justify-center rounded-lg text-sm font-bold border transition-colors duration-200';
const numIdle = 'bg-white/5 text-accent border-white/10 hover:border-secondary/40 hover:text-light';
const numActive = 'bg-secondary text-white border-secondary shadow-md shadow-secondary/20';
const edgeBase =
  'h-[42px] px-4 inline-flex items-center gap-2 rounded-lg text-sm font-bold border transition-colors duration-200';
const edgeIdle = 'bg-white/5 text-light border-white/10 hover:border-secondary/40 hover:text-secondary';
const edgeOff = 'bg-white/5 text-accent/40 border-white/5 cursor-not-allowed pointer-events-none';
---
{totalPages > 1 && (
  <nav class="flex flex-wrap items-center justify-center gap-2 mt-12" aria-label="Paginación de artículos">
    {prev ? (
      <a href={prev} class={`${edgeBase} ${edgeIdle}`} rel="prev" aria-label="Página anterior">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span class="hidden sm:inline">Anterior</span>
      </a>
    ) : (
      <span class={`${edgeBase} ${edgeOff}`} aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span class="hidden sm:inline">Anterior</span>
      </span>
    )}

    {items.map((it) =>
      it === 'gap' ? (
        <span class="min-w-[42px] h-[42px] inline-flex items-center justify-center text-accent/60 select-none">…</span>
      ) : (
        <a
          href={href(it)}
          class={`${numBase} ${it === currentPage ? numActive : numIdle}`}
          aria-label={`Página ${it}`}
          aria-current={it === currentPage ? 'page' : undefined}
        >
          {it}
        </a>
      )
    )}

    {next ? (
      <a href={next} class={`${edgeBase} ${edgeIdle}`} rel="next" aria-label="Página siguiente">
        <span class="hidden sm:inline">Siguiente</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    ) : (
      <span class={`${edgeBase} ${edgeOff}`} aria-hidden="true">
        <span class="hidden sm:inline">Siguiente</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </span>
    )}
  </nav>
)}
