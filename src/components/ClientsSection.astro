---
import SectionHeader from '@/components/SectionHeader.astro';

const clients = [
  'Productora Musical',
  'Corporativo Internacional',
  'Gobierno CDMX',
  'Arena / Venue',
  'Agencia de Eventos',
  'Hotel 5 Estrellas',
  'Centro de Convenciones',
  'Festival Nacional',
];
---

<section class="bg-dark py-20 sm:py-28">
  <div class="w-full px-[5%] xl:px-[7%]">
    <!-- Heading -->
    <SectionHeader
      eyebrow="Clientes"
      titulo="Confían en nosotros"
      lead="Empresas y organizaciones que eligen nuestra seguridad para sus eventos más importantes."
      parrafos={[
        "Productoras, corporativos, agencias de eventos, hoteles y centros de convenciones confían en SEPRIEV para proteger sus producciones. La mayoría son clientes recurrentes que vuelven a contratarnos evento tras evento.",
        "Desde activaciones de marca y convenciones corporativas hasta festivales y galas, cada cliente recibe un plan de seguridad a la medida. La confianza de quienes ya trabajan con nosotros es nuestra mejor carta de presentación.",
      ]}
    />

    <!-- Clients Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 sm:gap-6">
      {clients.map((client) => (
        <div class="bg-primary/20 border border-primary-light/30 rounded-xl h-28 sm:h-32 flex items-center justify-center px-4">
          <span class="text-accent/60 text-sm sm:text-base font-medium text-center leading-tight">
            {client}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
