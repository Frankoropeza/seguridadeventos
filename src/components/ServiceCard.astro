---
interface Props {
  icon: string;
  title: string;
  description: string;
  features: string[];
}

const { icon, title, description, features } = Astro.props;
---

<div class="group bg-primary/30 border border-primary/50 rounded-xl p-6 hover:border-secondary/50 transition-all hover:bg-primary/50">
  <div class="text-4xl mb-4">{icon}</div>
  <h3 class="text-light font-bold text-lg mb-2">{title}</h3>
  <p class="text-accent text-sm leading-relaxed mb-4">{description}</p>
  <ul class="space-y-1.5">
    {features.map((feature) => (
      <li class="flex items-center gap-2 text-accent text-xs">
        <svg class="w-3.5 h-3.5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        {feature}
      </li>
    ))}
  </ul>
</div>
