---
export interface Props {
  icon: string;
  title: string;
  description: string;
  features?: string[];
  href?: string;
  badge?: string;
  featured?: boolean;
}

const { icon, title, description, features = [], href, badge, featured = false } = Astro.props;
---

<article class={`relative flex flex-col rounded-xl p-6 group transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl ${
  featured
    ? 'bg-gradient-to-b from-secondary/10 to-primary border border-secondary/40 ring-1 ring-secondary/20 hover:shadow-secondary/20'
    : 'bg-primary border border-primary-light hover:border-secondary/40 hover:shadow-secondary/10'
}`}>
  {badge && (
    <span class="absolute -top-3 left-5 bg-secondary text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
      {badge}
    </span>
  )}

  <div class="flex items-start gap-4 mb-4">
    <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-2xl flex-shrink-0 transition-colors ${
      featured ? 'bg-secondary/25 group-hover:bg-secondary/35' : 'bg-secondary/15 group-hover:bg-secondary/25'
    }`}>
      {icon}
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-light font-bold text-lg leading-tight group-hover:text-white transition-colors">{title}</h3>
    </div>
  </div>

  <p class="text-accent text-sm leading-relaxed mb-4 flex-1">{description}</p>

  {features.length > 0 && (
    <ul class="space-y-2 mb-5">
      {features.map(f => (
        <li class="flex items-center gap-2 text-xs text-accent">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true">
            <path d="M5 13l4 4L19 7"/>
          </svg>
          {f}
        </li>
      ))}
    </ul>
  )}

  {href && (
    <a
      href={href}
      class="inline-flex items-center gap-2 text-secondary hover:text-red-400 text-sm font-semibold mt-auto transition-colors group/link"
    >
      Ver servicio completo
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover/link:translate-x-1 transition-transform" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  )}
</article>
