---
const items = [
  {
    label: "Guías Prácticas",
    desc: "Planificación, checklists y operativas para tu evento",
    href: "/blog?cat=Guías",
  },
  {
    label: "Aspectos Legales",
    desc: "Licencias, permisos y normativa de seguridad privada en México",
    href: "/blog?cat=Legal",
  },
  {
    label: "Especialidades",
    desc: "Conciertos, VIP, masivos, deportivos y eventos sociales",
    href: "/blog?cat=Especialidades",
  },
  {
    label: "Solicitar Cotización",
    desc: "Propuesta personalizada en menos de 24 horas",
    href: "/cotizar",
  },
];
---

<nav class="w-full bg-primary border-y border-white/8" aria-label="Navegación del blog">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-white/8">
    {items.map((item) => (
      <a
        href={item.href}
        class="group flex items-center justify-between gap-4 px-8 py-6 hover:bg-white/4 transition-colors duration-200"
      >
        <div>
          <p class="text-light text-sm font-bold tracking-wide group-hover:text-secondary transition-colors duration-200">
            {item.label}
          </p>
          <p class="text-accent text-xs mt-1 leading-relaxed">
            {item.desc}
          </p>
        </div>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="text-accent group-hover:text-secondary group-hover:translate-x-1 transition-all duration-200 flex-shrink-0"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    ))}
  </div>
</nav>
