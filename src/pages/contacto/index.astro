---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { WHATSAPP_NUMBER, WHATSAPP_DISPLAY, PHONE_DISPLAY, EMAIL_CONTACT, ADDRESS_DISPLAY, ZONAS_NAV } from '@/lib/config';
---

<BaseLayout
  title="Contacto — SeguridadEventos México"
  description="Contacta a SeguridadEventos: teléfono, WhatsApp, email. Oficinas en CDMX con cobertura nacional. Respuesta en menos de 24 horas."
>
  <section class="py-16 lg:py-20 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="text-center mb-14">
        <span class="text-secondary text-xs font-bold uppercase tracking-widest">Estamos para ayudarte</span>
        <h1 class="text-3xl sm:text-4xl font-black text-light mt-3">Contacto</h1>
        <p class="text-accent mt-3 max-w-xl mx-auto">Respuesta en menos de 24 horas. Cotización gratuita y sin compromiso.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        <!-- WhatsApp -->
        <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C+necesito+información+sobre+seguridad+para+mi+evento`} target="_blank" rel="noopener" class="flex flex-col items-center text-center p-8 bg-primary border border-primary-light rounded-xl hover:border-green-500/40 transition-colors group">
          <div class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mb-4">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="white" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            </svg>
          </div>
          <h2 class="text-light font-bold text-lg mb-1 group-hover:text-green-400 transition-colors">WhatsApp</h2>
          <p class="text-accent text-sm mb-2">Respuesta inmediata</p>
          <span class="text-secondary font-semibold">{WHATSAPP_DISPLAY}</span>
        </a>

        <!-- Teléfono -->
        <a href={`tel:${PHONE_DISPLAY.replace(/\\s/g,'')}`} class="flex flex-col items-center text-center p-8 bg-primary border border-primary-light rounded-xl hover:border-secondary/40 transition-colors group">
          <div class="w-16 h-16 bg-secondary rounded-full flex items-center justify-center mb-4">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
            </svg>
          </div>
          <h2 class="text-light font-bold text-lg mb-1 group-hover:text-secondary transition-colors">Teléfono</h2>
          <p class="text-accent text-sm mb-2">Lun - Sáb, 8:00 - 20:00</p>
          <span class="text-secondary font-semibold">{PHONE_DISPLAY}</span>
        </a>

        <!-- Email -->
        <a href={`mailto:${EMAIL_CONTACT}`} class="flex flex-col items-center text-center p-8 bg-primary border border-primary-light rounded-xl hover:border-secondary/40 transition-colors group sm:col-span-2 lg:col-span-1">
          <div class="w-16 h-16 bg-primary-light rounded-full flex items-center justify-center mb-4 border-2 border-accent/20">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true">
              <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h2 class="text-light font-bold text-lg mb-1 group-hover:text-secondary transition-colors">Email</h2>
          <p class="text-accent text-sm mb-2">Respuesta en 24 horas</p>
          <span class="text-secondary font-semibold text-sm">{EMAIL_CONTACT}</span>
        </a>
      </div>

      <!-- Cobertura -->
      <div class="bg-primary border border-primary-light rounded-xl p-8 text-center">
        <h2 class="text-2xl font-black text-light mb-3">Cobertura nacional</h2>
        <p class="text-accent mb-6 max-w-xl mx-auto">Oficinas en Ciudad de México con cobertura en las principales ciudades del país.</p>
        <div class="flex flex-wrap justify-center gap-3">
          {ZONAS_NAV.map((z: {slug: string; nombre: string}) => (
            <a href={`/zonas/${z.slug}`} class="bg-dark border border-primary-light px-4 py-2 rounded-lg text-accent text-sm hover:text-light hover:border-secondary/40 transition-colors">
              📍 {z.nombre}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
