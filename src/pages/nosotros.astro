---
import BaseLayout from '@layouts/BaseLayout.astro';
import TrustBadges from '@components/TrustBadges.astro';
import StatsSection from '@components/StatsSection.astro';
import CTABanner from '@components/CTABanner.astro';
---

<BaseLayout
  title="Sobre Nosotros | Seguridad Eventos"
  description="Conoce nuestra historia, mision y equipo. Mas de 15 anos protegiendo eventos en Mexico con personal certificado y tecnologia de punta."
>
  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Quienes somos</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
        Sobre <span class="text-secondary">Nosotros</span>
      </h1>
      <p class="text-accent text-lg sm:text-xl max-w-3xl mx-auto leading-relaxed">
        Somos una empresa mexicana especializada en seguridad privada para eventos, respaldada por mas de 15 anos de experiencia, certificaciones oficiales y un equipo altamente capacitado.
      </p>
    </div>
  </section>

  <!-- Nuestra Historia -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Desde 2009</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light mt-2 mb-6">
            Nuestra <span class="text-secondary">Historia</span>
          </h2>
          <div class="space-y-4 text-accent leading-relaxed">
            <p>
              Fundada en 2009, Seguridad Eventos nacio con la mision de transformar la seguridad en eventos en Mexico. Comenzamos protegiendo eventos corporativos en la Ciudad de Mexico, donde rapidamente nos ganamos la confianza de productoras, empresas y organizadores por nuestro profesionalismo y atencion al detalle.
            </p>
            <p>
              Con el paso de los anos, crecimos hasta convertirnos en un referente nacional. Hoy ofrecemos cobertura en todo el pais, desde conciertos masivos y festivales hasta eventos gubernamentales y sociales de alto perfil. Nuestra expansion ha sido posible gracias a la inversion constante en capacitacion, tecnologia y procesos certificados.
            </p>
            <p>
              A lo largo de mas de 15 anos, hemos protegido mas de 500 eventos sin un solo incidente grave, consolidando una reputacion basada en resultados, no en promesas.
            </p>
          </div>
        </div>

        <!-- Timeline visual -->
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 rounded-full bg-secondary/20 border-2 border-secondary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21" />
                </svg>
              </div>
              <div class="w-0.5 h-full bg-primary-light/30 mt-2"></div>
            </div>
            <div class="pb-8">
              <h3 class="text-light font-bold text-lg">2009 - Fundacion</h3>
              <p class="text-accent text-sm mt-1">Iniciamos operaciones en la Ciudad de Mexico, especializandonos en seguridad para eventos corporativos.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 rounded-full bg-secondary/20 border-2 border-secondary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
              </div>
              <div class="w-0.5 h-full bg-primary-light/30 mt-2"></div>
            </div>
            <div class="pb-8">
              <h3 class="text-light font-bold text-lg">2013 - Expansion</h3>
              <p class="text-accent text-sm mt-1">Ampliamos servicios a conciertos y festivales masivos, alcanzando cobertura en zona metropolitana y estados cercanos.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 rounded-full bg-secondary/20 border-2 border-secondary flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
              </div>
              <div class="w-0.5 h-full bg-primary-light/30 mt-2"></div>
            </div>
            <div class="pb-8">
              <h3 class="text-light font-bold text-lg">2017 - Certificaciones</h3>
              <p class="text-accent text-sm mt-1">Obtuvimos la certificacion ISO 9001 y renovamos licencias DGSSP, consolidando nuestro compromiso con la calidad.</p>
            </div>
          </div>

          <div class="flex gap-4">
            <div class="flex flex-col items-center">
              <div class="w-12 h-12 rounded-full bg-gold/20 border-2 border-gold flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.562.562 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                </svg>
              </div>
            </div>
            <div>
              <h3 class="text-light font-bold text-lg">Hoy - Cobertura Nacional</h3>
              <p class="text-accent text-sm mt-1">Mas de 500 eventos protegidos, 1,000+ guardias certificados y presencia en toda la Republica Mexicana.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mision y Vision -->
  <section class="py-20 bg-primary/20 border-y border-primary/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Nuestro proposito</span>
        <h2 class="text-3xl sm:text-4xl font-black text-light mt-2">
          Mision y <span class="text-secondary">Vision</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Mision -->
        <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-8">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-full bg-secondary/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
              </svg>
            </div>
            <h3 class="text-light font-black text-2xl">Mision</h3>
          </div>
          <p class="text-accent leading-relaxed">
            Proporcionar soluciones integrales de seguridad para eventos que garanticen la proteccion de personas, bienes e instalaciones, mediante personal altamente capacitado, tecnologia de vanguardia y protocolos probados. Nos comprometemos a superar las expectativas de nuestros clientes con un servicio profesional, confiable y adaptado a cada necesidad.
          </p>
        </div>

        <!-- Vision -->
        <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-8">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-7 h-7 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h3 class="text-light font-black text-2xl">Vision</h3>
          </div>
          <p class="text-accent leading-relaxed">
            Ser la empresa lider en seguridad para eventos en Mexico y Latinoamerica, reconocida por nuestra excelencia operativa, innovacion tecnologica y compromiso inquebrantable con la seguridad. Aspiramos a establecer los estandares mas altos de la industria, formando profesionales de elite y desarrollando soluciones que anticipen las necesidades del mercado.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Nuestro Equipo -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Capital humano</span>
        <h2 class="text-3xl sm:text-4xl font-black text-light mt-2">
          Nuestro <span class="text-secondary">Equipo</span>
        </h2>
        <p class="text-accent mt-4 max-w-2xl mx-auto">
          Contamos con un equipo directivo con mas de 20 anos de experiencia en seguridad privada, respaldado por personal operativo certificado y en constante capacitacion.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Direccion -->
        <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-secondary/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
          </div>
          <h3 class="text-light font-bold text-lg mb-2">Equipo Directivo</h3>
          <p class="text-accent text-sm leading-relaxed">
            Profesionales con mas de 20 anos en seguridad privada y gestion de riesgos. Experiencia en coordinacion con autoridades federales, estatales y municipales.
          </p>
        </div>

        <!-- Operaciones -->
        <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-gold/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
          <h3 class="text-light font-bold text-lg mb-2">Personal Operativo</h3>
          <p class="text-accent text-sm leading-relaxed">
            Mas de 1,000 guardias certificados por la STPS, con entrenamiento en primeros auxilios, manejo de crisis, control de multitudes y comunicacion por radio.
          </p>
        </div>

        <!-- Capacitacion -->
        <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6 text-center">
          <div class="w-16 h-16 rounded-full bg-secondary/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
            </svg>
          </div>
          <h3 class="text-light font-bold text-lg mb-2">Capacitacion Continua</h3>
          <p class="text-accent text-sm leading-relaxed">
            Programas de formacion permanente que incluyen simulacros de evacuacion, protocolos anti-estampida, deteccion de riesgos y actualizacion en normatividad vigente.
          </p>
        </div>
      </div>

      <!-- Valores -->
      <div class="mt-16">
        <h3 class="text-2xl font-black text-light text-center mb-8">Nuestros Valores</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="flex items-center gap-3 bg-primary/20 border border-primary/40 rounded-lg p-4">
            <svg class="w-6 h-6 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-light font-semibold text-sm">Profesionalismo</span>
          </div>
          <div class="flex items-center gap-3 bg-primary/20 border border-primary/40 rounded-lg p-4">
            <svg class="w-6 h-6 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-light font-semibold text-sm">Integridad</span>
          </div>
          <div class="flex items-center gap-3 bg-primary/20 border border-primary/40 rounded-lg p-4">
            <svg class="w-6 h-6 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-light font-semibold text-sm">Compromiso</span>
          </div>
          <div class="flex items-center gap-3 bg-primary/20 border border-primary/40 rounded-lg p-4">
            <svg class="w-6 h-6 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-light font-semibold text-sm">Innovacion</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- Stats -->
  <StatsSection />

  <!-- CTA -->
  <CTABanner
    title="¿Listo para trabajar con los mejores?"
    subtitle="Contactanos y descubre por que mas de 500 eventos confian en nosotros."
  />
</BaseLayout>
