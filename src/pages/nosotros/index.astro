---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TrustSection from '@/components/TrustSection.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import CTABanner from '@/components/CTABanner.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHero from '@/components/PageHero.astro';
import PageNav from '@/components/PageNav.astro';
import { STATS } from '@/lib/config';

const navItems = [
  {
    label: "Nuestra Historia",
    desc: "Cómo comenzamos y nuestra evolución en el sector",
    href: "#historia",
  },
  {
    label: "Certificaciones",
    desc: "Licencia DGSSP, STPS e ISO 9001:2015 vigentes",
    href: "/certificaciones",
  },
  {
    label: "Nuestro Equipo",
    desc: "+1,200 guardias certificados listos para tu evento",
    href: "#equipo",
  },
  {
    label: "Solicitar Cotización",
    desc: "Propuesta personalizada en menos de 24 horas",
    href: "/cotizar",
  },
];
---

<BaseLayout
  title="Empresa de seguridad para eventos | seguridad privada para eventos | guardias certificados"
  description="Empresa de seguridad para eventos: SEPRIEV es la empresa de seguridad privada para eventos y fiestas con más experiencia y guardias certificados en México."
>
  <Breadcrumb items={[{ label: 'Nosotros' }]} />

  <PageHero
    eyebrow="SEPRIEV — Nuestra empresa"
    titulo="Más de 30 Años Protegiendo Eventos en México"
    subtitulo="Empresa mexicana certificada DGSSP y STPS. Más de 500 eventos protegidos, 1,200 guardias certificados, cero incidentes graves."
  >
    <Fragment slot="right">
      <p class="text-accent text-base leading-relaxed">
        <strong class="text-light font-semibold">SEPRIEV</strong> es una empresa mexicana de seguridad privada especializada en eventos con <strong class="text-light font-semibold">más de 30 años de experiencia</strong> en la industria del entretenimiento, el sector corporativo y los eventos sociales. Con presencia en <strong class="text-light font-semibold">CDMX, Guadalajara, Monterrey, Puebla y Cancún</strong>, y más de <strong class="text-light font-semibold">1,200 guardias certificados</strong>, somos el socio de seguridad que los mejores eventos del país confían.
      </p>
      <p class="text-accent text-base leading-relaxed">
        Nuestra <strong class="text-light font-semibold">licencia DGSSP federal vigente</strong>, certificación <strong class="text-light font-semibold">STPS</strong> e <strong class="text-light font-semibold">ISO 9001:2015</strong> respaldan cada operación con los más altos estándares de la industria. En más de <strong class="text-light font-semibold">500 eventos protegidos</strong> mantenemos un récord de <strong class="text-light font-semibold">cero incidentes graves</strong>. La mejor seguridad es la que no se nota pero siempre está presente.
      </p>
    </Fragment>
  </PageHero>

  <PageNav items={navItems} ariaLabel="Navegación de la página Nosotros" />

  <!-- Stats -->
  <section class="py-12 bg-primary/40 border-b border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 text-center">
        {STATS.map((s: {valor: string; etiqueta: string}) => (
          <div>
            <div class="text-4xl font-black text-secondary">{s.valor}</div>
            <div class="text-accent text-sm mt-1">{s.etiqueta}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section id="historia" class="py-20 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Quiénes somos"
        titulo="Profesionales de la seguridad en eventos"
        lead="Una empresa de seguridad privada especializada exclusivamente en eventos."
        parrafos={[
          "SEPRIEV nació de la experiencia directa en la industria del entretenimiento y los eventos corporativos. Nuestros fundadores trabajaron en seguridad operativa durante años antes de crear una empresa que elevara los estándares del sector.",
          "Hoy somos referencia en seguridad para conciertos, convenciones, ferias, eventos deportivos, bodas y eventos masivos en las principales ciudades de México: CDMX, Guadalajara, Monterrey, Puebla y Cancún.",
        ]}
      />
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-4 text-accent leading-relaxed">
          <p>Cada evento es diferente. Por eso diseñamos <strong class="text-light">planes operativos personalizados</strong> para cada cliente, con personal seleccionado específicamente para el tipo de evento y sus requerimientos.</p>
        </div>
        <div class="bg-primary border border-primary-light rounded-xl p-8 space-y-6">
          <h3 class="text-light font-bold text-lg">Nuestros valores</h3>
          {[
            { icon: "🛡️", titulo: "Profesionalismo", desc: "Cada guardia es certificado, evaluado y supervisado. No improvisamos." },
            { icon: "🤝", titulo: "Compromiso", desc: "Tu evento es nuestra responsabilidad. No dejamos cabos sueltos." },
            { icon: "👁️", titulo: "Discreción", desc: "La mejor seguridad es la que no se nota pero siempre está presente." },
            { icon: "⚡", titulo: "Respuesta inmediata", desc: "Cotización en 24 horas. Despliegue en el tiempo acordado. Sin excusas." },
          ].map((v: any) => (
            <div class="flex items-start gap-4">
              <span class="text-2xl flex-shrink-0">{v.icon}</span>
              <div>
                <h4 class="text-light font-bold text-sm">{v.titulo}</h4>
                <p class="text-accent text-sm">{v.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Equipo -->
  <section id="equipo" class="py-20 bg-primary/30 border-y border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Capital humano"
        titulo="Nuestro equipo"
        lead="Más de 1,200 profesionales certificados listos para proteger tu evento."
        parrafos={[
          "Nuestro equipo combina guardias certificados DGSSP, supervisores con años de experiencia en campo, agentes de protección VIP y un staff operativo de coordinación, logística y tecnología. Cada perfil se selecciona según el tipo de evento y sus requerimientos específicos.",
          "Todo el personal pasa por evaluación, capacitación continua y supervisión permanente. No subcontratamos: el equipo que cotizas es el equipo que opera tu evento, con la misma cadena de mando y los mismos protocolos en cada despliegue.",
        ]}
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { titulo: "Guardias de seguridad", cantidad: "1,000+", desc: "Licencia DGSSP individual, certificación STPS y evaluación periódica." },
          { titulo: "Supervisores", cantidad: "80+", desc: "Mínimo 5 años de experiencia. Líderes de operaciones en campo." },
          { titulo: "Agentes VIP", cantidad: "50+", desc: "Protección ejecutiva, escoltas certificados, entrenamiento avanzado." },
          { titulo: "Staff operativo", cantidad: "70+", desc: "Coordinadores, logística, tecnología, administración y soporte." },
        ].map((e: any) => (
          <div class="bg-dark border border-primary-light rounded-xl p-6 text-center">
            <div class="text-3xl font-black text-secondary mb-1">{e.cantidad}</div>
            <h3 class="text-light font-bold text-sm mb-2">{e.titulo}</h3>
            <p class="text-accent text-xs leading-relaxed">{e.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TrustSection />
  <ProcessSection />

  <CTABanner titulo="¿Listo para trabajar con profesionales?" subtitulo="Más de 500 eventos avalan nuestro compromiso. Cotización personalizada en 24 horas." />
</BaseLayout>
