<style>
  .cta-faq > summary { list-style: none; }
  .cta-faq > summary::-webkit-details-marker { display: none; }
  .cta-faq[open] .cta-faq-icon { transform: rotate(180deg); }
</style>

<script define:vars={{ WA: WHATSAPP_NUMBER, MAIL: EMAIL_RH }}>
  const form = document.querySelector('form[data-wa-apply]');

  function buildLines() {
    const fd = new FormData(form);
    const v = (k) => String(fd.get(k) || '').trim();
    const lines = ['Hola, quiero postularme a la bolsa de trabajo de SEPRIEV:', ''];
    lines.push('Nombre: ' + v('nombre'));
    if (v('telefono')) lines.push('Teléfono: ' + v('telefono'));
    if (v('email')) lines.push('Email: ' + v('email'));
    if (v('puesto')) lines.push('Puesto: ' + v('puesto'));
    if (v('ciudad')) lines.push('Ciudad: ' + v('ciudad'));
    if (v('experiencia')) lines.push('Experiencia: ' + v('experiencia'));
    if (v('mensaje')) { lines.push(''); lines.push('Mensaje: ' + v('mensaje')); }
    return lines;
  }

  // Envío por WhatsApp
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const url = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(buildLines().join('\n'));
    window.open(url, '_blank', 'noopener');
  });

  // Envío por correo
  document.querySelector('[data-email-apply]')?.addEventListener('click', () => {
    if (!form.reportValidity()) return;
    const body = buildLines().join('\n') + '\n\n(No olvides adjuntar tu CV a este correo.)';
    window.location.href = 'mailto:' + MAIL
      + '?subject=' + encodeURIComponent('Postulación - Bolsa de Trabajo SEPRIEV')
      + '&body=' + encodeURIComponent(body);
  });
</script>
