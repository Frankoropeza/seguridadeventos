---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHero from '@/components/PageHero.astro';
import PageNav from '@/components/PageNav.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CTABanner from '@/components/CTABanner.astro';
import { SITE, SITE_NAME, WHATSAPP_NUMBER, EMAIL_RH } from '@/lib/config';
import { buildFAQSchema } from '@/lib/seo';
import { VACANTES, CIUDADES, BENEFICIOS, PROCESO, type Vacante } from '@/lib/vacantes';

export async function getStaticPaths() {
  return VACANTES.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}

interface Props { v: Vacante; }
const { v } = Astro.props;

const canonical = `${SITE}/bolsa-de-trabajo/${v.slug}`;
const ogImg = new URL(`${v.imagen}-1200.jpg`, SITE).toString();

const metaTitle = `Vacante ${v.puesto} | Empleo seguridad privada | SEPRIEV`;
const metaDescription = `${v.desc} Postúlate en SEPRIEV: capacitación STPS, prestaciones de ley y registro en línea.`;

const datePosted = '2026-06-18';
const validThrough = '2026-12-31';

const resumen = [
  { label: 'Puesto', valor: v.puesto },
  { label: 'Tipo de contratación', valor: v.tipo },
  { label: 'Ubicación', valor: v.ubicacion },
  { label: 'Jornada', valor: v.jornada },
  { label: 'Experiencia', valor: v.experienciaResumen },
  { label: 'Capacitación', valor: 'Certificada STPS, sin costo' },
];

const ciudadesSchema = v.ciudades.map((k) => CIUDADES[k]).filter(Boolean);

// ───────────────────────── Schema.org JobPosting + FAQ + Breadcrumb ─────────────
const jobDescription = `${v.introParrafos.join(' ')} Responsabilidades: ${v.responsabilidades.join(' ')} Requisitos: ${v.indispensables.join(', ')}. Ofrecemos capacitación certificada STPS, prestaciones de ley, uniforme y equipo, y plan de crecimiento. SEPRIEV cuenta con licencia DGSSP federal vigente.`;

const jobPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  'title': v.puesto,
  'description': jobDescription,
  'datePosted': datePosted,
  'validThrough': validThrough,
  'employmentType': v.employmentType,
  'hiringOrganization': {
    '@type': 'Organization',
    'name': SITE_NAME,
    'sameAs': SITE,
    'logo': `${SITE}/img/logo-sepriev.png`,
  },
  'industry': 'Seguridad privada',
  'occupationalCategory': v.occupationalCategory,
  'directApply': true,
  'applicantLocationRequirements': { '@type': 'Country', 'name': 'México' },
  'jobLocation': ciudadesSchema.map((c) => ({
    '@type': 'Place',
    'address': {
      '@type': 'PostalAddress',
      'addressLocality': c.l,
      'addressRegion': c.r,
      'addressCountry': 'MX',
    },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Inicio', 'item': `${SITE}/` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Bolsa de Trabajo', 'item': `${SITE}/bolsa-de-trabajo` },
    { '@type': 'ListItem', 'position': 3, 'name': v.puesto, 'item': canonical },
  ],
};

const schemas = [jobPostingSchema, buildFAQSchema(v.faq), breadcrumbSchema];

// Otras vacantes (para el bloque de relacionadas)
const otras = VACANTES.filter((x) => x.slug !== v.slug);

const navItems = [
  { label: 'La vacante', desc: 'Descripción y responsabilidades del puesto', href: '#vacante' },
  { label: 'Requisitos', desc: 'Perfil y documentos para postularte', href: '#requisitos' },
  { label: 'Beneficios', desc: 'Sueldo, prestaciones y crecimiento', href: '#beneficios' },
  { label: 'Postúlate', desc: 'Regístrate en línea en minutos', href: '#postular' },
];

const inputBase =
  'w-full bg-dark border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors';
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonical={canonical}
  ogImage={ogImg}
  schema={schemas}
>
  <Breadcrumb items={[
    { label: 'Bolsa de Trabajo', href: '/bolsa-de-trabajo/' },
    { label: v.puesto },
  ]} />

  <PageHero
    eyebrow="SEPRIEV — Vacante abierta"
    titulo={v.puesto}
    subtitulo={v.heroSub}
  >
    <Fragment slot="right">
      <div class="flex flex-wrap gap-2">
        <span class="bg-secondary text-white text-[11px] font-black px-3 py-1.5 uppercase tracking-[0.12em] rounded-full">{v.tipo}</span>
        <span class="border border-primary-light text-accent text-[11px] font-bold px-3 py-1.5 uppercase tracking-[0.12em] rounded-full">{v.experienciaResumen}</span>
      </div>
      <ul class="space-y-3">
        {resumen.map((r) => (
          <li class="flex items-start gap-3 text-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-1" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-accent"><strong class="text-light font-semibold">{r.label}:</strong> {r.valor}</span>
          </li>
        ))}
      </ul>
      <a href="#postular" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-6 py-3 rounded-lg font-bold uppercase tracking-wide text-sm transition-colors">
        Postular a este puesto
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </Fragment>
  </PageHero>

  <PageNav items={navItems} ariaLabel="Navegación de la vacante" />

  <!-- Descripción del puesto -->
  <section id="vacante" class="py-20 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="La vacante"
        titulo="¿En qué consiste el puesto?"
        lead={v.introLead}
        parrafos={v.introParrafos}
      />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
        <div class="rounded-2xl overflow-hidden border border-white/8">
          <picture>
            <source type="image/avif" srcset={`${v.imagen}-640.avif 640w, ${v.imagen}-1200.avif 1200w`} sizes="(max-width: 1024px) 100vw, 600px" />
            <source type="image/jpeg" srcset={`${v.imagen}-640.jpg 640w, ${v.imagen}-1200.jpg 1200w`} sizes="(max-width: 1024px) 100vw, 600px" />
            <img src={`${v.imagen}-1200.jpg`} alt={`${v.puesto} — SEPRIEV`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="1200" height="675" />
          </picture>
        </div>

        <div>
          <h3 class="text-light font-black text-xl sm:text-2xl mb-5">Responsabilidades principales</h3>
          <ul class="space-y-3">
            {v.responsabilidades.map((r) => (
              <li class="flex items-start gap-3 text-accent text-sm sm:text-[15px] leading-relaxed">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {r}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Requisitos -->
  <section id="requisitos" class="py-20 bg-primary/30 border-y border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="¿Qué necesitas?"
        titulo="Requisitos del puesto"
        lead="Esto es lo que buscamos. Si cumples la mayoría, queremos conocerte."
        parrafos={[
          'Más que un currículum perfecto, valoramos el compromiso, la actitud y la disposición a capacitarte. Nosotros ponemos la formación, el equipo y el respaldo de una empresa formal.',
          'Si te falta algún documento, como la carta de no antecedentes penales, no te preocupes: te orientamos paso a paso sobre cómo tramitarlo para tu alta.',
        ]}
      />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-dark border border-primary-light rounded-xl p-6 sm:p-8">
          <h3 class="text-light font-bold text-base mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-secondary"></span> Indispensables
          </h3>
          <ul class="space-y-2.5">
            {v.indispensables.map((r) => (
              <li class="flex items-start gap-2.5 text-accent text-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {r}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-dark border border-primary-light rounded-xl p-6 sm:p-8">
          <h3 class="text-light font-bold text-base mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-gold"></span> Deseables (suman puntos)
          </h3>
          <ul class="space-y-2.5">
            {v.deseables.map((r) => (
              <li class="flex items-start gap-2.5 text-accent text-sm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {r}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section id="beneficios" class="py-20 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Por qué SEPRIEV"
        titulo="Lo que te ofrecemos"
        lead="Un empleo formal, seguro y con futuro en el sector de seguridad para eventos."
        parrafos={[
          'Sabemos que la mejor seguridad la hacen las mejores personas. Por eso invertimos en nuestro equipo con capacitación, prestaciones superiores al promedio y un ambiente de respeto y profesionalismo.',
          'Trabajar en SEPRIEV significa estar respaldado por una empresa con licencia federal vigente, presencia en los eventos más importantes del país y una trayectoria de más de 500 eventos protegidos sin un solo incidente grave.',
        ]}
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {BENEFICIOS.map((b) => (
          <div class="bg-primary border border-primary-light rounded-xl p-6 flex items-start gap-4">
            <span class="text-3xl flex-shrink-0" aria-hidden="true">{b.icon}</span>
            <div>
              <h3 class="text-light font-bold text-base mb-1.5">{b.titulo}</h3>
              <p class="text-accent text-sm leading-relaxed">{b.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/30 border-y border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Cómo es el proceso"
        titulo="De la postulación a tu primer evento"
        lead="Cinco pasos claros y rápidos."
        variant="simple"
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {PROCESO.map((p) => (
          <div class="relative bg-dark border border-primary-light rounded-xl p-6">
            <div class="text-3xl font-black text-secondary/30 mb-3">{p.paso}</div>
            <h3 class="text-light font-bold text-sm mb-2">{p.titulo}</h3>
            <p class="text-accent text-xs leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Postúlate: FAQ + Formulario -->
  <section id="postular" class="relative overflow-hidden bg-gradient-to-br from-dark via-primary/40 to-dark py-16 lg:py-24 border-t border-primary">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent" aria-hidden="true"></div>

    <div class="relative w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Postúlate ahora"
        titulo="Regístrate para esta vacante"
        lead="Completa el formulario y envíanos tus datos por WhatsApp, o adjunta tu CV por correo. Te contactamos lo antes posible."
      />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">

        <!-- FAQ -->
        <div id="faq">
          <h3 class="text-light font-black text-xl sm:text-2xl mb-6 flex items-center gap-2.5">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            Preguntas frecuentes
          </h3>

          <div class="space-y-3 sm:space-y-4">
            {v.faq.map((item) => (
              <details class="cta-faq bg-primary border border-primary-light rounded-xl overflow-hidden">
                <summary class="cta-faq-summary list-none flex justify-between items-center gap-4 px-5 sm:px-6 py-4 text-light font-semibold text-sm sm:text-[15px] cursor-pointer hover:text-secondary transition-colors">
                  <span>{item.q}</span>
                  <svg class="cta-faq-icon w-5 h-5 flex-shrink-0 text-secondary transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M6 9l6 6 6-6"/>
                  </svg>
                </summary>
                <div class="px-5 sm:px-6 pb-5 -mt-1">
                  <p class="text-accent text-sm leading-relaxed">{item.a}</p>
                </div>
              </details>
            ))}
          </div>

          <!-- Otras vacantes -->
          <div class="mt-8">
            <h4 class="text-light font-bold text-sm uppercase tracking-wider mb-3">Otras vacantes</h4>
            <div class="flex flex-wrap gap-2">
              {otras.map((o) => (
                <a href={`/bolsa-de-trabajo/${o.slug}/`} class="text-xs text-accent hover:text-secondary border border-primary-light hover:border-secondary rounded-full px-3 py-1.5 transition-colors">
                  {o.puesto}
                </a>
              ))}
            </div>
          </div>

          <div class="mt-6 rounded-xl border border-primary-light bg-primary/50 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <p class="text-accent text-sm">¿Prefieres enviar tu CV por correo?</p>
            <a
              href={`mailto:${EMAIL_RH}?subject=${encodeURIComponent('Postulación - ' + v.puesto)}`}
              class="inline-flex items-center justify-center gap-2 border border-primary-light hover:border-secondary text-light px-4 py-2.5 rounded-lg text-sm font-semibold transition-colors"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              {EMAIL_RH}
            </a>
          </div>
        </div>

        <!-- Formulario -->
        <div class="bg-primary border border-primary-light rounded-2xl p-6 sm:p-8 shadow-xl shadow-black/30">
          <h3 class="text-light font-black text-xl sm:text-2xl mb-1.5">Formulario de registro</h3>
          <p class="text-accent text-sm mb-6">Postulación a: <strong class="text-light font-semibold">{v.puesto}</strong></p>

          <form data-wa-apply class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="ap-nombre" class="block text-light text-sm font-semibold mb-1.5">Nombre completo *</label>
                <input type="text" id="ap-nombre" name="nombre" required class={inputBase + ' placeholder:text-accent/50'} placeholder="Tu nombre" />
              </div>
              <div>
                <label for="ap-telefono" class="block text-light text-sm font-semibold mb-1.5">Teléfono / WhatsApp *</label>
                <input type="tel" id="ap-telefono" name="telefono" required class={inputBase + ' placeholder:text-accent/50'} placeholder="55 1234 5678" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="ap-email" class="block text-light text-sm font-semibold mb-1.5">Email</label>
                <input type="email" id="ap-email" name="email" class={inputBase + ' placeholder:text-accent/50'} placeholder="tu@email.com" />
              </div>
              <div>
                <label for="ap-ciudad" class="block text-light text-sm font-semibold mb-1.5">Ciudad *</label>
                <select id="ap-ciudad" name="ciudad" required class={inputBase}>
                  <option value="">Selecciona...</option>
                  <option value="Ciudad de México">Ciudad de México</option>
                  <option value="Guadalajara">Guadalajara</option>
                  <option value="Monterrey">Monterrey</option>
                  <option value="Puebla">Puebla</option>
                  <option value="Cancún">Cancún</option>
                  <option value="Otra">Otra ciudad</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="ap-experiencia" class="block text-light text-sm font-semibold mb-1.5">Experiencia</label>
                <select id="ap-experiencia" name="experiencia" class={inputBase}>
                  <option value="">Selecciona...</option>
                  <option value="Sin experiencia">Sin experiencia</option>
                  <option value="Menos de 1 año">Menos de 1 año</option>
                  <option value="1 - 3 años">1 - 3 años</option>
                  <option value="Más de 3 años">Más de 3 años</option>
                </select>
              </div>
              <div>
                <label for="ap-modalidad" class="block text-light text-sm font-semibold mb-1.5">Modalidad de interés</label>
                <select id="ap-modalidad" name="modalidad" class={inputBase}>
                  <option value="">Selecciona...</option>
                  <option value="Tiempo completo">Tiempo completo</option>
                  <option value="Por evento / proyecto">Por evento / proyecto</option>
                  <option value="Cualquiera">Cualquiera</option>
                </select>
              </div>
            </div>

            <div>
              <label for="ap-mensaje" class="block text-light text-sm font-semibold mb-1.5">Mensaje (opcional)</label>
              <textarea id="ap-mensaje" name="mensaje" rows="3" class={inputBase + ' placeholder:text-accent/50 resize-none'} placeholder="Cuéntanos brevemente sobre ti y tu disponibilidad..."></textarea>
            </div>

            <label class="flex items-start gap-3 text-accent text-sm cursor-pointer">
              <input type="checkbox" id="ap-edad" name="edad" required class="mt-0.5 w-4 h-4 accent-secondary flex-shrink-0" />
              <span>Confirmo que soy mayor de 18 años y que la información proporcionada es verídica. *</span>
            </label>

            <button
              type="submit"
              class="w-full bg-secondary hover:bg-red-700 text-white px-6 py-4 rounded-lg font-bold uppercase tracking-wide text-sm transition-colors flex items-center justify-center gap-2"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              </svg>
              Postularme por WhatsApp
            </button>

            <button
              type="button"
              data-email-apply
              class="w-full border border-primary-light hover:border-secondary text-light px-6 py-3.5 rounded-lg font-semibold text-sm transition-colors flex items-center justify-center gap-2"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Enviar por correo (adjunta tu CV)
            </button>

            <p class="text-accent text-xs text-center leading-relaxed">
              Al enviar se abrirá WhatsApp o tu correo con tus datos. Aceptas nuestro
              <a href="/aviso-de-privacidad/" class="text-secondary hover:underline">aviso de privacidad</a>.
            </p>
          </form>
        </div>

      </div>

      <div class="mt-10 text-center">
        <a href="/bolsa-de-trabajo/" class="inline-flex items-center gap-2 text-secondary hover:text-red-400 text-sm font-bold uppercase tracking-[0.1em] transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Ver todas las vacantes
        </a>
      </div>
    </div>
  </section>

  <CTABanner
    titulo="¿Listo para sumarte al mejor equipo de seguridad para eventos?"
    subtitulo="Regístrate hoy y da el primer paso hacia un empleo formal, con capacitación y crecimiento."
    variant="dark"
  />
</BaseLayout>

<style>
  .cta-faq > summary { list-style: none; }
  .cta-faq > summary::-webkit-details-marker { display: none; }
  .cta-faq[open] .cta-faq-icon { transform: rotate(180deg); }
</style>

<script define:vars={{ WA: WHATSAPP_NUMBER, MAIL: EMAIL_RH, PUESTO: v.puesto }}>
  const form = document.querySelector('form[data-wa-apply]');

  function buildLines() {
    const fd = new FormData(form);
    const val = (k) => String(fd.get(k) || '').trim();
    const lines = ['Hola, quiero postularme a la vacante de SEPRIEV:', ''];
    lines.push('Puesto: ' + PUESTO);
    lines.push('Nombre: ' + val('nombre'));
    if (val('telefono')) lines.push('Teléfono: ' + val('telefono'));
    if (val('email')) lines.push('Email: ' + val('email'));
    if (val('ciudad')) lines.push('Ciudad: ' + val('ciudad'));
    if (val('experiencia')) lines.push('Experiencia: ' + val('experiencia'));
    if (val('modalidad')) lines.push('Modalidad: ' + val('modalidad'));
    if (val('mensaje')) { lines.push(''); lines.push('Mensaje: ' + val('mensaje')); }
    return lines;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const url = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(buildLines().join('\n'));
    window.open(url, '_blank', 'noopener');
  });

  document.querySelector('[data-email-apply]')?.addEventListener('click', () => {
    if (!form.reportValidity()) return;
    const body = buildLines().join('\n') + '\n\n(No olvides adjuntar tu CV a este correo.)';
    window.location.href = 'mailto:' + MAIL
      + '?subject=' + encodeURIComponent('Postulación - ' + PUESTO)
      + '&body=' + encodeURIComponent(body);
  });
</script>
