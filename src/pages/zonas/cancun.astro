---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTABanner from '@/components/CTABanner.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { WHATSAPP_NUMBER, SITE } from '@/lib/config';
import { buildFAQSchema } from '@/lib/seo';

const faq = [
  { q: "¿Cubren todo tipo de eventos en Cancún?", a: "Sí, cubrimos conciertos, eventos corporativos, ferias, bodas, eventos deportivos, eventos masivos y más en Cancún y su zona metropolitana. Contamos con personal local certificado." },
  { q: "¿Cuántos guardias tienen disponibles en Cancún?", a: "Contamos con 200+ guardias certificados disponibles en Cancún. Para eventos masivos podemos desplegar equipos desde otras sedes." },
  { q: "¿Tienen licencia para operar en Cancún?", a: "Sí, contamos con licencia DGSSP federal que nos autoriza a operar en toda la República Mexicana, incluyendo Cancún. Además, cumplimos con los registros locales correspondientes." },
  { q: "¿Cuánto cuesta la seguridad para un evento en Cancún?", a: "El costo depende del tipo de evento, aforo, duración y servicios requeridos. Solicita una cotización personalizada y te respondemos en menos de 24 horas con una propuesta detallada." },
];

const schema = buildFAQSchema(faq);
---

<BaseLayout
  title="Seguridad para eventos en Cancún | seguridad privada para fiestas | guardias para eventos Cancún"
  description="Seguridad para eventos en Cancún: SEPRIEV ofrece seguridad privada para eventos y fiestas en Cancún y la Riviera Maya con guardias certificados."
  canonical="https://seguridadeventos.com.mx/zonas/cancun"
  schema={schema}
>

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-dark via-primary to-dark py-16 lg:py-24 border-b border-primary overflow-hidden">
    <div class="absolute top-4 right-4 bg-secondary/15 border border-secondary/30 text-secondary text-xs font-bold px-3 py-1.5 rounded-full">📍 Cancún</div>
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Col 1 -->
        <div>
          <span class="text-secondary text-xs font-bold uppercase tracking-widest">Cobertura local</span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-light mt-3 leading-tight">Seguridad para Eventos en Cancún — Quintana Roo</h1>
          <p class="text-accent text-lg leading-relaxed mt-5 mb-8">Seguridad profesional certificada. Cotización en menos de 24 horas.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/cotizar" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3.5 rounded-lg font-bold uppercase text-sm tracking-wide transition-colors">Cotizar en Cancún</a>
            <a href={"https://wa.me/" + WHATSAPP_NUMBER} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border border-green-500/40 hover:border-green-400 text-light px-7 py-3.5 rounded-lg font-semibold text-sm transition-colors">💬 WhatsApp</a>
          </div>
          <div class="grid grid-cols-2 gap-6 mt-10 pt-8 border-t border-primary">
            {[{val:"50+",label:"Eventos protegidos"},{val:"200+",label:"Guardias disponibles"},{val:"0",label:"Incidentes graves"},{val:"24h",label:"Respuesta cotización"}].map((s:any)=>(
              <div><div class="text-2xl font-black text-secondary">{s.val}</div><div class="text-accent text-xs mt-1">{s.label}</div></div>
            ))}
          </div>
        </div>
        <!-- Col 2: párrafos SEO -->
        <div class="flex flex-col gap-6">
          <div class="bg-primary/60 border border-primary-light rounded-2xl p-7">
            <p class="text-accent leading-relaxed text-sm"><strong class="text-light">SEPRIEV</strong> es la empresa de <strong class="text-light">seguridad privada para eventos en Cancún</strong> y la Riviera Maya con mayor experiencia en el sector hotelero y de destinos turísticos. Cubrimos <strong class="text-light">Centro de Convenciones Cancún, Moon Palace, Xcaret, Hard Rock Hotel, Hyatt Ziva, Grand Fiesta Americana y Nizuc Resort</strong>. Más de <strong class="text-light">200 guardias certificados DGSSP</strong> operando en la Zona Hotelera, Playa del Carmen, Puerto Morelos y Tulum.</p>
          </div>
          <div class="bg-primary/60 border border-primary-light rounded-2xl p-7">
            <p class="text-accent leading-relaxed text-sm">Especializados en <strong class="text-light">bodas destino en resorts de lujo</strong>, congresos internacionales, eventos corporativos de incentivo y <strong class="text-light">festivales de playa en Cancún y Riviera Maya</strong>. Con <strong class="text-light">licencia DGSSP federal</strong> y experiencia coordinando con protocolos de seguridad internacionales de las cadenas hoteleras, somos el proveedor que los organizadores de eventos en el Caribe mexicano confían. <strong class="text-light">Cotización en 24 horas</strong>, más de 50 eventos protegidos sin incidentes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Venues -->
  <section class="py-16 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader eyebrow="Venues y recintos" titulo={"Principales venues en Cancún"} subtitulo="Operamos en los recintos más importantes de la zona. Conocemos cada venue y sus requerimientos." />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <ul class="space-y-3 col-span-1 sm:col-span-2 lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Centro de Convenciones Cancún</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Moon Palace Resort</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Xcaret</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Hard Rock Hotel Cancún</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Hyatt Ziva</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Grand Fiesta Americana</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Nizuc Resort</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Secrets The Vine</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Zonas -->
  <section class="py-16 bg-primary/30 border-y border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader eyebrow="Cobertura" titulo={"Zonas que cubrimos en Cancún"} />
      <div class="flex flex-wrap gap-3 justify-center">
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Zona Hotelera</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Centro de Cancún</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Playa del Carmen</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Riviera Maya</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Puerto Morelos</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Tulum</span>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="py-16 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader eyebrow="Lo que hacemos" titulo={"Servicios destacados en Cancún"} />
      <ul class="space-y-4 max-w-2xl mx-auto">
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Congresos en Centro de Convenciones</span></li>
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Bodas destino en resorts</span></li>
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Eventos corporativos de incentivo</span></li>
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Festivales de playa</span></li>
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Seguridad VIP para celebridades en resorts</span></li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-primary/30 border-y border-primary">
    <div class="w-[90%] mx-auto">
      <h2 class="text-2xl font-black text-light mb-8 text-center">Preguntas Frecuentes — Cancún</h2>
      <div class="space-y-4" id="faq-zona">
        {faq.map((item: {q: string; a: string}) => (
          <div class="bg-primary border border-primary-light rounded-xl overflow-hidden faq-item">
            <button class="w-full text-left flex justify-between items-center gap-4 px-6 py-4 text-light font-semibold text-sm hover:text-secondary transition-colors" aria-expanded="false">
              <span>{item.q}</span>
              <svg class="w-5 h-5 flex-shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5"><p class="text-accent text-sm leading-relaxed">{item.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner titulo={"¿Necesitas seguridad para tu evento en Cancún?"} subtitulo="Cotización personalizada en menos de 24 horas. Sin compromiso." />

</BaseLayout>

<script>
  document.querySelectorAll('.faq-item button').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item?.querySelector('.faq-answer');
      const icon = btn.querySelector('svg');
      const isOpen = !answer?.classList.contains('hidden');
      answer?.classList.toggle('hidden', isOpen);
      icon?.classList.toggle('rotate-180', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
