---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CTABanner from '@/components/CTABanner.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { WHATSAPP_NUMBER, SITE } from '@/lib/config';
import { buildFAQSchema } from '@/lib/seo';

const faq = [
  { q: "¿Cubren todo tipo de eventos en Guadalajara?", a: "Sí, cubrimos conciertos, eventos corporativos, ferias, bodas, eventos deportivos, eventos masivos y más en Guadalajara y su zona metropolitana. Contamos con personal local certificado." },
  { q: "¿Cuántos guardias tienen disponibles en Guadalajara?", a: "Contamos con 300+ guardias certificados disponibles en Guadalajara. Para eventos masivos podemos desplegar equipos desde otras sedes." },
  { q: "¿Tienen licencia para operar en Guadalajara?", a: "Sí, contamos con licencia DGSSP federal que nos autoriza a operar en toda la República Mexicana, incluyendo Guadalajara. Además, cumplimos con los registros locales correspondientes." },
  { q: "¿Cuánto cuesta la seguridad para un evento en Guadalajara?", a: "El costo depende del tipo de evento, aforo, duración y servicios requeridos. Solicita una cotización personalizada y te respondemos en menos de 24 horas con una propuesta detallada." },
];

const schema = buildFAQSchema(faq);
---

<BaseLayout
  title="Seguridad para eventos en Guadalajara | seguridad privada para fiestas | guardias para eventos GDL"
  description="Seguridad para eventos en Guadalajara: SEPRIEV brinda seguridad privada para eventos y fiestas en Guadalajara y Zapopan con guardias certificados."
  canonical="https://seguridadeventos.com/zonas/guadalajara/"
  schema={schema}
>

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-dark via-primary to-dark py-16 lg:py-24 border-b border-primary overflow-hidden">
    <div class="absolute top-4 right-4 bg-secondary/15 border border-secondary/30 text-secondary text-xs font-bold px-3 py-1.5 rounded-full">📍 Guadalajara</div>
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Col 1 -->
        <div>
          <span class="text-secondary text-xs font-bold uppercase tracking-widest">Cobertura local</span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-light mt-3 leading-tight">Seguridad para Eventos en Guadalajara — Jalisco</h1>
          <p class="text-accent text-lg leading-relaxed mt-5 mb-8">Seguridad profesional certificada. Cotización en menos de 24 horas.</p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/cotizar/" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3.5 rounded-lg font-bold uppercase text-sm tracking-wide transition-colors">Cotizar en Guadalajara</a>
            <a href={"https://wa.me/" + WHATSAPP_NUMBER} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border border-green-500/40 hover:border-green-400 text-light px-7 py-3.5 rounded-lg font-semibold text-sm transition-colors">💬 WhatsApp</a>
          </div>
          <div class="grid grid-cols-2 gap-6 mt-10 pt-8 border-t border-primary">
            {[{val:"80+",label:"Eventos protegidos"},{val:"300+",label:"Guardias disponibles"},{val:"0",label:"Incidentes graves"},{val:"24h",label:"Respuesta cotización"}].map((s:any)=>(
              <div><div class="text-2xl font-black text-secondary">{s.val}</div><div class="text-accent text-xs mt-1">{s.label}</div></div>
            ))}
          </div>
        </div>
        <!-- Col 2: párrafos SEO -->
        <div class="flex flex-col gap-6">
          <div class="bg-primary/60 border border-primary-light rounded-2xl p-7">
            <p class="text-accent leading-relaxed text-sm"><strong class="text-light">SEPRIEV</strong> es la empresa de <strong class="text-light">seguridad privada para eventos en Guadalajara</strong> y toda la Zona Metropolitana de Jalisco. Operamos en los recintos más importantes: <strong class="text-light">Expo Guadalajara, Auditorio Telmex, Arena VFG, Teatro Diana, Estadio Akron y Estadio Jalisco</strong>. Nuestros más de <strong class="text-light">300 guardias certificados DGSSP</strong> cubren Guadalajara, Zapopan, Tlaquepaque, Tonalá y toda el área metropolitana.</p>
          </div>
          <div class="bg-primary/60 border border-primary-light rounded-2xl p-7">
            <p class="text-accent leading-relaxed text-sm">Con <strong class="text-light">licencia federal DGSSP vigente</strong> y coordinación directa con Protección Civil Jalisco, garantizamos operaciones de seguridad profesional para conciertos, ferias como la <strong class="text-light">FIL Guadalajara</strong>, eventos corporativos en hoteles y bodas en haciendas de Tlaquepaque. <strong class="text-light">Cotización en 24 horas</strong>, plan operativo personalizado y cero incidentes graves en más de 80 eventos en la Perla de Occidente.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Venues -->
  <section class="py-16 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Venues y recintos"
        titulo={"Principales venues en Guadalajara"}
        lead="Operamos en los recintos más importantes de la zona. Conocemos cada venue y sus requerimientos."
        parrafos={[
          "En Guadalajara operamos en Expo Guadalajara, Auditorio Telmex, Arena VFG, Teatro Diana y los principales hoteles y haciendas de la Zona Metropolitana. Conocemos cada recinto, sus accesos y sus requerimientos operativos.",
          "Nuestro equipo local coordina con autoridades de Jalisco y Protección Civil municipal para eventos como la FIL, conciertos, ferias y bodas. La experiencia en la plaza permite anticipar la logística y desplegar el operativo con la antelación necesaria.",
        ]}
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <ul class="space-y-3 col-span-1 sm:col-span-2 lg:col-span-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Expo Guadalajara</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Auditorio Telmex</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Arena VFG</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Teatro Diana</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Centro de Convenciones Expo Guadalajara</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Estadio Akron</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Estadio Jalisco</li>
            <li class="flex items-center gap-2 text-accent text-sm"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>Terraza Monraz</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Zonas -->
  <section class="py-16 bg-primary/30 border-y border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Cobertura"
        titulo={"Zonas que cubrimos en Guadalajara"}
        lead="Desplegamos operativos en toda la ciudad y su zona metropolitana, con personal local."
        parrafos={[
          "Contamos con elementos que conocen Guadalajara y su área metropolitana —vialidades, tiempos de traslado y las autoridades de cada demarcación—, lo que agiliza la coordinación previa a cada evento.",
          "Así respondemos con rapidez y cumplimos los protocolos locales en cualquier punto de la ciudad, sin subcontratar ni improvisar la operación.",
        ]}
      />
      <div class="flex flex-wrap gap-3 justify-center">
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Guadalajara Centro</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Zapopan</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Tlaquepaque</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Tonalá</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">Tlajomulco</span>
            <span class="bg-primary border border-primary-light px-3 py-1.5 rounded-full text-accent text-xs">El Salto</span>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="py-16 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Lo que hacemos"
        titulo={"Servicios destacados en Guadalajara"}
        lead="Los servicios de seguridad para eventos más solicitados por organizadores en Guadalajara."
        parrafos={[
          "Cubrimos conciertos y festivales, eventos corporativos, ferias y exposiciones, eventos sociales, deportivos y protección VIP, con el mismo estándar documentado en cada operativo.",
          "Cada servicio se dimensiona según el aforo, el recinto y el perfil del evento, con plan de seguridad específico, personal certificado DGSSP y STPS y coordinación con Protección Civil.",
        ]}
      />
      <ul class="space-y-4 max-w-2xl mx-auto">
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Ferias en Expo Guadalajara</span></li>
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Conciertos en Auditorio Telmex</span></li>
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Eventos corporativos en hoteles</span></li>
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>FIL — Feria Internacional del Libro</span></li>
          <li class="flex items-start gap-3 text-accent"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0 mt-0.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>Bodas en haciendas de Tlaquepaque</span></li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-primary/30 border-y border-primary">
    <div class="w-[90%] mx-auto">
      <h2 class="text-2xl font-black text-light mb-8 text-center">Preguntas Frecuentes — Guadalajara</h2>
      <div class="space-y-4" id="faq-zona">
        {faq.map((item: {q: string; a: string}) => (
          <div class="bg-primary border border-primary-light rounded-xl overflow-hidden faq-item">
            <button class="w-full text-left flex justify-between items-center gap-4 px-6 py-4 text-light font-semibold text-sm hover:text-secondary transition-colors" aria-expanded="false">
              <span>{item.q}</span>
              <svg class="w-5 h-5 flex-shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-answer hidden px-6 pb-5"><p class="text-accent text-sm leading-relaxed">{item.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner titulo={"¿Necesitas seguridad para tu evento en Guadalajara?"} subtitulo="Cotización personalizada en menos de 24 horas. Sin compromiso." />

</BaseLayout>

<script>
  document.querySelectorAll('.faq-item button').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item?.querySelector('.faq-answer');
      const icon = btn.querySelector('svg');
      const isOpen = !answer?.classList.contains('hidden');
      answer?.classList.toggle('hidden', isOpen);
      icon?.classList.toggle('rotate-180', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
