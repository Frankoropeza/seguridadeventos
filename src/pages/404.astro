---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe.">
  <section class="min-h-screen flex items-center justify-center bg-dark">
    <div class="text-center px-4">
      <div class="text-8xl sm:text-9xl font-black text-secondary/20 mb-4">404</div>
      <h1 class="text-2xl sm:text-3xl font-bold text-light mb-4">Zona restringida</h1>
      <p class="text-accent mb-8 max-w-md mx-auto">
        La página que buscas no existe o ha sido reubicada. Nuestro equipo de seguridad te redirige al inicio.
      </p>
      <a
        href="/"
        class="bg-secondary hover:bg-red-700 text-light px-6 py-3 rounded-lg font-semibold uppercase tracking-wider transition-colors"
      >
        Volver al inicio
      </a>
    </div>
  </section>
</BaseLayout>
