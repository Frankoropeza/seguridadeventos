---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHero from '@/components/PageHero.astro';
import PageNav from '@/components/PageNav.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import TrustSection from '@/components/TrustSection.astro';
import TestimonialsSection from '@/components/TestimonialsSection.astro';
import CTABanner from '@/components/CTABanner.astro';
import { WHATSAPP_NUMBER, SITE } from '@/lib/config';
import { buildServiceSchema, buildFAQSchema } from '@/lib/seo';

const slug = 'seguridad-conciertos-festivales';
const titulo = 'Seguridad para Conciertos y Festivales en México';
const descripcion = 'Servicio especializado de seguridad privada para conciertos, festivales de música y eventos masivos en México. Personal certificado DGSSP, control de multitudes y protocolos de emergencia.';
const metaTitle = "Seguridad para conciertos | seguridad para festivales | seguridad para eventos masivos";
const metaDescription = "Seguridad para conciertos y festivales: SEPRIEV ofrece seguridad privada para conciertos, festivales y eventos masivos en México con guardias certificados.";
const canonical = `${SITE}/servicios/${slug}`;

const IMG = '/img/eventos';
const ogImg = new URL(`${IMG}/seguridad-conciertos-festivales-1200.jpg`, SITE).toString();

const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola, necesito seguridad para mi concierto o festival')}`;

// FAQ específica de conciertos (preservada del template anterior)
const faq = [
  { q: "¿Cuántos guardias necesito para un concierto de 5,000 personas?", a: "Para un concierto de 5,000 personas recomendamos entre 30 y 60 elementos, dependiendo del venue, tipo de música, y si hay zonas VIP o pit. Incluimos supervisores de zona y equipo de respuesta rápida." },
  { q: "¿Trabajan con artistas internacionales?", a: "Sí, tenemos experiencia coordinando seguridad con riders técnicos de artistas internacionales. Nuestro personal clave es bilingüe y conoce los protocolos de seguridad estándar de la industria musical." },
  { q: "¿Incluyen coordinación con Protección Civil?", a: "Absolutamente. Para cualquier concierto tramitamos y coordinamos con Protección Civil, bomberos y servicios de emergencia. El plan de contingencia está incluido en nuestro servicio." },
  { q: "¿Qué pasa si hay un incidente grave durante el concierto?", a: "Contamos con protocolos de emergencia probados que incluyen evacuación parcial/total, comunicación de crisis, coordinación con servicios de emergencia y cadena de mando clara. Nuestro equipo está entrenado para actuar en segundos." },
];

const schemas = [
  buildServiceSchema(titulo, descripcion, canonical),
  buildFAQSchema(faq),
];

const navItems = [
  { label: "Eventos Masivos", desc: "Operativos de +10,000 asistentes con centro de comando", href: "/servicios/seguridad-masivos" },
  { label: "Control de Acceso", desc: "Filtros, detección de objetos y aforo en tiempo real", href: "/servicios/control-acceso-eventos" },
  { label: "Seguridad VIP", desc: "Protección de artistas, backstage y zonas restringidas", href: "/servicios/seguridad-vip" },
  { label: "Solicitar Cotización", desc: "Propuesta personalizada en menos de 24 horas", href: "/cotizar" },
];

// Módulos detallados (mismo layout que index/servicios: texto izq + galería der)
const modules = [
  {
    eyebrow: "Servicio especializado",
    badge: "Popular",
    title: "Operativo integral para la industria musical",
    intro: "SEPRIEV lleva más de 200 eventos musicales operados en México, desde foros íntimos con 500 personas hasta festivales de aforo superior a 80,000 asistentes. Cada operativo arranca con un análisis de riesgo específico para el recinto, el cartel artístico y el perfil de la afición esperada, porque no existe una sola fórmula válida para todos los conciertos. Lo que sí existe es un equipo entrenado para anticipar lo que puede salir mal antes de que ocurra.",
    features: [
      { title: "Control de multitudes", text: "Los flujos de entrada y salida se diseñan antes del día del evento, no se improvisan cuando el público ya está afuera. SEPRIEV define puntos de acceso, velocidades de ingreso y zonas de amortiguamiento entre sectores, y entrena al personal para reconocer señales tempranas de compresión de multitudes o tensión entre aficionados. Actuar en los primeros segundos es la diferencia entre una situación controlada y un incidente con consecuencias." },
      { title: "Backstage seguro", text: "El acceso a camerinos, plataformas técnicas y zonas de producción se regula mediante credencialización por niveles: cada persona entra solo a donde su función lo justifica. Los proveedores externos son verificados en cada acceso, no solo al inicio de la jornada, porque las fases de montaje y desmontaje concentran el mayor riesgo de extravío de equipo y de presencia no autorizada en áreas sensibles." },
      { title: "Coordinación institucional", text: "Policía, Protección Civil, Bomberos y servicios médicos de emergencia no son actores externos al operativo: son parte del mismo. SEPRIEV establece antes del evento un canal de radio exclusivo, un puesto de mando unificado y un protocolo de escalamiento con roles definidos para cada institución, de modo que la respuesta coordinada ya esté ensayada y no dependa de decisiones improvisadas." },
    ],
    hero: `${IMG}/seguridad-conciertos-festivales`,
    small1: `${IMG}/seguridad-conciertos-multitud`,
    small2: `${IMG}/personal-seguridad-evento`,
    featured: false,
  },
  {
    eyebrow: "Qué incluye el servicio",
    badge: undefined,
    title: "Plan de seguridad documentado, de principio a fin",
    intro: "Cada concierto o festival se opera sobre un plan de seguridad formal que define posiciones, funciones, horarios y protocolos de contingencia. Ese documento se comparte con el organizador y la autoridad como base única de la operación y sustenta el evento ante Protección Civil y la aseguradora. SEPRIEV no improvisa el día del evento: ejecuta un plan validado con anticipación y lo respalda con evidencia de campo.",
    features: [
      { title: "Análisis previo del venue", text: "Antes del evento, el equipo de operaciones visita el recinto para evaluar capacidad y aforo máximo autorizado, rutas de evacuación y puntos de reunión, zonas de riesgo potencial —pit, escenarios, accesos— e infraestructura de seguridad existente (CCTV, barreras, iluminación). De esa evaluación se deriva el plan operativo específico del evento." },
      { title: "Personal operativo especializado", text: "Desplegamos perfiles según las necesidades del evento: guardias de control de acceso, equipo de pit y escenario para protección de artistas y manejo de crowd surge, seguridad perimetral, supervisores de zona con toma de decisiones en tiempo real y personal VIP y backstage para acceso restringido. Cada perfil está entrenado específicamente para su rol, no reasignado de otra posición." },
      { title: "Protocolos de emergencia", text: "Cada evento cuenta con un Plan de Contingencia documentado: protocolo de evacuación parcial y total, coordinación con Cruz Roja, bomberos y policía, plan de comunicación de crisis, procedimientos ante amenaza de bomba, incendio o desastre natural, y una cadena de mando con responsabilidades claras para cada miembro del equipo." },
    ],
    hero: `${IMG}/centro-control-seguridad`,
    small1: `${IMG}/guardias-seguridad-privada`,
    small2: `${IMG}/control-acceso-eventos`,
    featured: true,
  },
];

// Tipos de eventos que cubrimos
const tipos = [
  { titulo: "Conciertos en arena", aforo: "5,000 – 20,000 personas" },
  { titulo: "Festivales al aire libre", aforo: "10,000 – 100,000+ asistentes" },
  { titulo: "Conciertos en foros y teatros", aforo: "500 – 5,000 personas" },
  { titulo: "Conciertos estadio", aforo: "20,000 – 65,000+ asistentes" },
  { titulo: "Festivales gastronómicos y culturales", aforo: "Aforo variable por jornada" },
  { titulo: "Música electrónica y raves autorizadas", aforo: "Eventos con permisos vigentes" },
];

// Diferenciadores
const razones = [
  { titulo: "Experiencia demostrable", desc: "Más de 200 conciertos y festivales protegidos en toda la República, sin incidentes graves." },
  { titulo: "Licencia DGSSP vigente", desc: "Operamos con todos los permisos federales y locales que la autoridad exige para autorizar el evento." },
  { titulo: "Personal certificado STPS", desc: "Cada guardia cuenta con capacitación verificable y registro vigente, dentro de un sistema alineado a ISO 9001." },
  { titulo: "Tecnología de apoyo", desc: "Radios digitales en múltiples canales, CCTV móvil y drones de vigilancia aérea cuando el evento lo requiere." },
  { titulo: "Seguros de responsabilidad civil", desc: "Cobertura completa para el organizador, ajustada al aforo del evento, con copia de póliza incluida." },
];

// Otros servicios relacionados (ServiceCards homologadas con servicios/index)
const relacionados = [
  { title: "Eventos Masivos", description: "Dirección de seguridad a escala de +10,000 asistentes con centro de comando, vigilancia aérea y mando unificado con autoridades.", features: ["Centro de comando", "Vigilancia aérea", "Mando unificado"], href: "/servicios/seguridad-masivos", image: `${IMG}/guardias-seguridad-privada`, badge: "Destacado", featured: true },
  { title: "Control de Acceso", description: "Verificación de boletos, detección de objetos prohibidos, gestión de aforo y credencialización para cualquier escala de evento.", features: ["Detección de metales", "Escaneo QR", "Aforo en tiempo real"], href: "/servicios/control-acceso-eventos", image: `${IMG}/control-acceso-eventos`, badge: "Esencial" },
  { title: "Seguridad VIP", description: "Escoltas certificados en protección personal para artistas y celebridades, con avanzada de seguridad y bajo perfil.", features: ["Close protection", "Anti-paparazzi", "Rutas seguras"], href: "/servicios/seguridad-vip", image: `${IMG}/seguridad-vip-eventos` },
  { title: "Montaje y Desmontaje", description: "Custodia 24/7 del recinto, acreditación de proveedores e inventario fotográfico de activos durante todo el ciclo del evento.", features: ["Custodia 24/7", "Control de proveedores", "Inventario fotográfico"], href: "/servicios/seguridad-montaje-desmontaje", image: `${IMG}/equipo-seguridad-eventos` },
];
---

<BaseLayout title={metaTitle} description={metaDescription} canonical={canonical} ogImage={ogImg} schema={schemas}>

  <Breadcrumb items={[{ label: 'Servicios', href: '/servicios' }, { label: 'Conciertos y Festivales' }]} />

  <PageHero
    eyebrow="SEPRIEV — Conciertos y Festivales"
    titulo="Seguridad para Conciertos y Festivales"
    subtitulo="Operativos dimensionados por aforo y respaldados con una carpeta de seguridad ante la autoridad, de foros íntimos a festivales de más de 80,000 asistentes."
  >
    <Fragment slot="right">
      <p class="text-accent text-base leading-relaxed">
        Los conciertos y festivales son uno de los <strong class="text-light font-semibold">escenarios más complejos en seguridad privada</strong>: miles de personas concentradas, accesos múltiples, áreas VIP, backstage y logística de artistas que exigen un plan integral. <strong class="text-light font-semibold">SEPRIEV</strong> ha protegido más de <strong class="text-light font-semibold">200 conciertos y festivales</strong> en toda la República, con personal entrenado en control de multitudes, evacuación de emergencia y coordinación con autoridades.
      </p>
      <p class="text-accent text-base leading-relaxed">
        Todo el personal cuenta con <strong class="text-light font-semibold">licencia DGSSP y certificación STPS</strong>, y operamos en CDMX, Guadalajara, Monterrey, Puebla y Cancún con cobertura en todo el país. Cotización gratuita y propuesta en menos de 24 horas.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 pt-1">
        <a href="/cotizar" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
          Cotizar este servicio
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border border-white/20 hover:border-white/40 text-accent hover:text-light px-7 py-3 text-sm font-semibold transition-colors">
          Consultar por WhatsApp
        </a>
      </div>
    </Fragment>
  </PageHero>

  <PageNav items={navItems} ariaLabel="Servicios relacionados" />

  <!-- Módulos detallados del servicio -->
  <section class="py-20 bg-dark" id="servicio">
    <div class="w-full px-[5%] xl:px-[7%]">

      <!-- Encabezado de dos columnas -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-4 pb-2 lg:items-stretch">
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Cómo operamos un concierto</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-3">
            Seguridad especializada para la industria musical
          </h2>
          <p class="text-accent text-base leading-relaxed">
            La diferencia entre un concierto seguro y uno expuesto se decide en la planeación, no en la ejecución. Cada evento musical es un proyecto de seguridad con metodología propia.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            Abordamos cada evento con un proceso documentado: diagnóstico del recinto, dimensionamiento por aforo y entrega de una <strong class="text-light font-semibold">carpeta de seguridad</strong> que sustenta el evento ante la autoridad y la aseguradora. Con más de <strong class="text-light font-semibold">200 eventos musicales operados</strong> y licencia federal vigente, nuestro estándar no depende de la escala del cartel.
          </p>
          <p class="text-accent text-sm leading-relaxed">
            De los foros de 500 personas a los festivales de más de 80,000 asistentes, el mismo proceso se repite con idéntica rigurosidad en cada producción, incluidos relevos escalonados para festivales multi-jornada y un <strong class="text-light font-semibold">informe posterior al evento</strong> con incidencias y recomendaciones.
          </p>
        </div>
      </div>

      <!-- Módulos imagen + texto -->
      {modules.map((m) => (
        <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 mt-20 pt-16 border-t ${m.featured ? 'border-secondary/30' : 'border-white/8'}`}>

          <!-- Columna izquierda: texto -->
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-secondary text-xs font-bold uppercase tracking-widest">{m.eyebrow}</span>
              {m.badge && (
                <span class="bg-secondary text-white text-[10px] font-black uppercase tracking-widest px-2 py-0.5">{m.badge}</span>
              )}
            </div>
            <div class="w-8 h-0.5 bg-secondary mb-3"></div>
            <h3 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-4">{m.title}</h3>

            <p class="text-light/80 text-base leading-relaxed mb-5">{m.intro}</p>

            <ul class="flex flex-col gap-5 mb-6">
              {m.features.map((f) => (
                <li class="flex flex-col gap-1.5">
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                    <span class="text-light text-base font-semibold">{f.title}</span>
                  </div>
                  <p class="text-light/70 text-sm leading-relaxed pl-4">{f.text}</p>
                </li>
              ))}
            </ul>

            <div class="flex flex-col sm:flex-row gap-4 mt-auto">
              <a href="/cotizar" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
                Cotizar este servicio
              </a>
              <a href={waHref} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border border-white/20 hover:border-white/40 text-accent hover:text-light px-7 py-3 text-sm font-semibold transition-colors">
                Consultar por WhatsApp
              </a>
            </div>
          </div>

          <!-- Columna derecha: galería 1 grande + 2 pequeñas -->
          <div class="flex flex-col gap-4">
            <div class="relative w-full aspect-[16/9] overflow-hidden bg-primary">
              <picture>
                <source type="image/avif" srcset={`${m.hero}-640.avif 640w, ${m.hero}-1200.avif 1200w`} sizes="(max-width: 1024px) 100vw, 600px" />
                <source type="image/jpeg" srcset={`${m.hero}-640.jpg 640w, ${m.hero}-1200.jpg 1200w`} sizes="(max-width: 1024px) 100vw, 600px" />
                <img src={`${m.hero}-1200.jpg`} alt={`${m.title} — seguridad para conciertos y festivales SEPRIEV`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="1200" height="675" />
              </picture>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
                <picture>
                  <source type="image/avif" srcset={`${m.small1}-640.avif`} />
                  <img src={`${m.small1}-640.jpg`} alt={`${m.title} — SEPRIEV`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
                </picture>
              </div>
              <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
                <picture>
                  <source type="image/avif" srcset={`${m.small2}-640.avif`} />
                  <img src={`${m.small2}-640.jpg`} alt={`${m.title} — SEPRIEV`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
                </picture>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Tipos de eventos que cubrimos -->
  <section class="py-20 bg-dark border-t border-white/8">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-10 pb-10 border-b border-white/8 lg:items-center">
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Cobertura por formato</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight">Tipos de eventos que cubrimos</h2>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            Dimensionamos el operativo según el formato y el aforo de cada evento musical. No aplicamos el mismo esquema a un foro íntimo que a un festival multitudinario: cada escala tiene su propio plan de seguridad, número de elementos y nivel de coordinación institucional.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tipos.map((t) => (
          <div class="flex flex-col gap-2 px-6 py-7 bg-primary border border-white/8">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-secondary/70" aria-hidden="true">
              <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
            </svg>
            <span class="text-light font-bold text-base leading-snug mt-1">{t.titulo}</span>
            <span class="text-accent text-sm">{t.aforo}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por qué SEPRIEV -->
  <section class="py-20 bg-primary/30 border-t border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-10 pb-10 border-b border-white/8 lg:items-center">
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Por qué elegirnos</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight">¿Por qué SEPRIEV para tu concierto?</h2>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            "La seguridad no es un gasto, es una inversión que protege tu reputación como organizador y la vida de tus asistentes." Cada operativo se respalda con experiencia verificable, cumplimiento normativo y la tecnología necesaria para anticipar, no solo reaccionar.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {razones.map((r) => (
          <div class="flex flex-col bg-dark border border-primary-light rounded-xl p-6">
            <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-secondary/15 border border-secondary/30 mb-4">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-secondary" aria-hidden="true">
                <path d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <h3 class="text-light font-bold text-base mb-2">{r.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProcessSection titulo="Así protegemos tu concierto" />

  <TrustSection />

  <TestimonialsSection />

  <!-- Otros servicios -->
  <section class="py-20 bg-dark border-t border-white/8">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-10 pb-10 border-b border-white/8 lg:items-center">
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Servicios complementarios</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight">Otros servicios para tu evento</h2>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            Un concierto rara vez necesita un solo servicio. Combinamos control de acceso, protección VIP, custodia de montaje y dirección de eventos masivos en un operativo único, con un solo interlocutor responsable de toda la operación.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {relacionados.map((s) => (
          <ServiceCard
            title={s.title}
            description={s.description}
            features={s.features}
            href={s.href}
            image={s.image}
            badge={s.badge}
            featured={s.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    titulo="¿Necesitas seguridad para tu concierto o festival?"
    subtitulo="Cuéntanos sobre tu evento y recibe una propuesta personalizada en menos de 24 horas. Sin compromiso."
    faq={faq}
  />

</BaseLayout>
