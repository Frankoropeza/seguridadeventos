---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import TrustBadges from '@components/TrustBadges.astro';

const title = "Control de Acceso para Eventos en Mexico";
const description = "Servicio de control de acceso para eventos con verificacion de boletos, gestion de credenciales, sistemas biometricos y conteo de aforo en tiempo real.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Que sistemas de control de acceso utilizan para eventos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Utilizamos tecnologia de escaneo de codigos QR y de barras, lectores de credenciales RFID, sistemas biometricos de huella digital y reconocimiento facial cuando el evento lo requiere, y plataformas digitales de conteo de aforo en tiempo real integradas con la boleteria del evento."
      }
    },
    {
      "@type": "Question",
      "name": "¿Como se realiza la deteccion de objetos prohibidos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Implementamos detectores de metales de arco y portatiles, revision manual de bolsos y mochilas por personal capacitado, y listas de objetos restringidos adaptadas al tipo de evento. Todo el proceso esta diseñado para ser agil y respetuoso con los asistentes."
      }
    },
    {
      "@type": "Question",
      "name": "¿Pueden integrarse con nuestro sistema de boleteria?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, nos integramos con los principales sistemas de boleteria como Ticketmaster, Boletia, Eventbrite y plataformas propias del cliente. Coordinamos con el equipo tecnico para asegurar que la verificacion de boletos sea fluida y sin errores."
      }
    },
    {
      "@type": "Question",
      "name": "¿Como controlan el aforo del evento en tiempo real?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Utilizamos contadores digitales en cada punto de acceso que se sincronizan en un dashboard central. Esto permite monitorear la ocupacion del recinto en tiempo real, activar alertas cuando se acerca al limite permitido y cerrar accesos de forma coordinada si es necesario."
      }
    },
    {
      "@type": "Question",
      "name": "¿Manejan credenciales por zonas o categorias?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, diseñamos sistemas de credenciales multinivel que pueden incluir acceso general, VIP, backstage, prensa, staff y cualquier otra categoria que requiera el evento. Cada credencial tiene permisos especificos que nuestro personal verifica en los puntos de control correspondientes."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Control de acceso</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
          Control de Acceso <span class="text-secondary">para Eventos</span>
        </h1>
        <p class="text-accent text-lg sm:text-xl leading-relaxed max-w-3xl">
          Gestionamos el control de acceso para eventos de cualquier tamano con tecnologia de verificacion de boletos, gestion de credenciales multinivel, sistemas biometricos y conteo de aforo en tiempo real. Nuestro equipo esta entrenado en deteccion de objetos prohibidos, manejo de filas y atencion al publico para que el ingreso al evento sea seguro, agil y organizado. Cada punto de acceso se diseña estrategicamente para maximizar el flujo de personas sin comprometer la seguridad del recinto ni la experiencia de los asistentes.
        </p>
      </div>
    </div>
  </section>

  <!-- En que consiste -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-black text-light mb-8">¿En que consiste el control de acceso para eventos?</h2>
        <div class="prose prose-lg text-accent leading-relaxed space-y-4">
          <p>
            El control de acceso es la primera linea de defensa en cualquier evento. Nuestro servicio abarca desde la planificacion de los puntos de ingreso hasta la gestion integral del flujo de personas durante todo el evento. Evaluamos las caracteristicas del recinto, el numero esperado de asistentes y el tipo de evento para diseñar un sistema de acceso que sea tanto seguro como eficiente.
          </p>
          <p>
            Implementamos tecnologia de verificacion de boletos compatible con los principales sistemas de boleteria del mercado. Nuestros operadores utilizan escaneadores de codigos QR y de barras de alta velocidad que validan la autenticidad de cada boleto en segundos, evitando falsificaciones y duplicados. Para eventos con multiples categorias de acceso, diseñamos sistemas de credenciales con codificacion por color, RFID o codigo de barras que permiten controlar el ingreso a diferentes zonas.
          </p>
          <p>
            La deteccion de objetos prohibidos es una parte fundamental de nuestro servicio. Desplegamos arcos detectores de metales en los accesos principales y equipamos a nuestro personal con detectores portatiles para inspecciones complementarias. Todo el equipo esta capacitado en tecnicas de revision de pertenencias que son efectivas pero respetuosas, minimizando los tiempos de espera sin comprometer la seguridad.
          </p>
          <p>
            Nuestro sistema de conteo de aforo en tiempo real permite monitorear la ocupacion del recinto desde un centro de mando. Cada persona que ingresa o sale es registrada digitalmente, lo que permite tomar decisiones informadas sobre apertura o cierre de accesos, activacion de rutas alternas y cumplimiento de las normas de proteccion civil sobre capacidad maxima permitida.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Beneficios principales</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
        {[
          "Verificacion digital de boletos compatible con sistemas de boleteria",
          "Deteccion de objetos prohibidos con arcos y detectores portatiles",
          "Conteo de aforo en tiempo real con dashboard de monitoreo central",
          "Credenciales multinivel para gestion de zonas y categorias de acceso",
          "Personal capacitado en atencion al publico y manejo de filas",
          "Integracion con sistemas biometricos para eventos de alta seguridad"
        ].map((beneficio) => (
          <li class="flex items-start gap-3 bg-primary/30 border border-primary-light/30 rounded-lg p-4">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-accent text-sm leading-relaxed">{beneficio}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipos de eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Para que tipo de eventos?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Conciertos y festivales", ejemplo: "Alto flujo de ingreso con verificacion de boletos y deteccion de objetos prohibidos." },
          { titulo: "Congresos y convenciones", ejemplo: "Credenciales por categoria con acceso diferenciado a salas y areas." },
          { titulo: "Eventos deportivos", ejemplo: "Control de aforo por sectores con monitoreo en tiempo real." },
          { titulo: "Exposiciones y ferias", ejemplo: "Acceso por dias con verificacion de pases de exhibidor y visitante." },
          { titulo: "Eventos corporativos privados", ejemplo: "Listas de invitados exclusivas con verificacion de identidad." },
          { titulo: "Eventos gubernamentales", ejemplo: "Control biometrico y protocolos de seguridad de alto nivel." }
        ].map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/30 rounded-lg p-5">
            <h3 class="text-light font-bold text-base mb-2">{tipo.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.ejemplo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Nuestro proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        {[
          { paso: "01", titulo: "Analisis del recinto", desc: "Evaluamos puntos de acceso, capacidad del venue y flujos esperados para diseñar la distribucion optima de controles." },
          { paso: "02", titulo: "Configuracion tecnologica", desc: "Instalamos escaneadores, detectores y sistemas de conteo. Integramos con la plataforma de boleteria del evento." },
          { paso: "03", titulo: "Operacion en tiempo real", desc: "Gestionamos cada punto de acceso con personal capacitado y monitoreo centralizado del aforo y flujo de personas." },
          { paso: "04", titulo: "Reporte de aforo", desc: "Entregamos estadisticas de ingreso, horarios pico, incidencias de acceso y recomendaciones de mejora." }
        ].map((item) => (
          <div class="relative bg-primary/30 border border-primary-light/30 rounded-lg p-6">
            <span class="text-secondary font-black text-3xl opacity-30">{item.paso}</span>
            <h3 class="text-light font-bold text-base mt-2 mb-2">{item.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por que elegirnos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Por que elegir SeguridadEventos?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Tecnologia de punta", desc: "Escaneadores de alta velocidad, contadores digitales y dashboards de monitoreo para un control preciso y eficiente." },
          { titulo: "Integracion flexible", desc: "Compatibilidad con Ticketmaster, Boletia, Eventbrite y sistemas de boleteria propios del organizador." },
          { titulo: "Personal capacitado", desc: "Operadores entrenados en atencion al publico, manejo de filas y resolucion de conflictos en puntos de acceso." }
        ].map((dif) => (
          <div class="bg-primary/30 border border-secondary/20 rounded-lg p-6">
            <h3 class="text-light font-bold text-base mb-3">{dif.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{dif.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Preguntas frecuentes sobre control de acceso</h2>
      <div class="max-w-3xl space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-primary/30 border border-primary-light/30 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-light font-semibold text-sm sm:text-base">
              {faq.name}
              <svg class="w-5 h-5 text-secondary flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-accent text-sm leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner titulo="¿Necesitas control de acceso para tu evento?" subtitulo="Cotizacion personalizada en menos de 24 horas. Sin compromiso." />
</BaseLayout>
