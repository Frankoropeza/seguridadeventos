---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHero from '@/components/PageHero.astro';
import PageNav from '@/components/PageNav.astro';
import StatsSection from '@/components/StatsSection.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import CTABanner from '@/components/CTABanner.astro';
import { WHATSAPP_NUMBER, SITE } from '@/lib/config';
import { buildServicePageSchema } from '@/lib/seo';

const slug = 'control-acceso-eventos';

// H1 / nombre del servicio para schema
const titulo = 'Control de Acceso para Eventos en México';
const descripcion = 'Servicio profesional de control de acceso para eventos en México: integración con boletaje, validación QR/NFC en tiempo real, detección de objetos prohibidos, credencialización por niveles y reporte de aforo conciliado. Personal certificado DGSSP y STPS.';

// SEO meta (limpio, orientado a intención de búsqueda)
const metaTitle = 'Control de Acceso para Eventos en México | SEPRIEV';
const metaDescription = 'Control de acceso para eventos en México: validación de boletos (QR/NFC), detección de metales, credencialización y aforo en tiempo real. Hasta 1,200 ingresos/hora por punto. Licencia DGSSP.';

const canonical = `${SITE}/servicios/${slug}`;

const IMG = '/img/eventos';
const ogImg = new URL(`${IMG}/control-acceso-eventos-1200.jpg`, SITE).toString();

const waHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola, necesito control de acceso para mi evento')}`;

// FAQ específica de control de acceso (ampliada para cobertura de búsqueda)
const faq = [
  { q: "¿Cuántas personas pueden procesar por hora?", a: "Con nuestro sistema optimizado procesamos hasta 1,200 personas por hora por punto de acceso, con una verificación y revisión de menos de 30 segundos por persona. El rendimiento real depende del nivel de revisión definido en el plan de seguridad y del número de carriles habilitados." },
  { q: "¿Cuántos elementos de control de acceso necesita mi evento?", a: "Como referencia: hasta 500 asistentes, 4-6 elementos; de 500 a 2,000, 8-15; de 2,000 a 5,000, 15-30; de 5,000 a 15,000, 30-60; y para más de 15,000 elaboramos una cotización especial. El número final depende del número de puntos de acceso, el aforo por hora y el nivel de revisión." },
  { q: "¿Tienen sus propios arcos detectores de metales?", a: "Sí. Contamos con equipo propio: arcos detectores de metales portátiles, detectores manuales (wand) y equipos de inspección. No rentamos equipo, lo que garantiza que siempre esté en óptimas condiciones y configurado según el perfil de riesgo de tu evento." },
  { q: "¿Pueden integrar su sistema con mi plataforma de boletos?", a: "Trabajamos con las principales plataformas de boletaje —Ticketmaster, Boletia, Eventbrite y sistemas propios— y nuestros lectores de QR, código de barras y NFC son compatibles con la mayoría de formatos estándar. Realizamos pruebas de compatibilidad en sitio antes del evento." },
  { q: "¿Qué pasa si se cae el internet o el sistema de boletos?", a: "Activamos un protocolo de contingencia de validación manual con listas y verificación por lote, de modo que una caída de conectividad no detenga el ingreso ni comprometa el control. Los datos se reconcilian en cuanto el sistema se restablece." },
  { q: "¿Cuentan con personal femenino para la revisión de mujeres?", a: "Sí. Asignamos personal femenino para la revisión de asistentes mujeres en cada punto de acceso, con un protocolo de trato respetuoso y una revisión proporcional al perfil de riesgo del evento, capacitado para resolver inconformidades sin escalar el tono." },
  { q: "¿El acceso es accesible para personas con discapacidad?", a: "Sí. Habilitamos carriles de acceso preferente para personas con discapacidad, adultos mayores y mujeres embarazadas, coordinados con el organizador para cumplir con los requisitos de accesibilidad del recinto." },
  { q: "¿Ofrecen detección K-9 antiexplosivos o reconocimiento facial?", a: "Sí, bajo solicitud. Podemos incorporar unidades caninas (K-9) antiexplosivos para revisión previa del recinto y, en eventos premium, sistemas de reconocimiento facial integrados al control de acceso, según los requerimientos del organizador y la normativa aplicable." },
];

// Schema Service enriquecido + FAQPage

const schemas = buildServicePageSchema({
  slug,
  name: titulo,
  description: descripcion,
  metaTitle,
  metaDescription,
  serviceType: "Control de acceso para eventos",
  ogImage: ogImg,
  breadcrumbName: "Control de Acceso",
  offers: [
    "Validación de boletos QR/NFC",
    "Detección de metales y revisión de objetos",
    "Credencialización por niveles",
    "Gestión y reporte de aforo en tiempo real",
  ],
  faq,
  datePublished: "2025-01-25",
});

const navItems = [
  { label: "Conciertos y Festivales", desc: "Control de multitudes y accesos por sector", href: "/servicios/seguridad-conciertos-festivales" },
  { label: "Eventos Masivos", desc: "Operativos de +10,000 asistentes con centro de comando", href: "/servicios/seguridad-masivos" },
  { label: "Eventos Corporativos", desc: "Registro ejecutivo y credencialización", href: "/servicios/seguridad-eventos-corporativos" },
  { label: "Solicitar Cotización", desc: "Propuesta personalizada en menos de 24 horas", href: "/cotizar" },
];

// Módulos detallados (mismo layout que index/servicios: texto izq + galería der)
const modules = [
  {
    eyebrow: "Servicio especializado",
    badge: "Esencial",
    title: "El acceso como sistema de flujo y datos",
    intro: "El control de acceso es el proceso por el que pasa el cien por ciento de los asistentes y, por tanto, el de mayor impacto en la experiencia y en la seguridad del evento. SEPRIEV lo opera como un sistema de flujo y datos: integración con el boletaje del cliente, trazabilidad de cada ingreso y revisión proporcional al riesgo. Un acceso bien gestionado reduce filas, previene fraudes y deja un registro auditable del evento, todo en el mismo movimiento.",
    features: [
      { title: "Integración con el sistema de boletaje", text: "Coordinamos con la plataforma de ticketing del cliente para validar en tiempo real, detectar duplicados o falsificaciones y asegurar la compatibilidad de los lectores, con pruebas previas en sitio. Se define además un protocolo de contingencia para validación manual ante fallas de conectividad, de manera que una caída de red no detenga el ingreso ni comprometa el control." },
      { title: "Trazabilidad y reporte de aforo", text: "Cada acceso se registra con hora y punto de entrada, lo que permite conocer el aforo en tiempo real durante la operación y entregar al cierre un reporte conciliado al organizador. Esa trazabilidad sostiene tanto la toma de decisiones en vivo como la auditoría posterior frente a la autoridad o la aseguradora." },
      { title: "Revisión proporcional y protocolo de trato", text: "Los filtros se calibran al perfil de riesgo del evento para ser efectivos sin convertirse en cuello de botella, con personal femenino para la revisión de mujeres y un protocolo de trato respetuoso en cada punto. Capacitamos al personal para resolver inconformidades sin escalar el tono, conscientes de que la primera impresión del evento ocurre en la puerta." },
    ],
    hero: `${IMG}/control-acceso-eventos`,
    small1: `${IMG}/control-acceso-credenciales`,
    small2: `${IMG}/personal-seguridad-evento`,
    alt: [
      "Control de acceso y validación de boletos en un evento",
      "Credencialización por niveles de acceso en un evento",
      "Personal de control de acceso en el ingreso de un evento",
    ],
    featured: false,
  },
  {
    eyebrow: "Tecnología y equipo",
    badge: undefined,
    title: "Equipo propio y validación en tiempo real",
    intro: "La velocidad y la seguridad en la puerta dependen del equipo y de quién lo opera. SEPRIEV trabaja con equipo propio —no rentado— y personal entrenado específicamente para el rol de acceso, no reasignado de otras posiciones. La combinación de lectores conectados en tiempo real, detección de objetos y conteo de aforo permite un ingreso ágil sin renunciar al control.",
    features: [
      { title: "Detección de metales y revisión de objetos", text: "Los arcos detectores de metales se complementan con detectores de mano (wand) para revisión secundaria e inspección de bolsos y mochilas. El personal mantiene una cadencia de ingreso alta incluso en picos de demanda, y la sensibilidad de los equipos se ajusta según el tipo de evento y el perfil de riesgo definido en el plan de seguridad. Bajo solicitud, sumamos unidades caninas (K-9) antiexplosivos." },
      { title: "Validación QR, código de barras y NFC", text: "La validación de boletos digitales y físicos se realiza con lectores de alta velocidad conectados en tiempo real a la base de datos del organizador, lo que permite detectar duplicados y boletos falsificados en el momento del ingreso. En eventos premium integramos reconocimiento facial al flujo de acceso, siempre conforme a la normativa aplicable." },
      { title: "Conteo y control de aforo en tiempo real", text: "El número de personas dentro del recinto se monitorea de forma continua con contadores por punto, reportes periódicos al puesto de mando y un esquema de semáforo (verde, amarillo, rojo) con alertas al alcanzar los umbrales de capacidad. Los accesos se abren y cierran de forma coordinada para distribuir el flujo sin detener masivamente el ingreso." },
    ],
    hero: `${IMG}/centro-monitoreo-cctv-eventos`,
    small1: `${IMG}/monitoreo-camaras-evento`,
    small2: `${IMG}/guardias-seguridad-privada`,
    alt: [
      "Centro de monitoreo CCTV para control de aforo en tiempo real",
      "Operador de cámaras vigilando los accesos de un evento",
      "Guardias con detectores de metales en un punto de acceso",
    ],
    featured: true,
  },
];

// Componentes del control de acceso
const tipos = [
  { titulo: "Validación de boletos", nota: "QR, código de barras y NFC en tiempo real" },
  { titulo: "Detección de objetos", nota: "Arcos fijos, detector de mano y revisión de bolsos" },
  { titulo: "Credencialización por niveles", nota: "Pulseras por zona: general, VIP, backstage, prensa" },
  { titulo: "Gestión de aforo", nota: "Conteo en vivo con semáforo y alertas por umbral" },
  { titulo: "Revisión con perspectiva de género", nota: "Personal femenino para la revisión de mujeres" },
  { titulo: "Punto de resguardo", nota: "Custodia y registro de objetos retenidos" },
];

// Diferenciadores
const razones = [
  { titulo: "Equipo propio, no rentado", desc: "Arcos detectores y lectores propios, siempre en óptimas condiciones; no dependemos de proveedores externos." },
  { titulo: "Integración con tu boletaje", desc: "Compatibilidad probada con Ticketmaster, Boletia, Eventbrite y sistemas propios, con pruebas en sitio antes del evento." },
  { titulo: "Alta capacidad de procesamiento", desc: "Hasta 1,200 ingresos por hora por punto de acceso, sin convertir la puerta en un cuello de botella." },
  { titulo: "Trazabilidad y auditoría", desc: "Cada ingreso queda registrado con hora y punto; entregamos un reporte de aforo conciliado al cierre." },
  { titulo: "Protocolo de trato respetuoso", desc: "Revisión proporcional al riesgo, con personal femenino y manejo de inconformidades sin escalar el tono." },
  { titulo: "Plan de contingencia", desc: "Validación manual ante fallas de conectividad para que una caída de red nunca detenga el ingreso." },
];

// Otros servicios relacionados (ServiceCards homologadas con servicios/index)
const relacionados = [
  { title: "Conciertos y Festivales", description: "Control de multitudes, accesos por sector y backstage seguro para eventos musicales de cualquier escala.", features: ["Control de multitudes", "Backstage seguro", "Coordinación institucional"], href: "/servicios/seguridad-conciertos-festivales", image: `${IMG}/seguridad-conciertos-festivales`, badge: "Popular", featured: true },
  { title: "Eventos Masivos", description: "Dirección de seguridad a escala de +10,000 asistentes con centro de comando, vigilancia aérea y mando unificado.", features: ["Centro de comando", "Vigilancia aérea", "Mando unificado"], href: "/servicios/seguridad-masivos", image: `${IMG}/guardias-seguridad-privada`, badge: "Destacado" },
  { title: "Eventos Corporativos", description: "Registro ejecutivo, credencialización por niveles y control de acceso discreto para convenciones y galas.", features: ["Registro ejecutivo", "Credencialización", "Discreción total"], href: "/servicios/seguridad-eventos-corporativos", image: `${IMG}/seguridad-eventos-corporativos` },
  { title: "Montaje y Desmontaje", description: "Acreditación de proveedores, control de andén de carga e inventario fotográfico durante el ciclo del evento.", features: ["Acreditación de proveedores", "Control de carga", "Inventario fotográfico"], href: "/servicios/seguridad-montaje-desmontaje", image: `${IMG}/equipo-seguridad-eventos` },
];
---

<BaseLayout title={metaTitle} description={metaDescription} canonical={canonical} ogImage={ogImg} schema={schemas}>

  <Breadcrumb items={[{ label: 'Servicios', href: '/servicios' }, { label: 'Control de Acceso' }]} />

  <PageHero
    eyebrow="SEPRIEV — Control de Acceso"
    titulo="Control de Acceso para Eventos"
    subtitulo="El punto de acceso es donde se gana o se pierde la seguridad de un evento. Lo operamos como un sistema de flujo y datos: integración con tu boletaje, revisión proporcional al riesgo y trazabilidad de cada ingreso."
  >
    <Fragment slot="right">
      <p class="text-accent text-base leading-relaxed">
        Por el control de acceso pasa el <strong class="text-light font-semibold">100% de los asistentes</strong>, por lo que es el proceso de mayor impacto en la experiencia y en la seguridad. <strong class="text-light font-semibold">SEPRIEV</strong> lo opera con personal entrenado específicamente para este rol: validación de boletos, detección de objetos prohibidos, gestión de aforo en tiempo real y credencialización por categoría.
      </p>
      <p class="text-accent text-base leading-relaxed">
        Integramos tu boletaje (<strong class="text-light font-semibold">Ticketmaster, Boletia, Eventbrite</strong> o sistemas propios), procesamos hasta <strong class="text-light font-semibold">1,200 ingresos por hora</strong> por punto con equipo propio, y operamos con <strong class="text-light font-semibold">licencia DGSSP y certificación STPS</strong> en CDMX, Guadalajara, Monterrey, Puebla y Cancún. Cotización en menos de 24 horas.
      </p>
      <p class="text-accent text-base leading-relaxed">Lo combinamos con <a href="/servicios/seguridad-conciertos-festivales" class="text-secondary hover:underline font-semibold">conciertos y festivales</a> y <a href="/servicios/seguridad-masivos" class="text-secondary hover:underline font-semibold">eventos masivos</a> en un solo operativo coordinado, con un único interlocutor responsable.</p>
      <div class="flex flex-col sm:flex-row gap-4 pt-1">
        <a href="/cotizar" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
          Cotizar este servicio
        </a>
        <a href={waHref} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border border-white/20 hover:border-white/40 text-accent hover:text-light px-7 py-3 text-sm font-semibold transition-colors">
          Consultar por WhatsApp
        </a>
      </div>
    </Fragment>
  </PageHero>

  <PageNav items={navItems} ariaLabel="Servicios relacionados" />

  <StatsSection />

  <!-- Módulos detallados del servicio -->
  <section class="py-20 bg-dark" id="servicio" aria-labelledby="servicio-h">
    <div class="w-full px-[5%] xl:px-[7%]">

      <!-- Encabezado de dos columnas -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-4 pb-2 lg:items-stretch">
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Cómo operamos el acceso</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-3" id="servicio-h">
            La primera línea de seguridad de tu evento
          </h2>
          <p class="text-accent text-base leading-relaxed">
            Un acceso bien gestionado reduce filas, previene fraudes y deja un registro auditable, todo en el mismo movimiento. La puerta no es un trámite: es donde se decide la seguridad del evento.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            Combinamos <strong class="text-light font-semibold">personal capacitado con tecnología propia</strong>: lectores de QR, código de barras y NFC de alta velocidad, arcos detectores de metales y software de gestión con tablero en tiempo real. Verificación y revisión en <strong class="text-light font-semibold">menos de 30 segundos por persona</strong>.
          </p>
          <p class="text-accent text-sm leading-relaxed">
            Definimos zonas y niveles de acceso, configuramos los sistemas y hacemos un <strong class="text-light font-semibold">simulacro de apertura de puertas</strong> antes del evento. Durante la operación, monitoreamos el aforo de forma continua y entregamos un <strong class="text-light font-semibold">reporte conciliado</strong> al cierre.
          </p>
        </div>
      </div>

      <!-- Módulos imagen + texto -->
      {modules.map((m) => (
        <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 mt-20 pt-16 border-t ${m.featured ? 'border-secondary/30' : 'border-white/8'}`}>

          <!-- Columna izquierda: texto -->
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-secondary text-xs font-bold uppercase tracking-widest">{m.eyebrow}</span>
              {m.badge && (
                <span class="bg-secondary text-white text-[10px] font-black uppercase tracking-widest px-2 py-0.5">{m.badge}</span>
              )}
            </div>
            <div class="w-8 h-0.5 bg-secondary mb-3"></div>
            <h3 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-4">{m.title}</h3>

            <p class="text-light/80 text-base leading-relaxed mb-5">{m.intro}</p>

            <ul class="flex flex-col gap-5 mb-6">
              {m.features.map((f) => (
                <li class="flex flex-col gap-1.5">
                  <div class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                    <span class="text-light text-base font-semibold">{f.title}</span>
                  </div>
                  <p class="text-light/70 text-sm leading-relaxed pl-4">{f.text}</p>
                </li>
              ))}
            </ul>

            <div class="flex flex-col sm:flex-row gap-4 mt-auto">
              <a href="/cotizar" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
                Cotizar este servicio
              </a>
              <a href={waHref} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 border border-white/20 hover:border-white/40 text-accent hover:text-light px-7 py-3 text-sm font-semibold transition-colors">
                Consultar por WhatsApp
              </a>
            </div>
          </div>

          <!-- Columna derecha: galería 1 grande + 2 pequeñas -->
          <div class="flex flex-col gap-4">
            <div class="relative w-full aspect-[16/9] overflow-hidden bg-primary">
              <picture>
                <source type="image/avif" srcset={`${m.hero}-640.avif 640w, ${m.hero}-1200.avif 1200w`} sizes="(max-width: 1024px) 100vw, 600px" />
                <source type="image/jpeg" srcset={`${m.hero}-640.jpg 640w, ${m.hero}-1200.jpg 1200w`} sizes="(max-width: 1024px) 100vw, 600px" />
                <img src={`${m.hero}-1200.jpg`} alt={m.alt[0]} class="w-full h-full object-cover" loading="lazy" decoding="async" width="1200" height="675" />
              </picture>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
                <picture>
                  <source type="image/avif" srcset={`${m.small1}-640.avif`} />
                  <img src={`${m.small1}-640.jpg`} alt={m.alt[1]} class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
                </picture>
              </div>
              <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
                <picture>
                  <source type="image/avif" srcset={`${m.small2}-640.avif`} />
                  <img src={`${m.small2}-640.jpg`} alt={m.alt[2]} class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
                </picture>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Componentes del control de acceso -->
  <section class="py-20 bg-dark border-t border-white/8" aria-labelledby="tipos-h">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-10 pb-10 border-b border-white/8 lg:items-center">
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Qué incluye el servicio</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight" id="tipos-h">Componentes del control de acceso</h2>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            Configuramos el operativo de acceso a partir de bloques que se combinan según el evento: desde la validación de boletos y la detección de objetos hasta la credencialización por niveles y la gestión de aforo en tiempo real, con un protocolo de trato definido para cada punto.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tipos.map((t) => (
          <div class="flex flex-col gap-2 px-6 py-7 bg-primary border border-white/8">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-secondary/70" aria-hidden="true">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>
            </svg>
            <span class="text-light font-bold text-base leading-snug mt-1">{t.titulo}</span>
            <span class="text-accent text-sm">{t.nota}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por qué SEPRIEV -->
  <section class="py-20 bg-primary/30 border-t border-primary" aria-labelledby="porque-h">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-10 pb-10 border-b border-white/8 lg:items-center">
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Por qué elegirnos</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight" id="porque-h">¿Por qué nuestro control de acceso es diferente?</h2>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            La diferencia entre un acceso ágil y un cuello de botella está en el equipo, la integración y el trato. Más de 500 eventos con control de acceso exitoso respaldan un proceso que protege la seguridad sin sacrificar la experiencia del asistente.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {razones.map((r) => (
          <div class="flex flex-col bg-dark border border-primary-light rounded-xl p-6">
            <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-secondary/15 border border-secondary/30 mb-4">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-secondary" aria-hidden="true">
                <path d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <h3 class="text-light font-bold text-base mb-2">{r.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProcessSection titulo="Así operamos el control de acceso" />

  <!-- Otros servicios -->
  <section class="py-20 bg-dark border-t border-white/8" aria-labelledby="otros-h">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-10 pb-10 border-b border-white/8 lg:items-center">
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Servicios complementarios</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight" id="otros-h">Otros servicios para tu evento</h2>
        </div>
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            El control de acceso casi siempre forma parte de un operativo mayor. Lo integramos con seguridad de conciertos, dirección de eventos masivos, operativos corporativos y custodia de montaje, bajo un solo mando y un solo interlocutor responsable.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {relacionados.map((s) => (
          <ServiceCard
            title={s.title}
            description={s.description}
            features={s.features}
            href={s.href}
            image={s.image}
            badge={s.badge}
            featured={s.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    eyebrow="Cotización gratuita"
    titulo="¿Necesitas control de acceso para tu evento?"
    subtitulo="Cuéntanos el aforo, el recinto y tu plataforma de boletaje, y recibe una propuesta personalizada en menos de 24 horas. Sin compromiso."
    faq={faq}
  />

</BaseLayout>
