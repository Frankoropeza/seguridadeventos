---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import TrustBadges from '@components/TrustBadges.astro';

const title = "Seguridad VIP para Eventos en Mexico";
const description = "Seguridad VIP para eventos exclusivos. Proteccion de areas VIP, escoltas de proximidad, seguridad discreta para celebridades y eventos de lujo.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Que incluye la seguridad VIP en eventos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye proteccion de areas exclusivas con acceso restringido, escoltas de proximidad para personalidades, control de acceso con listas VIP verificadas, coordinacion de llegadas y salidas discretas, vigilancia de objetos de valor y atencion personalizada a cada invitado VIP."
      }
    },
    {
      "@type": "Question",
      "name": "¿Como garantizan la discrecion en la seguridad VIP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestro personal VIP utiliza vestimenta acorde al evento, comunica mediante dispositivos discretos tipo earpiece, mantiene una presencia cercana pero no invasiva y esta entrenado en protocolo social. La seguridad se percibe como un servicio premium, no como una barrera."
      }
    },
    {
      "@type": "Question",
      "name": "¿Ofrecen proteccion para celebridades en eventos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, asignamos escoltas de proximidad experimentados para celebridades, artistas y figuras publicas. Coordinamos rutas de ingreso y salida privadas, gestionamos la interaccion con fans y medios, y aseguramos que la personalidad pueda disfrutar del evento con comodidad y seguridad."
      }
    },
    {
      "@type": "Question",
      "name": "¿Pueden manejar multiples zonas VIP en un mismo evento?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutamente. Diseñamos operativos con multiples niveles VIP, cada uno con sus propios controles de acceso, personal dedicado y protocolos especificos. Desde areas VIP generales hasta palcos privados y zonas ultra-exclusivas para patrocinadores o invitados especiales."
      }
    },
    {
      "@type": "Question",
      "name": "¿Que experiencia tienen en eventos de lujo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hemos protegido eventos de alta gama incluyendo galas de caridad, premiaciones, fiestas privadas de celebridades, eventos de marcas de lujo y cenas exclusivas. Nuestro equipo entiende las expectativas de un publico exigente y opera con los mas altos estandares de servicio."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Proteccion exclusiva</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
          Seguridad <span class="text-secondary">VIP</span> para Eventos
        </h1>
        <p class="text-accent text-lg sm:text-xl leading-relaxed max-w-3xl">
          Proporcionamos seguridad VIP para eventos exclusivos con un enfoque en discrecion, proteccion de proximidad y servicio personalizado. Nuestro equipo especializado protege areas VIP, gestiona accesos restringidos, asigna escoltas para celebridades y personalidades, y garantiza que cada invitado de alto perfil reciba atencion preferencial. Operamos en eventos de lujo, premiaciones, galas y fiestas privadas donde la calidad del servicio de seguridad es tan importante como la proteccion misma. La experiencia VIP comienza desde el primer contacto con nuestro equipo.
        </p>
      </div>
    </div>
  </section>

  <!-- En que consiste -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-black text-light mb-8">¿En que consiste la seguridad VIP en eventos?</h2>
        <div class="prose prose-lg text-accent leading-relaxed space-y-4">
          <p>
            La seguridad VIP va mucho mas alla de colocar guardias en una puerta. Es un servicio integral diseñado para proteger personas de alto perfil y areas exclusivas sin comprometer la experiencia del evento. Nuestro equipo se especializa en crear entornos seguros que se sienten naturales, donde la seguridad es invisible para los invitados pero siempre presente y efectiva.
          </p>
          <p>
            Comenzamos diseñando la arquitectura de seguridad de las zonas VIP, definiendo perimetros, puntos de control, rutas de acceso exclusivo y areas de resguardo. Cada zona VIP cuenta con personal dedicado que gestiona el acceso mediante listas verificadas, credenciales especiales o invitaciones personalizadas. Nuestros guardias VIP estan entrenados en protocolo social, etiqueta y atencion al cliente de alta gama.
          </p>
          <p>
            Para la proteccion de celebridades y personalidades, asignamos escoltas de proximidad que acompañan discretamente a la persona durante todo el evento. Estos profesionales coordinan rutas seguras de llegada y salida, gestionan la interaccion con medios de comunicacion y fans, y mantienen un perimetro de seguridad que respeta la privacidad del protegido sin aislarlo del evento.
          </p>
          <p>
            En eventos de lujo, cada detalle cuenta. Nuestro personal utiliza vestimenta formal acorde al nivel del evento, se comunica mediante dispositivos tipo earpiece practicamente invisibles y mantiene una actitud de servicio premium. Coordinamos con el equipo organizador, catering, valet parking y demas proveedores para que la experiencia VIP sea impecable de principio a fin.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Beneficios principales</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
        {[
          "Escoltas de proximidad discretos para celebridades y personalidades",
          "Gestion de areas VIP con acceso restringido y listas verificadas",
          "Personal con entrenamiento en protocolo social y etiqueta formal",
          "Comunicacion mediante dispositivos earpiece practicamente invisibles",
          "Coordinacion de llegadas y salidas privadas con rutas exclusivas",
          "Vigilancia de objetos de valor, regalos y pertenencias VIP"
        ].map((beneficio) => (
          <li class="flex items-start gap-3 bg-primary/30 border border-primary-light/30 rounded-lg p-4">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-accent text-sm leading-relaxed">{beneficio}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipos de eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Para que tipo de eventos?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Galas y premiaciones", ejemplo: "Eventos de etiqueta con alfombra roja, celebridades y medios de comunicacion." },
          { titulo: "Fiestas privadas exclusivas", ejemplo: "Celebraciones de alto perfil con lista de invitados restringida." },
          { titulo: "Eventos de marcas de lujo", ejemplo: "Lanzamientos y experiencias de marca premium con invitados selectos." },
          { titulo: "Conciertos con zonas VIP", ejemplo: "Areas exclusivas con servicio diferenciado dentro de eventos musicales." },
          { titulo: "Cenas y eventos sociales de elite", ejemplo: "Reuniones privadas con personalidades y figuras del ambito social." },
          { titulo: "Eventos diplomaticos", ejemplo: "Recepciones y eventos con representantes gubernamentales e internacionales." }
        ].map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/30 rounded-lg p-5">
            <h3 class="text-light font-bold text-base mb-2">{tipo.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.ejemplo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Nuestro proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        {[
          { paso: "01", titulo: "Perfil del evento", desc: "Identificamos los invitados VIP, nivel de exclusividad, tipo de venue y requerimientos especificos de proteccion y protocolo." },
          { paso: "02", titulo: "Diseño de zonas VIP", desc: "Configuramos perimetros, puntos de acceso exclusivo, rutas privadas y areas de resguardo con seguridad dedicada." },
          { paso: "03", titulo: "Operativo discreto", desc: "Desplegamos escoltas y guardias VIP con vestimenta formal, comunicacion discreta y protocolo de servicio premium." },
          { paso: "04", titulo: "Seguimiento y cierre", desc: "Coordinamos la salida segura de invitados VIP y entregamos un reporte confidencial del operativo." }
        ].map((item) => (
          <div class="relative bg-primary/30 border border-primary-light/30 rounded-lg p-6">
            <span class="text-secondary font-black text-3xl opacity-30">{item.paso}</span>
            <h3 class="text-light font-bold text-base mt-2 mb-2">{item.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por que elegirnos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Por que elegir SeguridadEventos?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Servicio de alta gama", desc: "Nuestro personal VIP combina habilidades de seguridad con formacion en protocolo social, etiqueta y atencion al cliente premium." },
          { titulo: "Discrecion absoluta", desc: "Operamos con equipos de comunicacion invisibles, vestimenta acorde al evento y una presencia que protege sin incomodar." },
          { titulo: "Experiencia en eventos exclusivos", desc: "Hemos protegido galas, premiaciones y eventos de lujo con los mas altos estandares de calidad y confidencialidad." }
        ].map((dif) => (
          <div class="bg-primary/30 border border-secondary/20 rounded-lg p-6">
            <h3 class="text-light font-bold text-base mb-3">{dif.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{dif.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Preguntas frecuentes sobre seguridad VIP</h2>
      <div class="max-w-3xl space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-primary/30 border border-primary-light/30 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-light font-semibold text-sm sm:text-base">
              {faq.name}
              <svg class="w-5 h-5 text-secondary flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-accent text-sm leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner titulo="¿Necesitas seguridad VIP para tu evento?" subtitulo="Cotizacion personalizada en menos de 24 horas. Sin compromiso." />
</BaseLayout>
