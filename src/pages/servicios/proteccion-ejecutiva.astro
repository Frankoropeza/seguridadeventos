---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import TrustBadges from '@components/TrustBadges.astro';

const title = "Proteccion Ejecutiva para Eventos | Escoltas Profesionales";
const description = "Proteccion ejecutiva y escoltas profesionales para eventos. Analisis de riesgo, rutas seguras, seguridad avanzada y coordinacion con autoridades.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Que es la proteccion ejecutiva en eventos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La proteccion ejecutiva es un servicio especializado de seguridad personal que asigna escoltas profesionales a directivos, artistas, ponentes y personalidades de alto perfil durante eventos. Incluye analisis de riesgo previo, diseño de rutas seguras, seguridad avanzada en el venue y acompañamiento cercano durante toda la estancia."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuantos escoltas se necesitan para proteccion ejecutiva?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depende del nivel de riesgo y la visibilidad de la persona protegida. Para un directivo en un evento corporativo puede bastar un escolta de proximidad. Para una celebridad en un evento masivo, recomendamos un equipo de 3 a 5 elementos que cubran perimetro, proximidad y coordinacion logistica."
      }
    },
    {
      "@type": "Question",
      "name": "¿Los escoltas van armados?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestros escoltas pueden operar armados o desarmados segun las necesidades y la normativa aplicable. Todo nuestro personal cuenta con las licencias y permisos correspondientes emitidos por la DGSSP. La decision se toma durante el analisis de riesgo previo en coordinacion con el cliente."
      }
    },
    {
      "@type": "Question",
      "name": "¿Realizan seguridad avanzada antes del evento?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, nuestro equipo de avanzada llega al venue antes que la persona protegida para verificar accesos, revisar rutas, coordinar con el personal del recinto, identificar posibles amenazas y preparar el entorno. Este reconocimiento previo es fundamental para garantizar una llegada y estancia segura."
      }
    },
    {
      "@type": "Question",
      "name": "¿Se coordinan con las autoridades locales?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, cuando el nivel de riesgo lo requiere, coordinamos con autoridades municipales, estatales y federales. Compartimos planes de ruta, horarios y puntos de contacto para asegurar una respuesta rapida ante cualquier contingencia. Esta coordinacion es especialmente importante en eventos de alto perfil."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Escoltas profesionales</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
          Proteccion Ejecutiva <span class="text-secondary">para Eventos</span>
        </h1>
        <p class="text-accent text-lg sm:text-xl leading-relaxed max-w-3xl">
          Ofrecemos proteccion ejecutiva con escoltas profesionales para directivos, artistas y personalidades que asisten o participan en eventos. Nuestro servicio comienza con un analisis de riesgo detallado y se extiende hasta el diseño de rutas seguras, seguridad avanzada en el venue y acompañamiento de proximidad durante todo el evento. Cada escolta esta certificado, entrenado en tecnicas de proteccion personal y capacitado en primeros auxilios, manejo defensivo y coordinacion con autoridades para garantizar la integridad de la persona protegida.
        </p>
      </div>
    </div>
  </section>

  <!-- En que consiste -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-black text-light mb-8">¿En que consiste la proteccion ejecutiva en eventos?</h2>
        <div class="prose prose-lg text-accent leading-relaxed space-y-4">
          <p>
            La proteccion ejecutiva para eventos es un servicio de seguridad personal de alto nivel que va mas alla de la vigilancia convencional. Se trata de un operativo integral centrado en una persona o grupo de personas que requieren proteccion especial debido a su perfil publico, cargo empresarial o nivel de exposicion durante un evento. Nuestros escoltas profesionales actuan como un escudo invisible que acompaña, protege y facilita la movilidad del protegido.
          </p>
          <p>
            Todo operativo de proteccion ejecutiva inicia con un analisis de riesgo. Evaluamos el perfil de la persona protegida, el tipo de evento, la ubicacion del venue, los antecedentes de seguridad de la zona y las posibles amenazas. Con esta informacion, diseñamos un plan que incluye rutas principales y alternas de desplazamiento, puntos de encuentro de emergencia, vehiculos de seguridad y comunicacion cifrada entre todos los elementos del equipo.
          </p>
          <p>
            La seguridad avanzada es una fase critica donde nuestro equipo llega al venue antes que la persona protegida. Los agentes de avanzada verifican accesos, inspeccionan areas clave, coordinan con el personal del recinto, confirman puntos de evacuacion y preparan el entorno para la llegada. Esta fase permite anticipar y neutralizar riesgos antes de que se materialicen.
          </p>
          <p>
            Durante el evento, los escoltas de proximidad acompañan al protegido manteniendo una presencia cercana pero discreta. Estan entrenados para reaccionar ante situaciones de riesgo, gestionar la interaccion con terceros y facilitar la movilidad del protegido en entornos concurridos. Al finalizar, coordinamos la salida segura y realizamos un informe detallado del operativo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Beneficios principales</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
        {[
          "Analisis de riesgo previo con evaluacion de amenazas y vulnerabilidades",
          "Escoltas certificados con licencia DGSSP y entrenamiento en proteccion personal",
          "Seguridad avanzada con reconocimiento del venue antes de la llegada",
          "Rutas seguras de desplazamiento con alternativas de emergencia planificadas",
          "Coordinacion con autoridades locales y servicios de emergencia",
          "Comunicacion cifrada entre todos los elementos del equipo de proteccion"
        ].map((beneficio) => (
          <li class="flex items-start gap-3 bg-primary/30 border border-primary-light/30 rounded-lg p-4">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-accent text-sm leading-relaxed">{beneficio}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipos de eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Para que tipo de eventos?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Eventos corporativos de alto nivel", ejemplo: "Juntas directivas, asambleas de accionistas y reuniones con inversionistas." },
          { titulo: "Conciertos y presentaciones", ejemplo: "Proteccion de artistas nacionales e internacionales durante giras y eventos." },
          { titulo: "Congresos internacionales", ejemplo: "Escoltas para ponentes, CEOs y personalidades del sector." },
          { titulo: "Eventos politicos y diplomaticos", ejemplo: "Proteccion para funcionarios, candidatos y representantes gubernamentales." },
          { titulo: "Premiaciones y galas", ejemplo: "Acompañamiento de celebridades y figuras publicas en alfombras rojas." },
          { titulo: "Eventos sociales privados", ejemplo: "Proteccion discreta para personalidades en bodas, fiestas y celebraciones." }
        ].map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/30 rounded-lg p-5">
            <h3 class="text-light font-bold text-base mb-2">{tipo.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.ejemplo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Nuestro proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        {[
          { paso: "01", titulo: "Analisis de riesgo", desc: "Evaluamos el perfil del protegido, tipo de evento, ubicacion y posibles amenazas para definir el nivel de proteccion requerido." },
          { paso: "02", titulo: "Plan de proteccion", desc: "Diseñamos rutas seguras, asignamos escoltas, definimos puntos de encuentro de emergencia y coordinamos con autoridades." },
          { paso: "03", titulo: "Avanzada y ejecucion", desc: "Nuestro equipo llega primero al venue, verifica el entorno y acompaña al protegido durante todo el evento." },
          { paso: "04", titulo: "Salida segura e informe", desc: "Coordinamos la salida del protegido y entregamos un reporte confidencial con observaciones y recomendaciones." }
        ].map((item) => (
          <div class="relative bg-primary/30 border border-primary-light/30 rounded-lg p-6">
            <span class="text-secondary font-black text-3xl opacity-30">{item.paso}</span>
            <h3 class="text-light font-bold text-base mt-2 mb-2">{item.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por que elegirnos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Por que elegir SeguridadEventos?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Escoltas de elite", desc: "Personal con formacion en proteccion personal, primeros auxilios, manejo defensivo y tecnicas de reaccion ante emergencias." },
          { titulo: "Metodologia probada", desc: "Analisis de riesgo, seguridad avanzada y protocolos de proteccion basados en estandares internacionales de seguridad ejecutiva." },
          { titulo: "Coordinacion institucional", desc: "Relacion directa con autoridades municipales, estatales y federales para asegurar respuesta inmediata ante cualquier situacion." }
        ].map((dif) => (
          <div class="bg-primary/30 border border-secondary/20 rounded-lg p-6">
            <h3 class="text-light font-bold text-base mb-3">{dif.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{dif.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Preguntas frecuentes sobre proteccion ejecutiva</h2>
      <div class="max-w-3xl space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-primary/30 border border-primary-light/30 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-light font-semibold text-sm sm:text-base">
              {faq.name}
              <svg class="w-5 h-5 text-secondary flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-accent text-sm leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner titulo="¿Necesitas proteccion ejecutiva para tu evento?" subtitulo="Cotizacion personalizada en menos de 24 horas. Sin compromiso." />
</BaseLayout>
