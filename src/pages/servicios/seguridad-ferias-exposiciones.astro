---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import TrustBadges from '@components/TrustBadges.astro';

const title = "Seguridad para Ferias, Exposiciones y Expos en Mexico";
const description = "Seguridad profesional para ferias y exposiciones. Proteccion de stands, vigilancia perimetral, control de acceso por zonas y seguridad para eventos multi-dia.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Que incluye la seguridad para ferias y exposiciones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Incluye vigilancia perimetral del recinto, control de acceso para visitantes y exhibidores, proteccion de stands y mercancia de alto valor, rondines nocturnos durante eventos de multiples dias, gestion de estacionamientos y coordinacion con la administracion del centro de convenciones."
      }
    },
    {
      "@type": "Question",
      "name": "¿Ofrecen vigilancia nocturna para expos de varios dias?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, proporcionamos vigilancia nocturna con guardias rotativos que custodian las instalaciones, stands y mercancia durante las horas en que la expo esta cerrada al publico. Incluimos rondines programados, control de acceso para personal de limpieza y montaje nocturno, y reporte de novedades."
      }
    },
    {
      "@type": "Question",
      "name": "¿Como protegen la mercancia de alto valor en stands?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Asignamos guardias dedicados a stands con mercancia de alto valor, implementamos perimetros de seguridad visual, controlamos el acceso a areas de exhibicion restringidas y coordinamos con los exhibidores protocolos de apertura y cierre de vitrinas y areas de almacenamiento."
      }
    },
    {
      "@type": "Question",
      "name": "¿Manejan control de acceso para exhibidores y visitantes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, implementamos sistemas de credenciales diferenciadas para exhibidores, visitantes, prensa, organizadores y personal de servicio. Cada categoria tiene permisos especificos de acceso a diferentes zonas del recinto, incluyendo areas de montaje, bodegas y zonas de carga."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cual es el costo de seguridad para una expo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El costo depende del tamano del recinto, la duracion del evento, la cantidad de stands, el valor de la mercancia exhibida y los servicios especificos requeridos. Ofrecemos cotizaciones personalizadas que se adaptan al presupuesto del organizador sin sacrificar la calidad del servicio."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Ferias y exposiciones</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
          Seguridad para <span class="text-secondary">Ferias y Exposiciones</span>
        </h1>
        <p class="text-accent text-lg sm:text-xl leading-relaxed max-w-3xl">
          Brindamos seguridad integral para ferias comerciales, exposiciones y expos de todos los tamanos. Nuestro servicio cubre desde la proteccion de stands y mercancia de alto valor hasta el control de acceso por zonas, vigilancia perimetral y rondines nocturnos en eventos de multiples dias. Contamos con personal experimentado en la dinamica de centros de convenciones y recintos feriales, capaz de gestionar flujos de visitantes, coordinar con exhibidores y mantener el orden durante jornadas de alta afluencia sin afectar la experiencia comercial del evento.
        </p>
      </div>
    </div>
  </section>

  <!-- En que consiste -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-black text-light mb-8">¿En que consiste la seguridad para ferias y exposiciones?</h2>
        <div class="prose prose-lg text-accent leading-relaxed space-y-4">
          <p>
            Las ferias y exposiciones presentan desafios de seguridad unicos: son eventos de multiples dias con alto flujo de visitantes, mercancia de valor expuesta al publico, areas de montaje con acceso de proveedores externos y horarios extendidos que requieren cobertura continua. Nuestro servicio esta diseñado para abordar cada uno de estos desafios con personal especializado y protocolos probados.
          </p>
          <p>
            Iniciamos con la evaluacion del recinto ferial, identificando los puntos de acceso para visitantes, exhibidores, proveedores y personal de servicio. Diseñamos un sistema de control de acceso diferenciado que utiliza credenciales por categoria, permitiendo que cada persona acceda unicamente a las zonas autorizadas. Esto incluye areas de exhibicion, bodegas, zonas de carga y descarga, salones de conferencias y areas administrativas.
          </p>
          <p>
            La proteccion de stands es una prioridad, especialmente cuando exhiben productos de alto valor como joyeria, tecnologia, automoviles o arte. Asignamos guardias dedicados a estas areas, implementamos protocolos de apertura y cierre de vitrinas, y coordinamos con los exhibidores para que el resguardo de su mercancia sea efectivo sin interferir con su actividad comercial.
          </p>
          <p>
            Para eventos de multiples dias, proporcionamos vigilancia nocturna con rondines programados, control de acceso para personal de limpieza y montaje fuera de horario, y custodia de instalaciones hasta el siguiente dia de operacion. Nuestro equipo se coordina con la administracion del centro de convenciones para integrar nuestros protocolos con los del recinto, garantizando una cobertura de seguridad completa las 24 horas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Beneficios principales</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
        {[
          "Proteccion de stands y mercancia de alto valor con guardias dedicados",
          "Vigilancia nocturna con rondines programados en eventos multi-dia",
          "Control de acceso diferenciado para exhibidores, visitantes y proveedores",
          "Vigilancia perimetral del recinto con monitoreo de puntos criticos",
          "Coordinacion con la administracion del centro de convenciones",
          "Gestion de estacionamientos y areas de carga y descarga"
        ].map((beneficio) => (
          <li class="flex items-start gap-3 bg-primary/30 border border-primary-light/30 rounded-lg p-4">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-accent text-sm leading-relaxed">{beneficio}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipos de eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Para que tipo de eventos?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Ferias comerciales", ejemplo: "Ferias de industria con multiples stands, demostraciones y transacciones comerciales." },
          { titulo: "Exposiciones de arte", ejemplo: "Muestras de arte con obras de alto valor que requieren custodia especializada." },
          { titulo: "Expos automotrices", ejemplo: "Exhibiciones de vehiculos con proteccion de modelos y areas de prueba." },
          { titulo: "Ferias de tecnologia", ejemplo: "Expos con equipos y prototipos de alto valor tecnologico y comercial." },
          { titulo: "Ferias gastronomicas", ejemplo: "Eventos culinarios con manejo de flujos de publico y zonas de preparacion." },
          { titulo: "Expos inmobiliarias", ejemplo: "Ferias del sector con proteccion de stands, material y atencion al visitante." }
        ].map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/30 rounded-lg p-5">
            <h3 class="text-light font-bold text-base mb-2">{tipo.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.ejemplo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Nuestro proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        {[
          { paso: "01", titulo: "Evaluacion del recinto", desc: "Inspeccionamos el centro de convenciones, identificamos accesos, zonas criticas y coordinamos con la administracion del inmueble." },
          { paso: "02", titulo: "Plan de seguridad ferial", desc: "Diseñamos el operativo con control de acceso por zonas, proteccion de stands prioritarios y cobertura para horarios extendidos." },
          { paso: "03", titulo: "Operacion continua", desc: "Desplegamos personal en turno diurno y nocturno con rondines, control de acceso y coordinacion con exhibidores." },
          { paso: "04", titulo: "Cierre y reporte", desc: "Custodiamos el desmontaje, verificamos la salida de mercancia y entregamos un informe completo del operativo." }
        ].map((item) => (
          <div class="relative bg-primary/30 border border-primary-light/30 rounded-lg p-6">
            <span class="text-secondary font-black text-3xl opacity-30">{item.paso}</span>
            <h3 class="text-light font-bold text-base mt-2 mb-2">{item.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por que elegirnos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Por que elegir SeguridadEventos?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Experiencia en recintos feriales", desc: "Conocemos la operacion de los principales centros de convenciones y recintos feriales de Mexico." },
          { titulo: "Cobertura 24/7", desc: "Turnos rotativos para eventos de multiples dias con vigilancia nocturna, rondines y control de acceso permanente." },
          { titulo: "Proteccion de activos", desc: "Protocolos especificos para mercancia de alto valor con custodia dedicada y coordinacion directa con exhibidores." }
        ].map((dif) => (
          <div class="bg-primary/30 border border-secondary/20 rounded-lg p-6">
            <h3 class="text-light font-bold text-base mb-3">{dif.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{dif.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Preguntas frecuentes sobre seguridad en ferias</h2>
      <div class="max-w-3xl space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-primary/30 border border-primary-light/30 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-light font-semibold text-sm sm:text-base">
              {faq.name}
              <svg class="w-5 h-5 text-secondary flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-accent text-sm leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner titulo="¿Necesitas seguridad para tu feria o exposicion?" subtitulo="Cotizacion personalizada en menos de 24 horas. Sin compromiso." />
</BaseLayout>
