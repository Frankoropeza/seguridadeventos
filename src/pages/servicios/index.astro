---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ServiceModule from '@/components/ServiceModule.astro';
import CTABanner from '@/components/CTABanner.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PageHero from '@/components/PageHero.astro';
import PageNav from '@/components/PageNav.astro';
import { getCollection } from 'astro:content';

const servicios = (await getCollection('servicios'))
  .sort((a: any, b: any) => a.data.orden - b.data.orden);

const serviceCards = [
  { icon: "🎵", title: "Conciertos y Festivales", desc: "Operativos dimensionados por aforo y respaldados con una carpeta de seguridad ante la autoridad, de foros íntimos a festivales de más de 80,000 asistentes.", features: ["Plan de seguridad documentado", "Dimensionamiento por aforo", "Enlace con Protección Civil"], slug: "seguridad-conciertos-festivales", badge: "Popular" },
  { icon: "🏢", title: "Eventos Corporativos", desc: "Dispositivos discretos que protegen a las personas y la reputación de la marca, alineados al protocolo interno del cliente y bajo confidencialidad contractual.", features: ["Planeación con el cliente", "Confidencialidad contractual", "Imagen institucional"], slug: "seguridad-eventos-corporativos" },
  { icon: "🚪", title: "Control de Acceso", desc: "Gestión de acceso como sistema de flujo y datos: integración con el boletaje, trazabilidad de cada ingreso y revisión proporcional al riesgo.", features: ["Integración con boletaje", "Trazabilidad y auditoría", "Revisión proporcional"], slug: "control-acceso-eventos", badge: "Esencial" },
  { icon: "⭐", title: "Seguridad VIP", desc: "Escoltas certificados en protección personal, con avanzada de seguridad y dispositivo de bajo perfil coordinado con la representación del cliente.", features: ["Avanzada de seguridad", "Coordinación con management", "Dispositivo de bajo perfil"], slug: "seguridad-vip" },
  { icon: "👔", title: "Protección Ejecutiva", desc: "Programa continuo de protección basado en análisis de riesgo, con personal verificado y gobernanza estricta de la información del directivo.", features: ["Análisis de riesgo", "Personal verificado", "Inteligencia de exposición"], slug: "proteccion-ejecutiva" },
  { icon: "🎪", title: "Ferias y Exposiciones", desc: "Cobertura por zonas y por jornada para recintos multi-expositor, con inventario conciliado y enlace operativo con la administración del recinto.", features: ["Cobertura 24/7 por turnos", "Inventario conciliado", "Enlace con el recinto"], slug: "seguridad-ferias-exposiciones" },
  { icon: "🎉", title: "Eventos Sociales", desc: "Seguridad discreta para bodas, XV años y celebraciones privadas: control de invitados y manejo de incidentes sin alterar la experiencia.", features: ["Control de invitados", "Manejo discreto", "Resguardo de valores"], slug: "seguridad-eventos-sociales" },
  { icon: "⚽", title: "Eventos Deportivos", desc: "Operativos que integran gestión de aficiones, protección de protagonistas y cumplimiento de los protocolos de cada liga o federación.", features: ["Accesos diferenciados", "Protección de atletas", "Cumplimiento de liga"], slug: "seguridad-eventos-deportivos" },
  { icon: "🏟️", title: "Eventos Masivos", desc: "Dirección de seguridad a escala de más de 10,000 asistentes con centro de comando, vigilancia aérea y mando unificado con autoridades.", features: ["Centro de comando", "Vigilancia aérea y aforo", "Mando unificado"], slug: "seguridad-masivos", featured: true },
  { icon: "🔧", title: "Montaje y Desmontaje", desc: "Cobertura del ciclo completo del evento, con custodia 24/7, acreditación de proveedores e inventario fotográfico de activos.", features: ["Custodia 24/7", "Acreditación de proveedores", "Inventario fotográfico"], slug: "seguridad-montaje-desmontaje" },
];

const servImg: Record<string,string> = {"seguridad-conciertos-festivales": "/img/eventos/seguridad-conciertos-festivales", "seguridad-eventos-corporativos": "/img/eventos/seguridad-eventos-corporativos", "control-acceso-eventos": "/img/eventos/control-acceso-eventos", "seguridad-vip": "/img/eventos/seguridad-vip-eventos", "proteccion-ejecutiva": "/img/eventos/proteccion-ejecutiva-mexico", "seguridad-ferias-exposiciones": "/img/eventos/seguridad-empresarial-evento", "seguridad-eventos-sociales": "/img/eventos/seguridad-vip-gala", "seguridad-eventos-deportivos": "/img/eventos/seguridad-conciertos-multitud", "seguridad-masivos": "/img/eventos/guardias-seguridad-privada", "seguridad-montaje-desmontaje": "/img/eventos/equipo-seguridad-eventos"};

const navItems = [
  {
    label: "Conciertos y Festivales",
    desc: "Control masivo para eventos musicales de cualquier escala",
    href: "/servicios/seguridad-conciertos-festivales/",
  },
  {
    label: "Eventos Corporativos",
    desc: "Seguridad ejecutiva discreta y profesional",
    href: "/servicios/seguridad-eventos-corporativos/",
  },
  {
    label: "Seguridad VIP",
    desc: "Protección personal para celebridades y ejecutivos",
    href: "/servicios/seguridad-vip/",
  },
  {
    label: "Solicitar Cotización",
    desc: "Propuesta personalizada en menos de 24 horas",
    href: "/cotizar/",
  },
];

const IMG = "/img/eventos";

const serviceModules = [
  {
    title: "Conciertos y Festivales",
    href: "/servicios/seguridad-conciertos-festivales/",
    badge: "Popular",
    hero: `${IMG}/seguridad-conciertos-festivales`,
    small1: `${IMG}/seguridad-conciertos-multitud`,
    small2: `${IMG}/personal-seguridad-evento`,
    intro: "La diferencia entre un concierto seguro y uno expuesto se decide en la planeación, no en la ejecución. SEPRIEV aborda cada evento musical como un proyecto de seguridad con metodología propia: diagnóstico del recinto, dimensionamiento por aforo y entrega de una carpeta de seguridad que sustenta el evento ante la autoridad y la aseguradora. Con más de 200 eventos musicales operados y licencia federal vigente, nuestro estándar no depende de la escala del cartel, sino de un proceso documentado que se repite con la misma rigurosidad en cada producción.",
    features: [
      { title: "Diagnóstico y plan de seguridad", text: "Cada operativo inicia con una evaluación en sitio del recinto —accesos, aforos por sector, salidas de emergencia y puntos críticos— de la que se deriva un plan de seguridad formal. Ese documento define posiciones, funciones, horarios y protocolos de contingencia, y se comparte con el organizador y la autoridad como base única de la operación. SEPRIEV no improvisa el día del evento: ejecuta un plan validado con anticipación." },
      { title: "Cumplimiento normativo verificable", text: "Todo el personal opera con registro vigente ante la DGSSP y capacitación STPS documentada, dentro de un sistema de gestión alineado a ISO 9001. SEPRIEV integra la documentación que Protección Civil y el municipio exigen para autorizar el evento y la respalda con evidencia de campo, de modo que el cumplimiento sea verificable y auditable, no declarativo." },
      { title: "Continuidad y reporte posterior", text: "Los festivales multi-jornada se cubren con relevos escalonados y traspasos de turno documentados que sostienen el estándar de día y de madrugada. Al cierre, el organizador recibe un informe posterior al evento con incidencias, aforos y recomendaciones: un entregable que convierte cada operativo en información útil para la siguiente edición." },
    ],
  },
  {
    title: "Eventos Corporativos",
    href: "/servicios/seguridad-eventos-corporativos/",
    hero: `${IMG}/seguridad-eventos-corporativos`,
    small1: `${IMG}/seguridad-empresarial-evento`,
    small2: `${IMG}/equipo-seguridad-eventos`,
    intro: "En el entorno corporativo, la seguridad es también un asunto de reputación: un incidente mal gestionado frente a clientes, prensa o consejo puede costar más que el evento mismo. SEPRIEV diseña dispositivos que se integran a la imagen y al protocolo interno del cliente, operados por personal capacitado en etiqueta empresarial y sujeto a confidencialidad contractual. El objetivo es un operativo que la organización perciba como parte de sí misma y no como un cuerpo ajeno.",
    features: [
      { title: "Planeación conjunta y punto único de contacto", text: "Antes de cada evento, SEPRIEV sostiene una sesión de planeación con el área responsable del cliente para alinear formato, perfiles de asistentes, zonas sensibles y momentos críticos del programa. De ahí surge un plan a la medida y un punto único de contacto que coordina toda la operación, de modo que el cliente trate con un solo interlocutor responsable y no con una cuadrilla sin coordinación." },
      { title: "Confidencialidad contractual", text: "El personal asignado firma acuerdos de no divulgación que cubren información estratégica, identidades de asistentes y cualquier dato observado durante el operativo, con instrucciones explícitas sobre fotografía, redes y trato con medios. SEPRIEV gestiona la confidencialidad como una obligación contractual estándar, aplicada por igual a toda asignación corporativa y no reservada a clientes de alto perfil." },
      { title: "Imagen institucional y hospitalidad", text: "El dispositivo se presenta con la vestimenta y el trato que el entorno exige, combinando la función de seguridad con hospitalidad ejecutiva: recibir, orientar y resolver con cortesía. Esa integración protege a la vez la experiencia del invitado y la imagen de la marca, incluso al gestionar accesos, filtrar intrusos o atender situaciones delicadas frente a directivos." },
    ],
  },
  {
    title: "Control de Acceso",
    href: "/servicios/control-acceso-eventos/",
    badge: "Esencial",
    hero: `${IMG}/control-acceso-eventos`,
    small1: `${IMG}/control-acceso-credenciales`,
    small2: `${IMG}/personal-seguridad-evento`,
    intro: "El control de acceso es el proceso por el que pasa el cien por ciento de los asistentes y, por tanto, el de mayor impacto en la experiencia y en la seguridad del evento. SEPRIEV lo opera como un sistema de flujo y datos: integración con el boletaje del cliente, trazabilidad de cada ingreso y revisión proporcional al riesgo. Un acceso bien gestionado reduce filas, previene fraudes y deja un registro auditable del evento, todo en el mismo movimiento.",
    features: [
      { title: "Integración con el sistema de boletaje", text: "SEPRIEV coordina con la plataforma de ticketing del cliente para validar en tiempo real, detectar duplicados o falsificaciones y asegurar compatibilidad de lectores, con pruebas previas en sitio. Se define además un protocolo de contingencia para validación manual ante fallas de conectividad, de manera que una caída de red no detenga el ingreso ni comprometa el control." },
      { title: "Trazabilidad y reporte de aforo", text: "Cada acceso se registra con hora y punto de entrada, lo que permite conocer el aforo en tiempo real durante la operación y entregar al cierre un reporte conciliado al organizador. Esa trazabilidad sostiene tanto la toma de decisiones en vivo como la auditoría posterior frente a la autoridad o la aseguradora." },
      { title: "Revisión proporcional y protocolo de trato", text: "Los filtros se calibran al perfil de riesgo del evento para ser efectivos sin convertirse en cuello de botella, con personal femenino para la revisión de mujeres y un protocolo de trato respetuoso en cada punto. SEPRIEV capacita a su personal para resolver inconformidades sin escalar el tono, consciente de que la primera impresión del evento ocurre en la puerta." },
    ],
  },
  {
    title: "Seguridad VIP",
    href: "/servicios/seguridad-vip/",
    hero: `${IMG}/seguridad-vip-eventos`,
    small1: `${IMG}/proteccion-vip-invitados`,
    small2: `${IMG}/seguridad-vip-gala`,
    intro: "La protección de figuras de alto perfil exige criterio antes que fuerza: anticipar el entorno, coordinar con la representación y desaparecer cuando la situación lo permite. SEPRIEV despliega escoltas certificados en protección personal que trabajan sobre una avanzada de seguridad y un dispositivo de bajo perfil ajustado a cada escenario, desde una alfombra roja hasta un escenario ante miles de personas. La seguridad del protegido es innegociable; su imagen y su privacidad, también.",
    features: [
      { title: "Avanzada y planeación de movimientos", text: "Cada desplazamiento se construye sobre un reconocimiento previo que identifica accesos y salidas, puntos seguros, el hospital más cercano y las rutas primaria y alterna. El dispositivo del día parte de esa avanzada, de modo que la llegada del protegido se ejecute sobre decisiones tomadas con antelación y no sobre improvisaciones." },
      { title: "Coordinación con la representación", text: "SEPRIEV alinea el nivel de exposición del operativo con el management o el equipo del cliente, porque proteger a quien quiere saludar al público es distinto a proteger a quien no puede ser ubicado. Definir esto por adelantado permite que el dispositivo acompañe la estrategia de imagen del protegido en lugar de entorpecerla." },
      { title: "Dispositivo de bajo perfil", text: "La protección más eficaz rara vez es la más visible. Los escoltas operan en formaciones discretas, con vestimenta acorde al entorno y comunicación silenciosa, de manera que la seguridad esté presente sin acaparar la atención. El protegido se mueve con normalidad y el público recuerda a la figura, no a su equipo." },
    ],
  },
  {
    title: "Protección Ejecutiva",
    href: "/servicios/proteccion-ejecutiva/",
    hero: `${IMG}/proteccion-ejecutiva-mexico`,
    small1: `${IMG}/guardias-seguridad-privada`,
    small2: `${IMG}/seguridad-eventos-corporativos`,
    intro: "La protección de un directivo no es un servicio de un día, sino un programa continuo que se integra a su vida con el menor impacto posible en su operación. SEPRIEV diseña esquemas que parten de un análisis de riesgo formal y cubren desplazamientos, oficina, eventos y domicilio, con personal verificado y bajo confidencialidad estricta. En este servicio, la calidad se mide por la anticipación: lo que no se previene, ya es tarde para gestionarlo.",
    features: [
      { title: "Análisis de riesgo e inteligencia de exposición", text: "Antes de asignar personal, SEPRIEV evalúa el perfil de amenaza del ejecutivo —sector, exposición pública, historial y contexto geográfico— y monitorea su huella digital en busca de señales de interés hostil. El resultado define el nivel de protección y un conjunto de recomendaciones para reducir la superficie de exposición del directivo y su familia." },
      { title: "Personal seleccionado y verificado", text: "El escolta de un ejecutivo accede a su intimidad, su agenda y su entorno, por lo que la confianza es parte del servicio. SEPRIEV selecciona a su personal con verificación de antecedentes, evaluación de perfil y capacitación documentada, y mantiene continuidad en las asignaciones para que el cliente trabaje siempre con personal conocido." },
      { title: "Gobernanza de la información", text: "El esquema cubre al directivo y a su núcleo cercano, así como la información sensible que los rodea: domicilios, rutinas, patrimonio y movimientos. Todo el personal opera bajo protocolos de manejo de información y confidencialidad estricta, porque en protección ejecutiva una filtración interna puede ser tan peligrosa como una amenaza externa." },
    ],
  },
  {
    title: "Ferias y Exposiciones",
    href: "/servicios/seguridad-ferias-exposiciones/",
    hero: `${IMG}/seguridad-empresarial-evento`,
    small1: `${IMG}/control-acceso-eventos`,
    small2: `${IMG}/equipo-seguridad-eventos`,
    intro: "Una feria es un recinto vivo durante varios días, con decenas de expositores, activos de valor heterogéneo y un flujo que cambia por hora. SEPRIEV opera este tipo de evento con un modelo de cobertura por zonas y por jornada que distingue el riesgo del recinto con público del recinto vacío de madrugada. La continuidad y la trazabilidad del operativo son lo que sostiene la confianza de cada expositor.",
    features: [
      { title: "Cobertura por zonas y por turnos", text: "El operativo cubre el ciclo completo de la feria —jornada con público, cierre y vigilancia nocturna— con relevos diseñados para no dejar ninguna franja descubierta y traspasos documentados entre turnos. La cobertura nocturna queda registrada, de modo que cada expositor encuentra su stand tal como lo dejó." },
      { title: "Inventario conciliado de activos", text: "Para los stands con piezas de alto valor, SEPRIEV implementa registro de inventario de entrada y salida y conciliación al cierre de cada jornada, con hora y responsable. Cualquier faltante se identifica antes de la apertura al público y no días después, lo que permite actuar de inmediato y con evidencia." },
      { title: "Enlace operativo con el recinto", text: "El dispositivo se coordina con la administración del recinto, los servicios de emergencia y los proveedores de seguridad de los propios expositores para evitar duplicidades y zonas grises de responsabilidad. Un mando claro y un canal unificado garantizan que, ante un incidente, exista siempre un responsable definido y una respuesta ordenada." },
    ],
  },
  {
    title: "Eventos Sociales",
    href: "/servicios/seguridad-eventos-sociales/",
    hero: `${IMG}/seguridad-vip-gala`,
    small1: `${IMG}/proteccion-vip-invitados`,
    small2: `${IMG}/personal-seguridad-evento`,
    intro: "Una boda, unos XV años o una celebración privada exigen menos escala que un festival, pero la misma profesionalidad y mayor discreción. SEPRIEV ofrece seguridad para eventos sociales con personal capaz de integrarse a la celebración y de resolver cualquier incidente sin convertirlo en el tema de la noche. Aquí el riesgo principal es que la seguridad rompa la atmósfera que el anfitrión tardó meses en construir.",
    features: [
      { title: "Control de lista de invitados", text: "SEPRIEV valida el ingreso contra la lista que define el anfitrión y gestiona con tacto los casos no contemplados, evitando tanto el acceso indebido como el momento incómodo frente a los demás. El control de quién entra es la base de la tranquilidad del cliente, en especial cuando la privacidad es parte del valor del evento." },
      { title: "Manejo discreto de incidentes", text: "Cuando surge una situación entre invitados, el equipo interviene con comunicación directa y sin escalar el tono, coordinando con el anfitrión en tiempo real para resolverla antes de que trascienda. El detalle de lo ocurrido se entrega al cliente al cierre, con la información que necesita y sin exponer la celebración." },
      { title: "Resguardo de valores y salidas", text: "El servicio contempla la protección de la mesa de regalos y objetos de valor, el control del estacionamiento y la coordinación de salidas al cierre, sin aglomeraciones. La llegada y la salida son los momentos de mayor vulnerabilidad de un evento social, y se planean con la misma seriedad que el resto del operativo." },
    ],
  },
  {
    title: "Eventos Deportivos",
    href: "/servicios/seguridad-eventos-deportivos/",
    hero: `${IMG}/seguridad-conciertos-multitud`,
    small1: `${IMG}/seguridad-conciertos-festivales`,
    small2: `${IMG}/guardias-seguridad-privada`,
    intro: "Un evento deportivo concentra tres retos que rara vez coinciden: aficiones con rivalidades, protagonistas que requieren protección y un marco normativo impuesto por federaciones y ligas. SEPRIEV integra los tres frentes en un solo operativo, porque atender uno solo deja expuestos a los demás. El cumplimiento no es accesorio: de él depende que el organizador conserve la sede.",
    features: [
      { title: "Gestión y separación de aficiones", text: "La separación de hinchadas rivales empieza antes del primer ingreso, con accesos, andenes y sectores diferenciados y zonas de amortiguamiento definidas con el organizador. SEPRIEV establece comunicación preventiva con los grupos de animación y diseña la circulación interna para evitar puntos de fricción: el trabajo previo pesa tanto como el del propio encuentro." },
      { title: "Protección de atletas y oficiales", text: "Deportistas, árbitros y cuerpo técnico tienen necesidades específicas de acceso, resguardo y traslado, cubiertas con personal asignado a zonas de competencia, vestidores y accesos restringidos. La protección se concentra en los momentos de mayor exposición —llegada, salida y traslados— donde la cercanía con el público cambia de tono en segundos." },
      { title: "Cumplimiento de protocolos de liga", text: "Cada federación o liga impone requisitos de seguridad que el organizador está obligado a cumplir. SEPRIEV conoce esos marcos, coordina con los delegados de seguridad del organismo correspondiente y documenta el operativo según el estándar exigido, de modo que el evento sea seguro, auditable y conforme a la normativa que lo rige." },
    ],
  },
  {
    title: "Eventos Masivos",
    href: "/servicios/seguridad-masivos/",
    badge: "Destacado",
    featured: true,
    hero: `${IMG}/centro-control-seguridad`,
    small1: `${IMG}/centro-monitoreo-cctv-eventos`,
    small2: `${IMG}/monitoreo-camaras-evento`,
    intro: "A partir de los 10,000 asistentes, la seguridad ya no se resuelve sumando elementos: se vuelve un problema de inteligencia operativa en tiempo real. SEPRIEV dirige operativos masivos con centro de comando propio, vigilancia aérea y mando unificado con las autoridades, articulado desde antes de que llegue el primer asistente. A esta escala, la diferencia la marca la información que llega a tiempo a quien decide y la capacidad de actuar sobre ella en segundos.",
    features: [
      { title: "Centro de comando e inteligencia", text: "El puesto de mando concentra el monitoreo de cámaras, la radio en múltiples canales y el enlace con autoridades en un solo punto de decisión. Desde ahí, SEPRIEV procesa lo que ocurre en todo el recinto y activa protocolos sin esperar a que cada situación escale, porque los roles y los umbrales de activación están definidos antes del evento." },
      { title: "Vigilancia aérea y densidad de aforo", text: "Drones con cámara de alta resolución y conteo de aforo ofrecen al centro de comando una visión de conjunto en tiempo real imposible de lograr desde tierra. Esto permite detectar acumulaciones peligrosas, medir la densidad por sector y redistribuir al personal antes de que una zona congestionada se convierta en una emergencia." },
      { title: "Mando unificado con autoridades", text: "Protección Civil, policía, bomberos y servicios médicos operan dentro de un mando unificado que SEPRIEV ayuda a articular antes del evento, con canal común, protocolo de escalamiento y roles ensayados. Ante incidentes simultáneos, la respuesta coordinada ya está lista y no depende de decisiones improvisadas." },
    ],
  },
  {
    title: "Montaje y Desmontaje",
    href: "/servicios/seguridad-montaje-desmontaje/",
    hero: `${IMG}/equipo-seguridad-eventos`,
    small1: `${IMG}/seguridad-empresarial-evento`,
    small2: `${IMG}/guardias-seguridad-privada`,
    intro: "El mayor riesgo de una producción no ocurre durante la función, sino en las horas de montaje y desmontaje, cuando se concentran los robos de equipo, los accesos no autorizados y los accidentes evitables. SEPRIEV cubre el ciclo completo del evento, del primer camión de producción al último técnico, precisamente porque son las horas en que la atención del organizador está más dividida. La seguridad del evento empieza mucho antes de que entre el público.",
    features: [
      { title: "Custodia continua del recinto", text: "El equipo de sonido, iluminación y escenografía permanece vigilado durante el montaje, los tiempos muertos y el desmontaje, con cobertura nocturna documentada para producciones de varios días. Cada mañana, el coordinador recibe un reporte de novedades antes de iniciar la jornada, con constancia del estado del recinto durante la noche." },
      { title: "Acreditación de proveedores y carga", text: "En un montaje circulan decenas de personas con distintos niveles de acceso y ventanas de tiempo. SEPRIEV verifica identidad y credenciales de cada proveedor, técnico y transportista contra una lista blanca actualizada con el cliente, y controla el andén de carga y descarga para que nada ni nadie entre o salga sin registro." },
      { title: "Inventario fotográfico y conciliación", text: "El equipo de alto valor se registra fotográficamente al ingreso y se concilia a la salida, lo que permite detectar faltantes o daños con evidencia y no con suposiciones. Este registro protege por igual al cliente y a los proveedores, al dejar constancia objetiva del estado en que cada activo entró y salió del recinto." },
    ],
  },
];
---

<BaseLayout
  title="Servicios de Seguridad para Eventos en México"
  description="10 servicios especializados de seguridad privada para eventos: conciertos, corporativos, ferias, VIP, deportivos y masivos. Licencia DGSSP, personal certificado STPS. Cotización en 24 hrs."
>
  <Breadcrumb items={[{ label: 'Servicios' }]} />

  <PageHero
    eyebrow="SEPRIEV — Nuestros servicios"
    titulo="Seguridad Especializada para Cada Tipo de Evento"
    subtitulo="10 servicios de seguridad privada para todo tipo de eventos, desde una boda íntima hasta un festival con 100,000 asistentes."
  >
    <Fragment slot="right">
      <p class="text-accent text-base leading-relaxed">
        Cada tipo de evento tiene necesidades de seguridad distintas. Nuestros <strong class="text-light font-semibold">10 servicios especializados</strong> cubren desde el control de acceso básico hasta la coordinación de seguridad masiva con drones, centro de comando y coordinación con Protección Civil. Todo el personal cuenta con <strong class="text-light font-semibold">licencia DGSSP y certificación STPS</strong>.
      </p>
      <p class="text-accent text-base leading-relaxed">
        Operamos con presencia local certificada en <strong class="text-light font-semibold">CDMX, Guadalajara, Monterrey, Puebla y Cancún</strong>, y con capacidad de despliegue en cualquier punto de la República Mexicana gracias a nuestra <strong class="text-light font-semibold">licencia federal vigente</strong>. Cotización gratuita y propuesta en menos de 24 horas.
      </p>
    </Fragment>
  </PageHero>

  <PageNav items={navItems} ariaLabel="Navegación de servicios" />

  <div class="w-full px-[5%] xl:px-[7%] py-16 lg:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {serviceCards.map((s: any) => (
        <ServiceCard
          icon={s.icon}
          title={s.title}
          description={s.desc}
          features={s.features}
          href={`/servicios/${s.slug}/`}
          image={servImg[s.slug]}
          badge={s.badge}
          featured={s.featured}
        />
      ))}
    </div>

    <div class="text-center mt-10">
      <a href="/cotizar/" class="inline-flex items-center gap-2 bg-secondary hover:bg-red-700 text-white px-8 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
        Solicitar Cotización
      </a>
    </div>

    <!-- Módulos detallados por servicio -->
    {serviceModules.map((m: any) => (
      <ServiceModule
        title={m.title}
        intro={m.intro}
        features={m.features}
        href={m.href}
        hero={m.hero}
        small1={m.small1}
        small2={m.small2}
        badge={m.badge}
        featured={m.featured}
      />
    ))}
  </div>

  <CTABanner
    titulo="¿No encuentras tu tipo de evento?"
    subtitulo="Tenemos experiencia en eventos de todo tipo. Cuéntanos sobre el tuyo y diseñamos un plan de seguridad a la medida."
  />
</BaseLayout>
