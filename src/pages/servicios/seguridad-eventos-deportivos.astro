---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import TrustBadges from '@components/TrustBadges.astro';

const title = "Seguridad para Eventos Deportivos y Estadios en Mexico";
const description = "Seguridad profesional para eventos deportivos y estadios. Control de barras, proteccion de atletas, gestion de aforo y protocolos anti-violencia.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Que protocolos anti-violencia aplican en eventos deportivos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Aplicamos protocolos de identificacion temprana de comportamientos agresivos, separacion fisica de aficiones rivales, control de ingreso de objetos peligrosos, monitoreo continuo de zonas conflictivas y coordinacion con fuerzas de seguridad publica para intervencion rapida cuando es necesario."
      }
    },
    {
      "@type": "Question",
      "name": "¿Como manejan la seguridad de barras y porras?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Implementamos separacion de grupos de aficionados desde el acceso al recinto, asignamos guardias especializados a las zonas de barras, controlamos el ingreso de elementos que puedan usarse como armas y establecemos corredores de seguridad entre sectores para evitar enfrentamientos."
      }
    },
    {
      "@type": "Question",
      "name": "¿Ofrecen seguridad para carreras y maratones?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, cubrimos eventos deportivos al aire libre como maratones, carreras ciclistas y triatlones. Incluimos seguridad en la ruta, puntos de hidratacion, zonas de meta, areas de premiacion y coordinacion con servicios medicos y de trafico para garantizar la seguridad de participantes y espectadores."
      }
    },
    {
      "@type": "Question",
      "name": "¿Protegen a los atletas y arbitros?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, asignamos personal dedicado a la proteccion de atletas, arbitros y cuerpo tecnico. Controlamos el acceso a vestidores, tuneles y areas de calentamiento, y coordinamos la entrada y salida segura del recinto, especialmente en partidos de alta rivalidad."
      }
    },
    {
      "@type": "Question",
      "name": "¿Coordinan con los servicios medicos del evento?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutamente. Nos coordinamos con paramedicos y servicios de emergencia para garantizar acceso rapido ante lesiones o emergencias medicas. Nuestro personal esta capacitado en primeros auxilios y conoce las rutas de evacuacion medica del recinto."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Eventos deportivos</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
          Seguridad para <span class="text-secondary">Eventos Deportivos</span>
        </h1>
        <p class="text-accent text-lg sm:text-xl leading-relaxed max-w-3xl">
          Proporcionamos seguridad especializada para eventos deportivos, estadios, arenas y competencias de todas las disciplinas. Nuestro equipo esta entrenado en manejo de aficionados, protocolos anti-violencia, control de barras, proteccion de atletas y coordinacion con servicios medicos de emergencia. Diseñamos operativos que garantizan la seguridad de jugadores, arbitros, cuerpo tecnico y espectadores, permitiendo que la pasion deportiva se viva en un entorno controlado y seguro. Con experiencia en eventos desde torneos locales hasta competencias de nivel profesional.
        </p>
      </div>
    </div>
  </section>

  <!-- En que consiste -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-black text-light mb-8">¿En que consiste la seguridad para eventos deportivos?</h2>
        <div class="prose prose-lg text-accent leading-relaxed space-y-4">
          <p>
            Los eventos deportivos presentan dinamicas de seguridad particulares derivadas de la pasion de los aficionados, la rivalidad entre equipos y la concentracion masiva de personas en espacios definidos. Nuestro servicio de seguridad para estadios y eventos deportivos esta diseñado para anticipar y gestionar estas situaciones con profesionalismo y experiencia.
          </p>
          <p>
            El control de acceso en eventos deportivos incluye la verificacion de boletos por sector, la deteccion de objetos prohibidos como bengalas, botellas de vidrio, paraguas con punta y cualquier elemento que pueda ser utilizado como arma. Nuestro personal esta especificamente entrenado para identificar aficionados en estado de ebriedad o con comportamiento agresivo antes de que ingresen al recinto, reduciendo significativamente los incidentes al interior.
          </p>
          <p>
            La gestion de barras y grupos de aficionados organizados es una de nuestras especialidades. Implementamos separacion de aficiones desde los accesos, asignamos guardias con experiencia en manejo de grupos a las zonas de animacion, establecemos corredores de seguridad entre sectores y mantenemos comunicacion directa con los lideres de las barras cuando es viable. Nuestro objetivo es permitir la expresion del aficionado dentro de limites seguros.
          </p>
          <p>
            La proteccion de atletas, arbitros y personal tecnico es prioritaria, especialmente en partidos de alta rivalidad. Controlamos el acceso a vestidores y zonas tecnicas, custodiamos los tuneles de acceso a la cancha y coordinamos la salida segura del equipo visitante. Nos coordinamos con servicios medicos para garantizar atencion inmediata ante lesiones y con proteccion civil para la gestion de evacuaciones si fuera necesario.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Beneficios principales</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
        {[
          "Protocolos anti-violencia con identificacion temprana de comportamientos agresivos",
          "Gestion especializada de barras y grupos de aficionados organizados",
          "Proteccion de atletas, arbitros y cuerpo tecnico en zonas restringidas",
          "Coordinacion con servicios medicos y de emergencia del recinto",
          "Control de aforo por sectores con monitoreo en tiempo real",
          "Seguridad en estacionamientos con patrullaje y prevencion de incidentes"
        ].map((beneficio) => (
          <li class="flex items-start gap-3 bg-primary/30 border border-primary-light/30 rounded-lg p-4">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-accent text-sm leading-relaxed">{beneficio}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipos de eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Para que tipo de eventos?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Partidos de futbol", ejemplo: "Liga profesional, torneos amateur, partidos de selecciones y amistosos internacionales." },
          { titulo: "Eventos de box y MMA", ejemplo: "Funciones de box, artes marciales mixtas y deportes de combate en arenas." },
          { titulo: "Carreras y maratones", ejemplo: "Maratones urbanos, carreras ciclistas, triatlones y competencias en ruta." },
          { titulo: "Torneos de tenis y golf", ejemplo: "Competencias con publico en gradas, galeria y areas de hospitality." },
          { titulo: "Eventos ecuestres", ejemplo: "Carreras de caballos, rodeos y competencias ecuestres con areas de apuestas." },
          { titulo: "Competencias de esports", ejemplo: "Torneos de videojuegos en arenas con publico presencial y transmision en vivo." }
        ].map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/30 rounded-lg p-5">
            <h3 class="text-light font-bold text-base mb-2">{tipo.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.ejemplo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Nuestro proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        {[
          { paso: "01", titulo: "Evaluacion del recinto", desc: "Analizamos el estadio o venue, identificamos sectores, rutas de evacuacion y puntos conflictivos segun el historial del evento." },
          { paso: "02", titulo: "Operativo deportivo", desc: "Diseñamos la distribucion de personal por sector, protocolos de barras, proteccion de equipos y coordinacion con autoridades." },
          { paso: "03", titulo: "Ejecucion y monitoreo", desc: "Desplegamos guardias en accesos, sectores, estacionamientos y zonas tecnicas con comunicacion en tiempo real." },
          { paso: "04", titulo: "Evacuacion y reporte", desc: "Coordinamos la salida segura del publico, protegemos la salida de equipos y entregamos el reporte de incidencias." }
        ].map((item) => (
          <div class="relative bg-primary/30 border border-primary-light/30 rounded-lg p-6">
            <span class="text-secondary font-black text-3xl opacity-30">{item.paso}</span>
            <h3 class="text-light font-bold text-base mt-2 mb-2">{item.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por que elegirnos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Por que elegir SeguridadEventos?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Especializacion deportiva", desc: "Personal entrenado especificamente en manejo de aficionados, control de barras y dinamicas propias de eventos deportivos." },
          { titulo: "Coordinacion interinstitucional", desc: "Trabajamos en conjunto con proteccion civil, servicios medicos, policia y la administracion del recinto deportivo." },
          { titulo: "Prevencion basada en datos", desc: "Analizamos el historial de incidentes del evento y del recinto para anticipar situaciones y reforzar puntos criticos." }
        ].map((dif) => (
          <div class="bg-primary/30 border border-secondary/20 rounded-lg p-6">
            <h3 class="text-light font-bold text-base mb-3">{dif.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{dif.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Preguntas frecuentes sobre seguridad deportiva</h2>
      <div class="max-w-3xl space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-primary/30 border border-primary-light/30 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-light font-semibold text-sm sm:text-base">
              {faq.name}
              <svg class="w-5 h-5 text-secondary flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-accent text-sm leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner titulo="¿Necesitas seguridad para tu evento deportivo?" subtitulo="Cotizacion personalizada en menos de 24 horas. Sin compromiso." />
</BaseLayout>
