        <ServiceCard title="Dress Code Adaptable" description="Vestimenta del personal a la medida de la imagen del evento, de la etiqueta formal al bajo perfil de civil." features={["Imagen institucional", "Niveles de vestimenta", "Integración discreta"]} href="/servicios/seguridad-eventos-corporativos/dress-code-adaptable/" image={`${IMG}/equipo-seguridad-eventos`} badge="Subcategoría" />
        <ServiceCard title="Confidencialidad (NDA)" description="Acuerdo de no divulgación para todo el personal, con gobernanza de la información y consecuencias reales." features={["NDA estándar", "Need-to-know", "Personal verificado"]} href="/servicios/seguridad-eventos-corporativos/confidencialidad-nda/" image={`${IMG}/seguridad-eventos-corporativos`} badge="Subcategoría" />
      </div>
    </div>
