---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import TrustBadges from '@components/TrustBadges.astro';

const title = "Seguridad para Eventos Corporativos, Congresos y Convenciones";
const description = "Seguridad profesional para eventos corporativos, congresos y convenciones. Control de acceso, proteccion ejecutiva y vigilancia discreta para empresas.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Que incluye la seguridad para eventos corporativos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestro servicio incluye control de acceso con verificacion de credenciales, vigilancia perimetral, monitoreo de areas restringidas, proteccion ejecutiva para directivos, seguridad en estacionamientos y coordinacion con el equipo organizador para mantener un ambiente profesional y seguro."
      }
    },
    {
      "@type": "Question",
      "name": "¿Manejan seguridad para congresos de varios dias?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, ofrecemos cobertura continua para congresos y convenciones de multiples dias. Incluimos turnos rotativos, control de acceso por jornada, vigilancia nocturna de instalaciones y equipo, y coordinacion permanente con el comite organizador del congreso."
      }
    },
    {
      "@type": "Question",
      "name": "¿La seguridad es discreta en eventos empresariales?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutamente. Nuestro personal se adapta al dress code del evento corporativo. Podemos operar con uniforme formal, traje ejecutivo o vestimenta casual segun lo requiera el cliente, manteniendo siempre una presencia profesional que no interfiera con la dinamica del evento."
      }
    },
    {
      "@type": "Question",
      "name": "¿Ofrecen seguridad para lanzamientos de productos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, contamos con protocolos especificos para lanzamientos de productos que incluyen proteccion de prototipos y material confidencial, control de acceso exclusivo para prensa e invitados, vigilancia de exhibiciones y coordinacion con el equipo de relaciones publicas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Como garantizan la confidencialidad en juntas directivas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Todo nuestro personal firma acuerdos de confidencialidad. Implementamos control de acceso estricto a salas de reunion, verificamos que no haya dispositivos de grabacion no autorizados y mantenemos perimetros de seguridad que evitan el acceso de personas no autorizadas."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Seguridad corporativa</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
          Seguridad para <span class="text-secondary">Eventos Corporativos</span>
        </h1>
        <p class="text-accent text-lg sm:text-xl leading-relaxed max-w-3xl">
          Brindamos seguridad discreta y profesional para eventos corporativos, congresos, convenciones y reuniones empresariales. Nuestro equipo se especializa en proteger entornos de negocios donde la confidencialidad, el control de acceso y la imagen corporativa son prioridad. Desde lanzamientos de producto hasta juntas directivas de alto nivel, cada operativo se adapta a las exigencias del mundo empresarial. Contamos con personal capacitado en protocolo ejecutivo, tecnologia de verificacion de credenciales y coordinacion con equipos organizadores para garantizar eventos seguros sin interrupciones.
        </p>
      </div>
    </div>
  </section>

  <!-- En que consiste -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-black text-light mb-8">¿En que consiste la seguridad para eventos corporativos?</h2>
        <div class="prose prose-lg text-accent leading-relaxed space-y-4">
          <p>
            La seguridad en eventos corporativos requiere un enfoque especializado que combine eficacia con discrecion. Nuestro servicio comienza con una evaluacion detallada de las necesidades del cliente: tipo de evento, perfil de asistentes, nivel de confidencialidad requerido y caracteristicas del recinto. Con esta informacion diseñamos un plan de seguridad que protege personas, informacion y activos sin afectar la dinamica empresarial.
          </p>
          <p>
            Para congresos y convenciones, implementamos sistemas de control de acceso multinivel que gestionan diferentes categorias de asistentes: ponentes, patrocinadores, prensa, asistentes generales y personal de servicio. Cada categoria recibe credenciales con permisos especificos que nuestro personal verifica en cada punto de acceso. Esto garantiza que solo personas autorizadas ingresen a areas restringidas como salas de prensa, zonas de networking exclusivo o areas de exhibicion privada.
          </p>
          <p>
            En lanzamientos de productos y eventos de marca, nuestro equipo se encarga de proteger material confidencial, prototipos y exhibiciones de alto valor. Coordinamos estrechamente con los equipos de marketing y relaciones publicas para que las medidas de seguridad complementen la experiencia del evento en lugar de obstaculizarla. Nuestros guardias se presentan con vestimenta acorde al codigo del evento, desde traje ejecutivo hasta uniforme corporativo personalizado.
          </p>
          <p>
            Para reuniones de alto nivel y juntas directivas, ofrecemos proteccion ejecutiva con escoltas de proximidad, barrido previo de salas de reunion, control de acceso biometrico cuando se requiere, y perimetros de seguridad que aseguran total privacidad. Todo nuestro personal firma acuerdos de confidencialidad y esta entrenado en protocolo empresarial.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Beneficios principales</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
        {[
          "Control de acceso multinivel con credenciales y verificacion digital",
          "Personal con protocolo ejecutivo y adaptacion al dress code corporativo",
          "Proteccion de informacion confidencial y material de alto valor",
          "Coordinacion con equipos de organizacion, marketing y relaciones publicas",
          "Proteccion ejecutiva para directivos, ponentes y personalidades invitadas",
          "Acuerdos de confidencialidad firmados por todo el personal de seguridad"
        ].map((beneficio) => (
          <li class="flex items-start gap-3 bg-primary/30 border border-primary-light/30 rounded-lg p-4">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-accent text-sm leading-relaxed">{beneficio}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipos de eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Para que tipo de eventos?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Congresos y convenciones", ejemplo: "Eventos de multiples dias con ponencias, talleres y zonas de exhibicion." },
          { titulo: "Lanzamientos de producto", ejemplo: "Presentaciones de marca con proteccion de prototipos y material exclusivo." },
          { titulo: "Juntas directivas", ejemplo: "Reuniones de alto nivel con maxima confidencialidad y acceso restringido." },
          { titulo: "Seminarios y conferencias", ejemplo: "Eventos academicos y profesionales con control de asistentes y ponentes." },
          { titulo: "Cenas y galas corporativas", ejemplo: "Eventos sociales empresariales con seguridad discreta y protocolo." },
          { titulo: "Ferias de empleo", ejemplo: "Eventos con alto flujo de visitantes y multiples stands corporativos." }
        ].map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/30 rounded-lg p-5">
            <h3 class="text-light font-bold text-base mb-2">{tipo.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.ejemplo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Nuestro proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        {[
          { paso: "01", titulo: "Reunion con el cliente", desc: "Entendemos los objetivos del evento, perfil de asistentes, nivel de confidencialidad y requerimientos especificos de la empresa." },
          { paso: "02", titulo: "Plan de seguridad corporativo", desc: "Diseñamos el operativo con control de acceso, zonas restringidas, protocolo de vestimenta y coordinacion con el equipo organizador." },
          { paso: "03", titulo: "Ejecucion profesional", desc: "Desplegamos personal capacitado en protocolo ejecutivo, con comunicacion cifrada y supervision en tiempo real." },
          { paso: "04", titulo: "Reporte ejecutivo", desc: "Entregamos un informe profesional con metricas, incidencias y recomendaciones de mejora para futuros eventos corporativos." }
        ].map((item) => (
          <div class="relative bg-primary/30 border border-primary-light/30 rounded-lg p-6">
            <span class="text-secondary font-black text-3xl opacity-30">{item.paso}</span>
            <h3 class="text-light font-bold text-base mt-2 mb-2">{item.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por que elegirnos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Por que elegir SeguridadEventos?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Protocolo empresarial", desc: "Nuestro personal esta capacitado en etiqueta corporativa y se adapta al nivel de formalidad que requiere cada evento de negocios." },
          { titulo: "Confidencialidad garantizada", desc: "Acuerdos de confidencialidad, control de dispositivos y perimetros de privacidad para reuniones de alto nivel." },
          { titulo: "Experiencia con grandes marcas", desc: "Hemos protegido eventos de empresas nacionales e internacionales con los mas altos estandares de calidad y profesionalismo." }
        ].map((dif) => (
          <div class="bg-primary/30 border border-secondary/20 rounded-lg p-6">
            <h3 class="text-light font-bold text-base mb-3">{dif.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{dif.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Preguntas frecuentes sobre seguridad corporativa</h2>
      <div class="max-w-3xl space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-primary/30 border border-primary-light/30 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-light font-semibold text-sm sm:text-base">
              {faq.name}
              <svg class="w-5 h-5 text-secondary flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-accent text-sm leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner titulo="¿Necesitas seguridad para tu evento corporativo?" subtitulo="Cotizacion personalizada en menos de 24 horas. Sin compromiso." />
</BaseLayout>
