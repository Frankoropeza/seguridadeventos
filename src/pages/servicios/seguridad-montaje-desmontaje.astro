---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import TrustBadges from '@components/TrustBadges.astro';

const title = "Seguridad en Montaje y Desmontaje de Eventos";
const description = "Seguridad y vigilancia durante el montaje y desmontaje de eventos. Proteccion de equipos, control de contratistas, vigilancia nocturna y prevencion de robos.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Por que es importante la seguridad durante el montaje de un evento?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Durante el montaje ingresan multiples proveedores con equipos de alto valor como sonido, iluminacion, pantallas y estructuras. Sin control de acceso adecuado, existe riesgo de robo, daño a equipos y acceso de personas no autorizadas. La seguridad en esta fase protege la inversion del organizador."
      }
    },
    {
      "@type": "Question",
      "name": "¿Ofrecen vigilancia nocturna durante el montaje?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, proporcionamos vigilancia nocturna con guardias rotativos que custodian el recinto y los equipos durante las horas en que no hay personal de montaje. Incluimos rondines programados, control de acceso para personal nocturno y reporte de novedades al amanecer."
      }
    },
    {
      "@type": "Question",
      "name": "¿Como controlan el acceso de proveedores y contratistas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Implementamos un sistema de registro de proveedores donde cada empresa y persona es verificada contra una lista autorizada por el organizador. Emitimos credenciales temporales, registramos horarios de ingreso y salida, y verificamos que solo ingrese personal autorizado al area de montaje."
      }
    },
    {
      "@type": "Question",
      "name": "¿Manejan inventario de equipos que ingresan y salen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, llevamos un registro detallado de los equipos que cada proveedor ingresa al venue, incluyendo descripcion, cantidad y numero de serie cuando aplica. Durante el desmontaje, verificamos que cada proveedor retire unicamente sus propios equipos, previniendo confusiones y robos."
      }
    },
    {
      "@type": "Question",
      "name": "¿La seguridad en desmontaje incluye custodia de equipos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si, durante el desmontaje custodiamos los equipos mientras esperan ser cargados, vigilamos las zonas de carga y verificamos la salida de vehiculos con su cargamento correspondiente. Este servicio es especialmente importante cuando el desmontaje se extiende por varios dias."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Montaje y desmontaje</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
          Seguridad en <span class="text-secondary">Montaje y Desmontaje</span>
        </h1>
        <p class="text-accent text-lg sm:text-xl leading-relaxed max-w-3xl">
          Protegemos las fases de montaje y desmontaje de eventos con vigilancia especializada, control de acceso para contratistas, custodia de equipos de alto valor, vigilancia nocturna y gestion de inventarios. Estas etapas son criticas porque involucran el ingreso y salida de equipos costosos de sonido, iluminacion, video y estructura por parte de multiples proveedores. Nuestro equipo garantiza que cada pieza de equipo este protegida y que solo personal autorizado acceda al area de trabajo, previniendo robos, daños y perdidas.
        </p>
      </div>
    </div>
  </section>

  <!-- En que consiste -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-black text-light mb-8">¿En que consiste la seguridad en montaje y desmontaje?</h2>
        <div class="prose prose-lg text-accent leading-relaxed space-y-4">
          <p>
            El montaje y desmontaje de eventos es una fase vulnerable que frecuentemente se pasa por alto en los planes de seguridad. Durante estas etapas, equipos valorados en millones de pesos ingresan y salen del recinto: sistemas de sonido profesional, pantallas LED, equipos de iluminacion, estructuras de escenario, mobiliario y decoracion. Multiples proveedores trabajan simultaneamente, creando un entorno caotico donde los robos y daños son mas probables.
          </p>
          <p>
            Nuestro servicio de seguridad en montaje comienza con el establecimiento de un punto de control de acceso donde cada proveedor y contratista se registra. Verificamos la identidad del personal contra una lista autorizada por el organizador del evento, emitimos credenciales temporales y registramos los horarios de entrada y salida de cada persona. Esto nos permite saber exactamente quien esta dentro del recinto en todo momento.
          </p>
          <p>
            El control de inventario de equipos es un componente esencial. Registramos cada pieza de equipo que ingresa, incluyendo la empresa propietaria, descripcion del equipo, cantidad y numeros de serie cuando estan disponibles. Durante el desmontaje, verificamos que cada proveedor retire exclusivamente sus propios equipos, evitando confusiones y sustraccion de material ajeno. Este registro tambien sirve como evidencia en caso de reclamaciones.
          </p>
          <p>
            La vigilancia nocturna es critica cuando el montaje o desmontaje se extiende por varios dias. Nuestros guardias nocturnos realizan rondines programados por todo el recinto, verifican que puertas y accesos esten asegurados, monitorean las areas donde se almacenan equipos y reportan cualquier novedad al supervisor. Al amanecer, entregan un reporte detallado al turno diurno para garantizar continuidad en la custodia.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Beneficios principales</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
        {[
          "Control de acceso para proveedores y contratistas con credenciales temporales",
          "Registro de inventario de equipos con verificacion en ingreso y salida",
          "Vigilancia nocturna con rondines programados y reporte de novedades",
          "Custodia de equipos de alto valor durante periodos de inactividad",
          "Prevencion de robos y sustraccion de material durante el desmontaje",
          "Verificacion de cargamentos en la salida de vehiculos del recinto"
        ].map((beneficio) => (
          <li class="flex items-start gap-3 bg-primary/30 border border-primary-light/30 rounded-lg p-4">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-accent text-sm leading-relaxed">{beneficio}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipos de eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Para que tipo de eventos?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Conciertos y festivales", ejemplo: "Montaje de escenarios, sistemas de sonido e iluminacion de gran escala." },
          { titulo: "Exposiciones y ferias", ejemplo: "Construccion de stands, instalacion de exhibiciones y material promocional." },
          { titulo: "Eventos corporativos", ejemplo: "Montaje de salas de conferencia, tecnologia audiovisual y branding." },
          { titulo: "Producciones de television", ejemplo: "Instalacion de sets, camaras, iluminacion y equipos de transmision." },
          { titulo: "Eventos deportivos", ejemplo: "Montaje de gradas temporales, pantallas y equipo de cronometraje." },
          { titulo: "Bodas y eventos sociales", ejemplo: "Instalacion de decoracion, mobiliario, iluminacion y equipo de banquete." }
        ].map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/30 rounded-lg p-5">
            <h3 class="text-light font-bold text-base mb-2">{tipo.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.ejemplo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Nuestro proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        {[
          { paso: "01", titulo: "Lista de proveedores", desc: "Recibimos del organizador la lista de proveedores autorizados con personal, vehiculos y equipos esperados para cada uno." },
          { paso: "02", titulo: "Control de ingreso", desc: "Verificamos identidad, registramos equipos, emitimos credenciales y controlamos el acceso al area de montaje." },
          { paso: "03", titulo: "Vigilancia continua", desc: "Custodiamos el recinto con turnos diurnos y nocturnos, rondines programados y monitoreo de areas de almacenamiento." },
          { paso: "04", titulo: "Control de salida", desc: "Verificamos que cada proveedor retire solo sus equipos, registramos la salida de vehiculos y entregamos reporte final." }
        ].map((item) => (
          <div class="relative bg-primary/30 border border-primary-light/30 rounded-lg p-6">
            <span class="text-secondary font-black text-3xl opacity-30">{item.paso}</span>
            <h3 class="text-light font-bold text-base mt-2 mb-2">{item.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por que elegirnos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Por que elegir SeguridadEventos?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Proteccion de activos", desc: "Protocolos especificos para custodiar equipos de sonido, iluminacion, video y estructura valorados en millones de pesos." },
          { titulo: "Control documental", desc: "Registros detallados de personal, equipos y vehiculos que sirven como evidencia y facilitan reclamaciones ante incidentes." },
          { titulo: "Cobertura 24 horas", desc: "Turnos diurnos y nocturnos con relevos coordinados para que el recinto nunca quede sin vigilancia durante montaje y desmontaje." }
        ].map((dif) => (
          <div class="bg-primary/30 border border-secondary/20 rounded-lg p-6">
            <h3 class="text-light font-bold text-base mb-3">{dif.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{dif.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Preguntas frecuentes sobre seguridad en montaje</h2>
      <div class="max-w-3xl space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-primary/30 border border-primary-light/30 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-light font-semibold text-sm sm:text-base">
              {faq.name}
              <svg class="w-5 h-5 text-secondary flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-accent text-sm leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner titulo="¿Necesitas seguridad para el montaje de tu evento?" subtitulo="Cotizacion personalizada en menos de 24 horas. Sin compromiso." />
</BaseLayout>
