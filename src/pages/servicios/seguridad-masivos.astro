---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import TrustBadges from '@components/TrustBadges.astro';

const title = "Seguridad para Eventos Masivos | +10,000 Asistentes";
const description = "Seguridad para eventos masivos con mas de 10,000 asistentes. Gestion de multitudes, protocolos de emergencia, comunicacion avanzada y seguridad multizona.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Que se considera un evento masivo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Un evento masivo es aquel que concentra a mas de 10,000 personas en un mismo espacio. Incluye festivales, conciertos en estadios, marchas, eventos civicos, celebraciones patrias y cualquier congregacion publica de gran escala que requiere protocolos de seguridad especializados."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuantos guardias se necesitan para un evento masivo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La proporcion depende del tipo de evento y nivel de riesgo. Como referencia, para un evento masivo al aire libre recomendamos un guardia por cada 50 a 75 asistentes, mas personal de supervision, coordinacion y reserva. Realizamos un calculo preciso basado en el analisis de riesgo especifico."
      }
    },
    {
      "@type": "Question",
      "name": "¿Que sistemas de comunicacion utilizan en eventos masivos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Utilizamos redes de radio digital cifrada con canales dedicados por zona, un centro de mando con monitoreo visual, comunicacion directa con autoridades y servicios de emergencia, y sistemas de alerta masiva para coordinacion rapida del operativo completo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Como gestionan una evacuacion de emergencia masiva?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Contamos con planes de evacuacion diseñados especificamente para cada evento que incluyen rutas señalizadas, personal guia en cada zona, puntos de reunion seguros, coordinacion con bomberos y proteccion civil, y simulacros previos al evento cuando la escala lo requiere."
      }
    },
    {
      "@type": "Question",
      "name": "¿Se coordinan con las autoridades para eventos masivos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Es obligatorio. Para eventos masivos coordinamos con proteccion civil municipal y estatal, policia local, bomberos, servicios medicos de emergencia y en algunos casos con la Guardia Nacional. Presentamos planes de seguridad ante las autoridades y operamos bajo su supervision."
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>

  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Eventos masivos</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
          Seguridad para <span class="text-secondary">Eventos Masivos</span>
        </h1>
        <p class="text-accent text-lg sm:text-xl leading-relaxed max-w-3xl">
          Diseñamos y ejecutamos operativos de seguridad para eventos masivos con mas de 10,000 asistentes. Nuestro equipo domina la ciencia del manejo de multitudes, implementa sistemas de comunicacion avanzados, desarrolla protocolos de emergencia y evacuacion, y coordina operativos multizona con decenas de elementos. Cada evento masivo requiere un enfoque de ingenieria de seguridad que considere densidad de publico, flujos de movimiento, puntos de congestion y tiempos de evacuacion. Trabajamos en coordinacion directa con proteccion civil y autoridades.
        </p>
      </div>
    </div>
  </section>

  <!-- En que consiste -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <h2 class="text-3xl sm:text-4xl font-black text-light mb-8">¿En que consiste la seguridad para eventos masivos?</h2>
        <div class="prose prose-lg text-accent leading-relaxed space-y-4">
          <p>
            La seguridad en eventos masivos es una disciplina que combina logistica militar, ingenieria de multitudes y coordinacion interinstitucional. Cuando mas de 10,000 personas se concentran en un espacio, los riesgos se multiplican exponencialmente: estampidas, aplastamientos, emergencias medicas masivas, incendios y situaciones de panico requieren una planificacion meticulosa y una ejecucion impecable.
          </p>
          <p>
            Nuestro proceso comienza meses antes del evento con un estudio detallado del espacio. Calculamos la densidad maxima segura por metro cuadrado en cada zona, diseñamos flujos de entrada y salida que eviten cuellos de botella, ubicamos barreras de contencion certificadas y definimos puntos de descompresion donde las multitudes pueden dispersarse de forma segura. Utilizamos modelos de simulacion de flujos de personas para validar nuestro diseño antes de la implementacion.
          </p>
          <p>
            La comunicacion es el eje central de cualquier operativo masivo. Operamos con redes de radio digital cifrada que asignan canales dedicados a cada zona del evento. Un centro de mando centralizado monitorea todas las comunicaciones, recibe reportes de situacion de cada sector y coordina la respuesta ante incidentes. Mantenemos lineas directas con proteccion civil, bomberos y servicios medicos de emergencia para activar protocolos de forma inmediata.
          </p>
          <p>
            La seguridad multizona divide el evento en sectores independientes, cada uno con su propio equipo de guardias, supervisor y canales de comunicacion. Esto permite aislar incidentes sin afectar al resto del evento y facilita la gestion de evacuaciones parciales o totales. Cada zona tiene rutas de evacuacion señalizadas, personal guia capacitado y puntos de reunion predefinidos. Al finalizar, entregamos un informe detallado con metricas de aforo, tiempos de evacuacion y analisis de incidentes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Beneficios -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Beneficios principales</h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
        {[
          "Gestion de multitudes basada en ingenieria de flujos y densidad de publico",
          "Sistemas de comunicacion cifrada con centro de mando centralizado",
          "Protocolos de evacuacion diseñados y validados con simulaciones previas",
          "Seguridad multizona con equipos independientes por sector del evento",
          "Coordinacion directa con proteccion civil, bomberos y servicios de emergencia",
          "Barreras de contencion certificadas y puntos de descompresion planificados"
        ].map((beneficio) => (
          <li class="flex items-start gap-3 bg-primary/30 border border-primary-light/30 rounded-lg p-4">
            <svg class="w-6 h-6 text-green-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <span class="text-accent text-sm leading-relaxed">{beneficio}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Tipos de eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Para que tipo de eventos?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Festivales musicales masivos", ejemplo: "Eventos de multiples dias con decenas de miles de asistentes y varios escenarios." },
          { titulo: "Conciertos en estadios", ejemplo: "Presentaciones musicales en recintos con capacidad de 30,000 a 100,000 personas." },
          { titulo: "Celebraciones civicas", ejemplo: "Eventos patrios, desfiles, celebraciones de fin de año y fiestas populares." },
          { titulo: "Marchas y manifestaciones", ejemplo: "Eventos de expresion publica con rutas definidas y puntos de concentracion." },
          { titulo: "Eventos religiosos masivos", ejemplo: "Peregrinaciones, celebraciones y eventos de fe con alta concentracion de fieles." },
          { titulo: "Competencias deportivas", ejemplo: "Finales de liga, competencias internacionales y eventos olimpicos." }
        ].map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/30 rounded-lg p-5">
            <h3 class="text-light font-bold text-base mb-2">{tipo.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.ejemplo}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Proceso -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Nuestro proceso</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl">
        {[
          { paso: "01", titulo: "Ingenieria de seguridad", desc: "Estudiamos el espacio, calculamos densidades, diseñamos flujos y simulamos escenarios de emergencia semanas antes del evento." },
          { paso: "02", titulo: "Plan maestro de seguridad", desc: "Creamos el operativo multizona con distribucion de personal, comunicaciones, protocolos de emergencia y coordinacion institucional." },
          { paso: "03", titulo: "Despliegue masivo", desc: "Posicionamos decenas de elementos por zona con supervisores, centro de mando y comunicacion cifrada en tiempo real." },
          { paso: "04", titulo: "Analisis post-evento", desc: "Generamos un reporte exhaustivo con metricas de aforo, tiempos de respuesta, incidencias y mejoras para futuros eventos." }
        ].map((item) => (
          <div class="relative bg-primary/30 border border-primary-light/30 rounded-lg p-6">
            <span class="text-secondary font-black text-3xl opacity-30">{item.paso}</span>
            <h3 class="text-light font-bold text-base mt-2 mb-2">{item.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Por que elegirnos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">¿Por que elegir SeguridadEventos?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl">
        {[
          { titulo: "Capacidad operativa", desc: "Contamos con la infraestructura humana y tecnologica para desplegar operativos de gran escala con cientos de elementos." },
          { titulo: "Ciencia de multitudes", desc: "Aplicamos principios de ingenieria de flujos, densidad y comportamiento colectivo para diseñar entornos seguros." },
          { titulo: "Relacion institucional", desc: "Coordinamos con proteccion civil, bomberos, servicios medicos y fuerzas de seguridad publica en cada evento masivo." }
        ].map((dif) => (
          <div class="bg-primary/30 border border-secondary/20 rounded-lg p-6">
            <h3 class="text-light font-bold text-base mb-3">{dif.titulo}</h3>
            <p class="text-accent text-sm leading-relaxed">{dif.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-primary/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl sm:text-4xl font-black text-light mb-10">Preguntas frecuentes sobre seguridad masiva</h2>
      <div class="max-w-3xl space-y-4">
        {faqSchema.mainEntity.map((faq) => (
          <details class="group bg-primary/30 border border-primary-light/30 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-light font-semibold text-sm sm:text-base">
              {faq.name}
              <svg class="w-5 h-5 text-secondary flex-shrink-0 ml-4 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </summary>
            <div class="px-5 pb-5 text-accent text-sm leading-relaxed">
              {faq.acceptedAnswer.text}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <TrustBadges />
  <CTABanner titulo="¿Necesitas seguridad para un evento masivo?" subtitulo="Cotizacion personalizada en menos de 24 horas. Sin compromiso." />
</BaseLayout>
