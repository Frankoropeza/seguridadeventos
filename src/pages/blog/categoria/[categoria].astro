---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import BlogSidebar from '@/components/BlogSidebar.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { catSlug } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: { data: { draft: boolean } }) => !data.draft);
  const cats = [...new Set(posts.map((p: any) => p.data.categoria || 'Blog'))];
  return cats.map((cat) => ({
    params: { categoria: catSlug(cat as string) },
    props: { categoria: cat as string },
  }));
}

const { categoria } = Astro.props;
const posts = await getCollection('blog', ({ data }: { data: { draft: boolean } }) => !data.draft);
const catPosts = posts.filter((p: any) => (p.data.categoria || 'Blog') === categoria);

const categoryCounts: Record<string, number> = {};
posts.forEach((p: any) => {
  const cat = p.data.categoria || 'Blog';
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});
const categories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title={`${categoria} — Blog de seguridad para eventos`}
  description={`Artículos de la categoría ${categoria}: guías y análisis de SEPRIEV sobre seguridad privada para eventos en México.`}
>

  <Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: categoria }]} />

  <!-- ── ENCABEZADO ── -->
  <section class="w-full px-[5%] xl:px-[7%] pt-14 pb-10 border-b border-white/8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
      <div>
        <span class="inline-flex items-center gap-2 text-secondary text-xs font-bold uppercase tracking-[0.3em] mb-5">
          <span class="w-6 h-px bg-secondary"></span>
          Categoría
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-light leading-tight tracking-tight">
          {categoria}
        </h1>
        <p class="text-accent text-sm mt-4">
          {catPosts.length} {catPosts.length === 1 ? 'artículo' : 'artículos'} en esta categoría
        </p>
      </div>
      <div class="flex flex-col justify-center gap-4 lg:pt-2">
        <p class="text-accent text-sm leading-relaxed">
          Filtra por otra categoría o vuelve al listado completo para explorar todos nuestros artículos de seguridad para eventos.
        </p>
        <div class="flex flex-wrap gap-2">
          <a href="/blog" class="px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wide bg-white/5 text-accent border border-white/10 hover:border-secondary/40 hover:text-light transition-colors">
            Todos ({posts.length})
          </a>
          {categories.map(([cat, count]) => (
            <a
              href={`/blog/categoria/${catSlug(cat)}`}
              class={`px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wide border transition-colors ${cat === categoria ? 'bg-secondary text-white border-secondary' : 'bg-white/5 text-accent border-white/10 hover:border-secondary/40 hover:text-light'}`}
            >
              {cat} ({count})
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── GRID + SIDEBAR ── -->
  <section class="w-full px-[5%] xl:px-[7%] py-14 pb-20">
    <div class="flex flex-col lg:flex-row gap-10 items-start">
      <div class="flex-1 min-w-0">
        {catPosts.length === 0 ? (
          <div class="text-center py-20">
            <p class="text-accent text-lg">No hay artículos en esta categoría todavía.</p>
            <a href="/blog" class="inline-flex items-center gap-2 text-secondary hover:text-red-400 font-bold text-sm uppercase tracking-wide mt-4">Ver todos los artículos →</a>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
            {catPosts.map((post: any) => (
              <BlogCard
                titulo={post.data.title}
                descripcion={post.data.description}
                slug={post.id}
                categoria={post.data.categoria}
                imagen={post.data.imagen}
                readTime={post.data.readTime}
              />
            ))}
          </div>
        )}
      </div>

      <div class="w-full lg:w-[300px] xl:w-[320px] flex-shrink-0 lg:sticky lg:top-24">
        <BlogSidebar />
      </div>
    </div>
  </section>

</BaseLayout>
