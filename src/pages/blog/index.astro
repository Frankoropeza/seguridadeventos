---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Blog"
  description="Artículos y guías sobre seguridad para eventos, control de acceso, protección VIP y más."
>
  <section class="pt-28 pb-20 bg-dark min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Recursos</span>
        <h1 class="text-3xl sm:text-4xl font-black text-light mt-2">Blog de Seguridad</h1>
        <p class="text-accent mt-4 max-w-2xl">
          Consejos, guías y análisis sobre seguridad en eventos por nuestros expertos.
        </p>
      </div>

      {posts.length === 0 ? (
        <p class="text-accent">Próximamente publicaremos contenido. Vuelve pronto.</p>
      ) : (
        <div class="space-y-6">
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="block bg-primary/20 border border-primary/40 rounded-xl p-6 hover:border-secondary/30 transition-all group"
            >
              <div class="flex items-center gap-3 mb-3">
                <span class="bg-secondary/10 text-secondary text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">
                  {post.data.category}
                </span>
                <time class="text-accent text-xs" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('es-MX', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h2 class="text-xl font-bold text-light group-hover:text-secondary transition-colors mb-2">
                {post.data.title}
              </h2>
              <p class="text-accent text-sm leading-relaxed">{post.data.description}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
