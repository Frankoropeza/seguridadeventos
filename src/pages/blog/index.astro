---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }: { data: { draft: boolean } }) => !data.draft));
---

<BaseLayout
  title="Blog de Seguridad para Eventos — Guias y Consejos"
  description="Articulos especializados sobre seguridad en eventos, control de acceso, proteccion VIP y planificacion de seguridad para todo tipo de eventos en Mexico."
>
  <div class="w-full px-[5%] xl:px-[7%] py-16 lg:py-20">
    <div class="text-center mb-14">
      <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Recursos y conocimiento</span>
      <h1 class="text-3xl sm:text-4xl font-black text-light mt-2">Blog de Seguridad para Eventos</h1>
      <p class="text-accent mt-4 max-w-2xl mx-auto">
        Guias practicas, consejos de expertos y analisis del sector de seguridad privada para eventos en Mexico.
      </p>
    </div>

    {posts.length === 0 ? (
      <div class="text-center py-20">
        <p class="text-accent text-lg">Proximamente publicaremos contenido especializado. Vuelve pronto.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post: any) => (
          <BlogCard
            titulo={post.data.title}
            descripcion={post.data.description}
            slug={post.slug}
            categoria={post.data.category}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
