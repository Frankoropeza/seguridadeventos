---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '@/lib/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }: { data: { draft: boolean } }) => !data.draft);
  return posts.map((post: CollectionEntry<'blog'>) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const canonical = `${SITE}/blog/${post.id}`;
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  metaTitle={post.data.metaTitle}
  metaDescription={post.data.metaDescription}
  categoria={post.data.categoria}
  imagen={post.data.imagen}
  readTime={post.data.readTime}
  canonical={canonical}
  slug={post.id}
>
  <Content />
</ArticleLayout>
