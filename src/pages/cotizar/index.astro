---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { WHATSAPP_NUMBER, WHATSAPP_DISPLAY, PHONE_DISPLAY, EMAIL_CONTACT } from '@/lib/config';
---

<BaseLayout
  title="Cotizar Seguridad para Eventos — Presupuesto en 24 Horas"
  description="Solicita tu cotización de seguridad para eventos. Sin compromiso. Respuesta en menos de 24 horas con propuesta detallada y plan operativo personalizado."
>
  <section class="py-16 lg:py-20 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Formulario -->
        <div>
          <span class="text-secondary text-xs font-bold uppercase tracking-widest">Cotización gratuita</span>
          <h1 class="text-3xl sm:text-4xl font-black text-light mt-3 mb-4">Solicita tu presupuesto de seguridad</h1>
          <p class="text-accent leading-relaxed mb-8">Completa el formulario y recibe una propuesta detallada en menos de 24 horas. Sin compromiso.</p>

          <form class="space-y-5" action={`https://wa.me/${WHATSAPP_NUMBER}`} method="get" target="_blank" id="cotizar-form">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="nombre" class="block text-light text-sm font-semibold mb-1.5">Nombre completo *</label>
                <input type="text" id="nombre" name="nombre" required class="w-full bg-primary border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors placeholder:text-accent/50" placeholder="Tu nombre" />
              </div>
              <div>
                <label for="empresa" class="block text-light text-sm font-semibold mb-1.5">Empresa / Organizador</label>
                <input type="text" id="empresa" name="empresa" class="w-full bg-primary border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors placeholder:text-accent/50" placeholder="Nombre de la empresa" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="telefono" class="block text-light text-sm font-semibold mb-1.5">Teléfono / WhatsApp *</label>
                <input type="tel" id="telefono" name="telefono" required class="w-full bg-primary border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors placeholder:text-accent/50" placeholder="55 1234 5678" />
              </div>
              <div>
                <label for="email" class="block text-light text-sm font-semibold mb-1.5">Email</label>
                <input type="email" id="email" name="email" class="w-full bg-primary border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors placeholder:text-accent/50" placeholder="tu@email.com" />
              </div>
            </div>

            <div>
              <label for="tipo" class="block text-light text-sm font-semibold mb-1.5">Tipo de evento *</label>
              <select id="tipo" name="tipo" required class="w-full bg-primary border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors">
                <option value="">Selecciona...</option>
                <option value="Concierto o festival">Concierto o festival</option>
                <option value="Evento corporativo">Evento corporativo</option>
                <option value="Feria o exposición">Feria o exposición</option>
                <option value="Boda o evento social">Boda o evento social</option>
                <option value="Evento deportivo">Evento deportivo</option>
                <option value="Evento masivo (+10,000)">Evento masivo (+10,000)</option>
                <option value="Protección VIP">Protección VIP / Ejecutiva</option>
                <option value="Otro">Otro</option>
              </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="aforo" class="block text-light text-sm font-semibold mb-1.5">Asistentes estimados *</label>
                <select id="aforo" name="aforo" required class="w-full bg-primary border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors">
                  <option value="">Selecciona...</option>
                  <option value="Menos de 100">Menos de 100</option>
                  <option value="100 - 500">100 - 500</option>
                  <option value="500 - 2,000">500 - 2,000</option>
                  <option value="2,000 - 5,000">2,000 - 5,000</option>
                  <option value="5,000 - 15,000">5,000 - 15,000</option>
                  <option value="Más de 15,000">Más de 15,000</option>
                </select>
              </div>
              <div>
                <label for="ciudad" class="block text-light text-sm font-semibold mb-1.5">Ciudad *</label>
                <select id="ciudad" name="ciudad" required class="w-full bg-primary border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors">
                  <option value="">Selecciona...</option>
                  <option value="CDMX">Ciudad de México</option>
                  <option value="Guadalajara">Guadalajara</option>
                  <option value="Monterrey">Monterrey</option>
                  <option value="Puebla">Puebla</option>
                  <option value="Cancún">Cancún</option>
                  <option value="Otra">Otra ciudad</option>
                </select>
              </div>
            </div>

            <div>
              <label for="detalles" class="block text-light text-sm font-semibold mb-1.5">Detalles del evento</label>
              <textarea id="detalles" name="detalles" rows="4" class="w-full bg-primary border border-primary-light rounded-lg px-4 py-3 text-light text-sm focus:border-secondary focus:ring-1 focus:ring-secondary outline-none transition-colors placeholder:text-accent/50 resize-none" placeholder="Fecha, venue, servicios requeridos, detalles adicionales..."></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-secondary hover:bg-red-700 text-white px-6 py-4 rounded-lg font-bold uppercase tracking-wide text-sm transition-colors flex items-center justify-center gap-2"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
              </svg>
              Enviar solicitud de cotización
            </button>

            <p class="text-accent text-xs text-center">Al enviar aceptas nuestro <a href="/aviso-de-privacidad" class="text-secondary hover:underline">aviso de privacidad</a>. Respuesta en menos de 24 horas.</p>
          </form>
        </div>

        <!-- Sidebar info -->
        <div class="space-y-6 lg:pt-16">
          <!-- Contacto directo -->
          <div class="bg-primary border border-primary-light rounded-xl p-6">
            <h2 class="text-light font-bold text-lg mb-4">¿Prefieres contacto directo?</h2>
            <div class="space-y-4">
              <a href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C+necesito+cotizar+seguridad+para+mi+evento`} target="_blank" rel="noopener" class="flex items-center gap-3 p-3 bg-green-900/20 border border-green-700/30 rounded-lg hover:border-green-500/50 transition-colors group">
                <div class="w-10 h-10 bg-green-600 rounded-full flex items-center justify-center flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-light font-semibold text-sm group-hover:text-green-400 transition-colors">WhatsApp</div>
                  <div class="text-accent text-xs">{WHATSAPP_DISPLAY}</div>
                </div>
              </a>
              <a href={`tel:${PHONE_DISPLAY.replace(/\\s/g,'')}`} class="flex items-center gap-3 p-3 bg-secondary/10 border border-secondary/20 rounded-lg hover:border-secondary/40 transition-colors group">
                <div class="w-10 h-10 bg-secondary rounded-full flex items-center justify-center flex-shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-light font-semibold text-sm group-hover:text-secondary transition-colors">Teléfono</div>
                  <div class="text-accent text-xs">{PHONE_DISPLAY}</div>
                </div>
              </a>
            </div>
          </div>

          <!-- Qué incluye la cotización -->
          <div class="bg-primary border border-primary-light rounded-xl p-6">
            <h3 class="text-light font-bold text-sm mb-4">¿Qué incluye nuestra cotización?</h3>
            <ul class="space-y-3">
              {[
                "Número de elementos recomendado",
                "Plan operativo personalizado",
                "Desglose de costos por servicio",
                "Perfil del personal asignado",
                "Equipamiento incluido",
                "Protocolo de emergencia básico",
              ].map((item: string) => (
                <li class="flex items-center gap-2 text-accent text-sm">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.5" class="flex-shrink-0" aria-hidden="true">
                    <path d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Garantías -->
          <div class="bg-secondary rounded-xl p-6 text-center">
            <div class="text-3xl mb-3">⚡</div>
            <h3 class="text-white font-black text-lg mb-2">Respuesta en 24 horas</h3>
            <p class="text-red-100 text-sm">Cotización detallada, profesional y sin compromiso. Si nos necesitas urgente, llama directo.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('cotizar-form') as HTMLFormElement;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const nombre = (document.getElementById('nombre') as HTMLInputElement)?.value || '';
      const empresa = (document.getElementById('empresa') as HTMLInputElement)?.value || '';
      const telefono = (document.getElementById('telefono') as HTMLInputElement)?.value || '';
      const tipo = (document.getElementById('tipo') as HTMLSelectElement)?.value || '';
      const aforo = (document.getElementById('aforo') as HTMLSelectElement)?.value || '';
      const ciudad = (document.getElementById('ciudad') as HTMLSelectElement)?.value || '';
      const detalles = (document.getElementById('detalles') as HTMLTextAreaElement)?.value || '';

      let msg = `Hola, solicito cotización de seguridad:\n\n`;
      msg += `Nombre: ${nombre}\n`;
      if (empresa) msg += `Empresa: ${empresa}\n`;
      msg += `Tel: ${telefono}\n`;
      msg += `Tipo: ${tipo}\n`;
      msg += `Asistentes: ${aforo}\n`;
      msg += `Ciudad: ${ciudad}\n`;
      if (detalles) msg += `\nDetalles: ${detalles}`;

      window.open(`https://wa.me/5215512345678?text=${encodeURIComponent(msg)}`, '_blank');
    });
  </script>
</BaseLayout>
