---
import BaseLayout from '@layouts/BaseLayout.astro';
import TrustBadges from '@components/TrustBadges.astro';

const whatsappUrl = 'https://wa.me/5215512345678?text=Hola%2C+necesito+seguridad+para+mi+evento';
---

<BaseLayout
  title="Contacto | Seguridad Eventos"
  description="Contacta a Seguridad Eventos. Telefono, email, WhatsApp y direccion en CDMX. Atencion de lunes a sabado. Respuesta en menos de 24 horas."
>
  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Estamos para ayudarte</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
        <span class="text-secondary">Contactanos</span>
      </h1>
      <p class="text-accent text-lg sm:text-xl max-w-3xl mx-auto leading-relaxed">
        Estamos listos para atenderte. Escribenos, llamanos o visitanos en nuestras oficinas en la Ciudad de Mexico.
      </p>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
        <!-- Contact Form -->
        <div class="lg:col-span-3">
          <form action="#" method="POST" class="bg-primary/30 border border-primary-light/40 rounded-xl p-6 sm:p-8 space-y-6">
            <h2 class="text-2xl font-black text-light mb-2">Enviar Mensaje</h2>
            <p class="text-accent text-sm mb-6">Completa el formulario y te responderemos a la brevedad.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Nombre -->
              <div>
                <label for="nombre" class="block text-light text-sm font-semibold mb-2">Nombre completo *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors"
                  placeholder="Tu nombre"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-light text-sm font-semibold mb-2">Correo electronico *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors"
                  placeholder="tu@email.com"
                />
              </div>
            </div>

            <!-- Telefono -->
            <div>
              <label for="telefono" class="block text-light text-sm font-semibold mb-2">Telefono</label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors"
                placeholder="+52 55 1234 5678"
              />
            </div>

            <!-- Asunto -->
            <div>
              <label for="asunto" class="block text-light text-sm font-semibold mb-2">Asunto *</label>
              <input
                type="text"
                id="asunto"
                name="asunto"
                required
                class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors"
                placeholder="Motivo de tu mensaje"
              />
            </div>

            <!-- Mensaje -->
            <div>
              <label for="mensaje" class="block text-light text-sm font-semibold mb-2">Mensaje *</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors resize-vertical"
                placeholder="Escribenos tu mensaje o consulta..."
              ></textarea>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="w-full sm:w-auto bg-secondary hover:bg-red-700 text-light px-10 py-4 rounded-lg text-lg font-bold uppercase tracking-wider transition-all hover:scale-105 flex items-center justify-center gap-3"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
              Enviar Mensaje
            </button>
          </form>
        </div>

        <!-- Contact Info Sidebar -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Telefono -->
          <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6">
            <div class="flex items-center gap-4 mb-3">
              <div class="w-12 h-12 rounded-full bg-secondary/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <h3 class="text-light font-bold text-sm">Telefono</h3>
                <a href="tel:+525512345678" class="text-secondary font-semibold hover:text-red-400 transition-colors">
                  +52 55 1234 5678
                </a>
              </div>
            </div>
          </div>

          <!-- Email -->
          <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6">
            <div class="flex items-center gap-4 mb-3">
              <div class="w-12 h-12 rounded-full bg-secondary/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <h3 class="text-light font-bold text-sm">Email</h3>
                <a href="mailto:contacto@seguridadeventos.com.mx" class="text-secondary font-semibold hover:text-red-400 transition-colors text-sm">
                  contacto@seguridadeventos.com.mx
                </a>
              </div>
            </div>
          </div>

          <!-- Direccion -->
          <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-secondary/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-light font-bold text-sm">Direccion</h3>
                <p class="text-accent text-sm mt-1 leading-relaxed">
                  Av. Paseo de la Reforma<br />
                  Col. Juarez, Cuauhtemoc<br />
                  Ciudad de Mexico, CDMX
                </p>
              </div>
            </div>
          </div>

          <!-- WhatsApp -->
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 bg-green-600 hover:bg-green-700 text-light px-6 py-4 rounded-xl font-bold uppercase tracking-wider transition-all hover:scale-105 w-full"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Escribir por WhatsApp
          </a>

          <!-- Horario -->
          <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-gold/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-light font-bold text-sm">Horario de Atencion</h3>
                <div class="text-accent text-sm mt-2 space-y-1">
                  <p>Lunes a Viernes: <span class="text-light font-semibold">8:00 - 18:00</span></p>
                  <p>Sabado: <span class="text-light font-semibold">9:00 - 14:00</span></p>
                  <p>Domingo: <span class="text-accent/60">Cerrado</span></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Map Placeholder -->
      <div class="mt-12">
        <div class="bg-primary/20 border border-primary-light/30 rounded-xl h-64 sm:h-80 flex items-center justify-center">
          <div class="text-center">
            <svg class="w-12 h-12 text-accent/40 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span class="text-accent/40 text-lg font-semibold">Mapa</span>
            <p class="text-accent/30 text-sm mt-1">Av. Paseo de la Reforma, Col. Juarez, CDMX</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />
</BaseLayout>
