---
import BaseLayout from '@layouts/BaseLayout.astro';
import ClientsSection from '@components/ClientsSection.astro';
import TestimonialsSection from '@components/TestimonialsSection.astro';
import CTABanner from '@components/CTABanner.astro';

const tiposClientes = [
  {
    title: 'Productoras de Espectaculos',
    description: 'Trabajamos con las principales productoras de musica y entretenimiento en Mexico, gestionando la seguridad de conciertos, festivales y giras con audiencias de miles de personas.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 11-.99-3.467l2.31-.66a2.25 2.25 0 001.632-2.163zm0 0V2.25L9 5.25v10.303m0 0v3.75a2.25 2.25 0 01-1.632 2.163l-1.32.377a1.803 1.803 0 01-.99-3.467l2.31-.66A2.25 2.25 0 009 15.553z" /></svg>`,
  },
  {
    title: 'Corporativos',
    description: 'Empresas nacionales e internacionales confian en nosotros para proteger sus convenciones, lanzamientos de productos, juntas directivas y eventos de integracion empresarial.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" /></svg>`,
  },
  {
    title: 'Gobierno',
    description: 'Proporcionamos seguridad para eventos gubernamentales, ceremonias oficiales y actos publicos, cumpliendo con los protocolos institucionales mas rigurosos.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21" /></svg>`,
  },
  {
    title: 'Venues y Recintos',
    description: 'Arenas, centros de convenciones, auditorios y espacios para eventos nos eligen como su proveedor de seguridad de confianza para sus operaciones regulares y eventos especiales.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" /></svg>`,
  },
  {
    title: 'Agencias de Eventos',
    description: 'Colaboramos con agencias de organizacion de eventos que requieren un socio confiable en seguridad para complementar sus servicios de produccion y logistica.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>`,
  },
  {
    title: 'Hoteles y Hospitality',
    description: 'Hoteles de lujo y cadenas hoteleras nos contratan para la seguridad de sus eventos privados, galas, conferencias y celebraciones exclusivas dentro de sus instalaciones.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.562.562 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>`,
  },
];
---

<BaseLayout
  title="Nuestros Clientes | Seguridad Eventos"
  description="Conoce los clientes que confian en Seguridad Eventos: productoras, corporativos, gobierno, venues, agencias y hoteles en todo Mexico."
>
  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Relaciones de confianza</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
        Nuestros <span class="text-secondary">Clientes</span>
      </h1>
      <p class="text-accent text-lg sm:text-xl max-w-3xl mx-auto leading-relaxed">
        Empresas, organizaciones y productoras de todo Mexico confian en nosotros para proteger sus eventos mas importantes. Nuestra mejor carta de presentacion son los resultados.
      </p>
    </div>
  </section>

  <!-- Clients Section Component -->
  <ClientsSection />

  <!-- Tipos de Clientes -->
  <section class="py-20 bg-primary/20 border-y border-primary/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Sectores que atendemos</span>
        <h2 class="text-3xl sm:text-4xl font-black text-light mt-2 mb-4">
          Tipos de <span class="text-secondary">Clientes</span>
        </h2>
        <p class="text-accent text-lg max-w-2xl mx-auto">
          Nos adaptamos a las necesidades especificas de cada sector, ofreciendo soluciones de seguridad a la medida.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {tiposClientes.map((tipo) => (
          <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6 hover:border-secondary/30 transition-all">
            <div class="text-secondary mb-4" set:html={tipo.icon} />
            <h3 class="text-light font-bold text-lg mb-3">{tipo.title}</h3>
            <p class="text-accent text-sm leading-relaxed">{tipo.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Component -->
  <TestimonialsSection />

  <!-- CTA -->
  <CTABanner
    title="Unete a nuestros clientes satisfechos"
    subtitle="Solicita una cotizacion y descubre por que las empresas mas exigentes nos eligen para proteger sus eventos."
  />
</BaseLayout>
