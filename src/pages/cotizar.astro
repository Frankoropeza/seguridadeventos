---
import BaseLayout from '@layouts/BaseLayout.astro';
import TrustBadges from '@components/TrustBadges.astro';

const whatsappUrl = 'https://wa.me/5215512345678?text=Hola%2C+necesito+seguridad+para+mi+evento';
---

<BaseLayout
  title="Solicita tu Cotizacion | Seguridad Eventos"
  description="Solicita una cotizacion sin compromiso para seguridad de eventos. Respuesta en menos de 24 horas. Conciertos, corporativos, sociales y mas."
>
  <!-- Hero -->
  <section class="pt-24 pb-16 bg-gradient-to-b from-primary/40 to-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Cotizacion gratuita</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-light mt-3 mb-6">
        Solicita tu <span class="text-secondary">Cotizacion</span>
      </h1>
      <p class="text-accent text-lg sm:text-xl max-w-3xl mx-auto leading-relaxed">
        Cuentanos sobre tu evento y nuestros expertos disenaran un plan de seguridad personalizado. Respuesta garantizada en menos de 24 horas.
      </p>
    </div>
  </section>

  <!-- Form Section -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Form -->
        <div class="lg:col-span-2">
          <form action="#" method="POST" class="bg-primary/30 border border-primary-light/40 rounded-xl p-6 sm:p-8 space-y-6">
            <h2 class="text-2xl font-black text-light mb-2">Datos de tu Evento</h2>
            <p class="text-accent text-sm mb-6">Completa el formulario y te enviaremos una propuesta detallada.</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Nombre -->
              <div>
                <label for="nombre" class="block text-light text-sm font-semibold mb-2">Nombre completo *</label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors"
                  placeholder="Tu nombre"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-light text-sm font-semibold mb-2">Correo electronico *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors"
                  placeholder="tu@email.com"
                />
              </div>

              <!-- Telefono -->
              <div>
                <label for="telefono" class="block text-light text-sm font-semibold mb-2">Telefono *</label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  required
                  class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors"
                  placeholder="+52 55 1234 5678"
                />
              </div>

              <!-- Tipo de Evento -->
              <div>
                <label for="tipo-evento" class="block text-light text-sm font-semibold mb-2">Tipo de evento *</label>
                <select
                  id="tipo-evento"
                  name="tipo-evento"
                  required
                  class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light focus:outline-none focus:border-secondary transition-colors"
                >
                  <option value="" disabled selected>Selecciona el tipo</option>
                  <option value="concierto-festival">Concierto / Festival</option>
                  <option value="corporativo">Corporativo</option>
                  <option value="social">Social</option>
                  <option value="deportivo">Deportivo</option>
                  <option value="feria-expo">Feria / Expo</option>
                  <option value="gubernamental">Gubernamental</option>
                  <option value="otro">Otro</option>
                </select>
              </div>

              <!-- Fecha del Evento -->
              <div>
                <label for="fecha" class="block text-light text-sm font-semibold mb-2">Fecha del evento *</label>
                <input
                  type="date"
                  id="fecha"
                  name="fecha"
                  required
                  class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light focus:outline-none focus:border-secondary transition-colors"
                />
              </div>

              <!-- Numero de Asistentes -->
              <div>
                <label for="asistentes" class="block text-light text-sm font-semibold mb-2">Numero de asistentes *</label>
                <select
                  id="asistentes"
                  name="asistentes"
                  required
                  class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light focus:outline-none focus:border-secondary transition-colors"
                >
                  <option value="" disabled selected>Selecciona un rango</option>
                  <option value="1-100">1 - 100 personas</option>
                  <option value="100-500">100 - 500 personas</option>
                  <option value="500-1000">500 - 1,000 personas</option>
                  <option value="1000-5000">1,000 - 5,000 personas</option>
                  <option value="5000-10000">5,000 - 10,000 personas</option>
                  <option value="10000+">Mas de 10,000 personas</option>
                </select>
              </div>
            </div>

            <!-- Ubicacion -->
            <div>
              <label for="ubicacion" class="block text-light text-sm font-semibold mb-2">Ubicacion del evento *</label>
              <input
                type="text"
                id="ubicacion"
                name="ubicacion"
                required
                class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors"
                placeholder="Ciudad, venue o direccion"
              />
            </div>

            <!-- Mensaje -->
            <div>
              <label for="mensaje" class="block text-light text-sm font-semibold mb-2">Mensaje / Detalles adicionales</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="4"
                class="w-full bg-dark border border-primary-light/40 rounded-lg px-4 py-3 text-light placeholder-accent/50 focus:outline-none focus:border-secondary transition-colors resize-vertical"
                placeholder="Describe los detalles de tu evento, necesidades especificas de seguridad, areas VIP, etc."
              ></textarea>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="w-full sm:w-auto bg-secondary hover:bg-red-700 text-light px-10 py-4 rounded-lg text-lg font-bold uppercase tracking-wider transition-all hover:scale-105 flex items-center justify-center gap-3"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
              Enviar Solicitud
            </button>
          </form>
        </div>

        <!-- Sidebar -->
        <div class="space-y-8">
          <!-- Por que cotizar -->
          <div class="bg-primary/30 border border-primary-light/40 rounded-xl p-6 sm:p-8">
            <h3 class="text-xl font-black text-light mb-6">¿Por que cotizar con nosotros?</h3>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <span class="text-light font-semibold text-sm">Cotizacion sin compromiso</span>
                  <p class="text-accent text-xs mt-1">Recibe una propuesta detallada sin costo alguno.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <span class="text-light font-semibold text-sm">Respuesta en 24 horas</span>
                  <p class="text-accent text-xs mt-1">Nuestro equipo te contactara en menos de un dia habil.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <span class="text-light font-semibold text-sm">Plan personalizado</span>
                  <p class="text-accent text-xs mt-1">Cada propuesta se adapta a las necesidades de tu evento.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <span class="text-light font-semibold text-sm">Precios competitivos</span>
                  <p class="text-accent text-xs mt-1">Tarifas justas respaldadas por calidad y certificaciones.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-secondary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <span class="text-light font-semibold text-sm">Asesoria experta</span>
                  <p class="text-accent text-xs mt-1">Nuestros especialistas te guian en cada paso.</p>
                </div>
              </li>
            </ul>
          </div>

          <!-- WhatsApp CTA -->
          <div class="bg-green-900/30 border border-green-700/40 rounded-xl p-6 sm:p-8 text-center">
            <h3 class="text-light font-black text-lg mb-3">¿Prefieres WhatsApp?</h3>
            <p class="text-accent text-sm mb-6">
              Escribenos directamente y recibe atencion inmediata de nuestro equipo.
            </p>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-green-600 hover:bg-green-700 text-light px-6 py-3 rounded-lg font-bold uppercase tracking-wider transition-all hover:scale-105 w-full"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              Escribir por WhatsApp
            </a>
            <p class="text-accent/60 text-xs mt-3">+52 55 1234 5678</p>
          </div>

          <!-- Telefono -->
          <div class="bg-primary/20 border border-primary-light/30 rounded-xl p-6 text-center">
            <h3 class="text-light font-bold text-sm mb-2">Llamanos directamente</h3>
            <a href="tel:+525512345678" class="text-secondary font-black text-xl hover:text-red-400 transition-colors">
              +52 55 1234 5678
            </a>
            <p class="text-accent text-xs mt-2">Lun-Vie 8:00 - 18:00 | Sab 9:00 - 14:00</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <TrustBadges />
</BaseLayout>
