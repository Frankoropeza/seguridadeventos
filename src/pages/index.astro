---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import TrustSection from '@/components/TrustSection.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import TestimonialsSection from '@/components/TestimonialsSection.astro';
import CTABanner from '@/components/CTABanner.astro';
import BlogCard from '@/components/BlogCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { SITE, ZONAS_NAV, WHATSAPP_NUMBER } from '@/lib/config';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog', ({ data }: { data: { draft: boolean } }) => !data.draft)).slice(0, 6);

const serviciosHome = [
  { icon: "🎵", title: "Conciertos y Festivales", description: "Control de multitudes, protección de artistas y coordinación con autoridades. Más de 200 eventos musicales protegidos.", features: ["Control de multitudes", "Backstage seguro", "Coordinación institucional"], href: "/servicios/seguridad-conciertos-festivales", badge: "Popular" },
  { icon: "🏢", title: "Eventos Corporativos", description: "Seguridad discreta para convenciones, lanzamientos y galas. Personal bilingüe y protocolos de confidencialidad.", features: ["Personal bilingüe", "Dress code adaptable", "NDA incluido"], href: "/servicios/seguridad-eventos-corporativos" },
  { icon: "🚪", title: "Control de Acceso", description: "Verificación de boletos, detección de armas, gestión de aforo y credencialización para cualquier tipo de evento.", features: ["Detectores de metales", "Escaneo QR", "Aforo en tiempo real"], href: "/servicios/control-acceso-eventos", badge: "Esencial" },
  { icon: "⭐", title: "Seguridad VIP", description: "Protección de celebridades, artistas y ejecutivos. Escoltas certificados, anti-paparazzi y rutas seguras.", features: ["Close protection", "Vehículo blindado", "Discreción total"], href: "/servicios/seguridad-vip" },
  { icon: "🎉", title: "Eventos Sociales", description: "Bodas, XV años y fiestas privadas con seguridad invisible pero presente. Valet parking y control de invitados.", features: ["Dress code formal", "Valet parking", "Manejo discreto"], href: "/servicios/seguridad-eventos-sociales" },
  { icon: "🏟️", title: "Eventos Masivos", description: "Operación de seguridad para +10,000 asistentes. Drones, centro de comando y coordinación con Protección Civil.", features: ["Drones de vigilancia", "Puesto de mando", "Plan de contingencia"], href: "/servicios/seguridad-masivos", featured: true },
];
---

<BaseLayout
  title="SeguridadEventos — Seguridad Privada para Eventos en México | DGSSP"
  description="Empresa líder en seguridad privada para eventos en México. Conciertos, corporativos, ferias, bodas y masivos. +500 eventos protegidos. Licencia DGSSP. Cotización en 24 hrs."
>
  <HeroSection />

  <!-- Servicios destacados -->
  <section class="py-20 bg-dark" id="servicios">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Nuestros servicios"
        titulo="Seguridad especializada para cada tipo de evento"
        subtitulo="10 servicios diseñados para cubrir cualquier necesidad de seguridad, desde una boda íntima hasta un festival con 100,000 asistentes."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {serviciosHome.map((s: any) => (
          <ServiceCard
            icon={s.icon}
            title={s.title}
            description={s.description}
            features={s.features}
            href={s.href}
            badge={s.badge}
            featured={s.featured}
          />
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/servicios" class="inline-flex items-center gap-2 text-secondary hover:text-red-400 font-bold text-sm uppercase tracking-wide transition-colors group">
          Ver todos los servicios
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <TrustSection />
  <ProcessSection />

  <!-- Cobertura -->
  <section class="py-20 bg-dark">
    <div class="w-full px-[5%] xl:px-[7%]">
      <SectionHeader
        eyebrow="Cobertura nacional"
        titulo="Operamos en toda la República Mexicana"
        subtitulo="Personal local certificado en las principales ciudades del país."
      />

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {ZONAS_NAV.map((z: {slug: string; nombre: string}) => (
          <a href={`/zonas/${z.slug}`} class="flex flex-col items-center gap-2 p-5 bg-primary border border-primary-light rounded-xl hover:border-secondary/40 transition-colors text-center group">
            <span class="text-2xl">📍</span>
            <span class="text-light font-bold text-sm group-hover:text-secondary transition-colors">{z.nombre}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <TestimonialsSection />

  <!-- Blog reciente -->
  {blogPosts.length > 0 && (
    <section class="py-20 bg-dark">
      <div class="w-full px-[5%] xl:px-[7%]">
        <SectionHeader
          eyebrow="Conocimiento"
          titulo="Blog de Seguridad para Eventos"
          subtitulo="Guías prácticas, consejos de expertos y análisis del sector."
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {blogPosts.map((post: any) => (
            <BlogCard
              titulo={post.data.title}
              descripcion={post.data.description}
              slug={post.slug}
              categoria={post.data.categoria}
              imagen={post.data.imagen}
              readTime={post.data.readTime}
            />
          ))}
        </div>

        <div class="text-center mt-10">
          <a href="/blog" class="inline-flex items-center gap-2 text-secondary hover:text-red-400 font-bold text-sm uppercase tracking-wide transition-colors group">
            Ver todos los artículos
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="group-hover:translate-x-1 transition-transform" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <CTABanner />
</BaseLayout>
