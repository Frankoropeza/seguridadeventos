---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/HeroSection.astro';
import ServiceCard from '@components/ServiceCard.astro';

const servicios = [
  {
    icon: '🚪',
    title: 'Control de Acceso',
    description: 'Gestión integral de entradas y salidas con tecnología de punta y personal capacitado.',
    features: ['Verificación de boletos y credenciales', 'Detección de objetos prohibidos', 'Conteo de aforo en tiempo real'],
  },
  {
    icon: '🔭',
    title: 'Vigilancia Perimetral',
    description: 'Monitoreo constante del perímetro con rondines estratégicos y puntos de control.',
    features: ['Rondines programados', 'Puntos de control vehicular', 'Comunicación por radio cifrada'],
  },
  {
    icon: '💂',
    title: 'Guardias de Seguridad',
    description: 'Personal certificado con experiencia en manejo de multitudes y primeros auxilios.',
    features: ['Certificación STPS', 'Primeros auxilios', 'Resolución de conflictos'],
  },
  {
    icon: '⭐',
    title: 'Eventos VIP',
    description: 'Protección especializada para eventos exclusivos con protocolos discretos.',
    features: ['Acceso restringido personalizado', 'Escoltas de proximidad', 'Logística de seguridad VIP'],
  },
  {
    icon: '🛡️',
    title: 'Protección Ejecutiva',
    description: 'Escoltas profesionales para artistas, directivos y personalidades de alto perfil.',
    features: ['Análisis de riesgo previo', 'Rutas seguras', 'Coordinación con autoridades'],
  },
  {
    icon: '📹',
    title: 'Cámaras CCTV',
    description: 'Circuito cerrado de televisión con monitoreo en tiempo real y grabación continua.',
    features: ['Instalación temporal profesional', 'Monitoreo 24/7', 'Respaldo de evidencia digital'],
  },
];

const tiposEventos = [
  { icon: '🎵', nombre: 'Conciertos y Festivales', desc: 'Masivos, con manejo de multitudes y protocolo anti-estampida.' },
  { icon: '💒', nombre: 'Bodas y Sociales', desc: 'Seguridad discreta que protege sin interferir con la celebración.' },
  { icon: '🏢', nombre: 'Corporativos', desc: 'Convenciones, lanzamientos y reuniones de alto nivel empresarial.' },
  { icon: '⚽', nombre: 'Deportivos', desc: 'Estadios, maratones y competencias con control de barras y aforo.' },
  { icon: '🏛️', nombre: 'Gubernamentales', desc: 'Eventos oficiales con protocolos de seguridad institucional.' },
];
---

<BaseLayout
  title="Seguridad Eventos"
  description="Empresa líder en seguridad privada y control de acceso para eventos en México. Más de 15 años de experiencia, 500+ eventos protegidos y 1,000+ guardias certificados."
>
  <!-- Hero -->
  <HeroSection />

  <!-- Servicios -->
  <section id="servicios" class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Lo que ofrecemos</span>
        <h2 class="text-3xl sm:text-4xl font-black text-light mt-2">Nuestros Servicios</h2>
        <p class="text-accent mt-4 max-w-2xl mx-auto">
          Soluciones integrales de seguridad diseñadas para cada tipo de evento.
          Cada servicio se adapta a las necesidades específicas de tu operación.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicios.map((servicio) => (
          <ServiceCard
            icon={servicio.icon}
            title={servicio.title}
            description={servicio.description}
            features={servicio.features}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Números de Impacto -->
  <section class="py-20 bg-primary/20 border-y border-primary/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Trayectoria comprobada</span>
        <h2 class="text-3xl sm:text-4xl font-black text-light mt-2">Los Números Hablan</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-4xl sm:text-5xl font-black text-secondary">500+</div>
          <div class="text-accent text-sm mt-2">Eventos protegidos</div>
        </div>
        <div class="text-center">
          <div class="text-4xl sm:text-5xl font-black text-secondary">1,000+</div>
          <div class="text-accent text-sm mt-2">Guardias certificados</div>
        </div>
        <div class="text-center">
          <div class="text-4xl sm:text-5xl font-black text-secondary">15+</div>
          <div class="text-accent text-sm mt-2">Años de experiencia</div>
        </div>
        <div class="text-center">
          <div class="text-4xl sm:text-5xl font-black text-secondary">0</div>
          <div class="text-accent text-sm mt-2">Incidentes graves</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tipos de Eventos -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-secondary text-sm font-semibold uppercase tracking-widest">Especialistas en</span>
        <h2 class="text-3xl sm:text-4xl font-black text-light mt-2">Tipos de Eventos</h2>
        <p class="text-accent mt-4 max-w-2xl mx-auto">
          Cada evento tiene sus propios riesgos y requiere protocolos específicos.
          Nuestro equipo se adapta a cualquier escenario.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {tiposEventos.map((tipo) => (
          <div class="flex items-start gap-4 bg-primary/20 border border-primary/40 rounded-xl p-6 hover:border-secondary/30 transition-all">
            <span class="text-3xl flex-shrink-0">{tipo.icon}</span>
            <div>
              <h3 class="text-light font-bold text-lg">{tipo.nombre}</h3>
              <p class="text-accent text-sm mt-1 leading-relaxed">{tipo.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Final / Contacto -->
  <section id="contacto" class="py-20 bg-gradient-to-b from-primary/30 to-dark">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-secondary text-sm font-semibold uppercase tracking-widest">¿Listo para proteger tu evento?</span>
      <h2 class="text-3xl sm:text-4xl font-black text-light mt-2 mb-6">
        Solicita tu Cotización Sin Compromiso
      </h2>
      <p class="text-accent text-lg mb-10 leading-relaxed">
        Cuéntanos sobre tu evento y nuestros expertos diseñarán un plan de seguridad
        personalizado. Respuesta en menos de 24 horas.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="tel:+525512345678"
          class="w-full sm:w-auto bg-secondary hover:bg-red-700 text-light px-8 py-4 rounded-lg text-lg font-bold uppercase tracking-wider transition-all hover:scale-105 flex items-center justify-center gap-3"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Llamar Ahora
        </a>
        <a
          href="mailto:contacto@seguridadeventos.com.mx"
          class="w-full sm:w-auto border-2 border-accent/30 hover:border-accent text-light px-8 py-4 rounded-lg text-lg font-semibold uppercase tracking-wider transition-all hover:bg-primary/30 flex items-center justify-center gap-3"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Enviar Email
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
