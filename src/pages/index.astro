---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/HeroSection.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import TrustSection from '@/components/TrustSection.astro';
import ProcessSection from '@/components/ProcessSection.astro';
import TestimonialsSection from '@/components/TestimonialsSection.astro';
import CTABanner from '@/components/CTABanner.astro';
import BlogCard from '@/components/BlogCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import SectionNav from '@/components/SectionNav.astro';
import { SITE, ZONAS_NAV, WHATSAPP_NUMBER } from '@/lib/config';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog', ({ data }: { data: { draft: boolean } }) => !data.draft)).slice(0, 6);

const serviciosHome = [
  { title: "Conciertos y Festivales",  description: "Control de multitudes, protección de artistas y coordinación con autoridades. Más de 200 eventos musicales protegidos.",              features: ["Control de multitudes", "Backstage seguro", "Coordinación institucional"],    href: "/servicios/seguridad-conciertos-festivales",  badge: "Popular"  },
  { title: "Eventos Corporativos",     description: "Seguridad discreta para convenciones, lanzamientos y galas. Personal bilingüe y protocolos de confidencialidad.",                   features: ["Personal bilingüe", "Dress code adaptable", "NDA incluido"],                  href: "/servicios/seguridad-eventos-corporativos"                        },
  { title: "Control de Acceso",        description: "Verificación de boletos, detección de armas, gestión de aforo y credencialización para cualquier tipo de evento.",                  features: ["Detectores de metales", "Escaneo QR", "Aforo en tiempo real"],               href: "/servicios/control-acceso-eventos",            badge: "Esencial" },
  { title: "Seguridad VIP",            description: "Protección de celebridades, artistas y ejecutivos. Escoltas certificados, anti-paparazzi y rutas seguras.",                         features: ["Close protection", "Vehículo blindado", "Discreción total"],                  href: "/servicios/seguridad-vip"                                         },
  { title: "Protección Ejecutiva",     description: "Seguridad personal para directivos, empresarios y figuras públicas. Evaluación de riesgos, contravigilancia y traslados seguros.",  features: ["Análisis de riesgo", "Contravigilancia", "Traslados seguros"],                href: "/servicios/proteccion-ejecutiva"                                   },
  { title: "Ferias y Exposiciones",    description: "Operativos de seguridad para recintos feriales con múltiples expositores, flujos constantes de visitantes y activos de alto valor.", features: ["Seguridad de stands", "Control de accesos", "Resguardo de activos"],          href: "/servicios/seguridad-ferias-exposiciones"                          },
  { title: "Eventos Sociales",         description: "Bodas, XV años y fiestas privadas con seguridad invisible pero presente. Valet parking y control de invitados.",                    features: ["Dress code formal", "Valet parking", "Manejo discreto"],                      href: "/servicios/seguridad-eventos-sociales"                             },
  { title: "Eventos Deportivos",       description: "Seguridad para estadios, arenas y competencias. Barras, zonas VIP, protección de atletas y coordinación con federaciones.",         features: ["Separación de barras", "Zona VIP", "Protocolo federativo"],                   href: "/servicios/seguridad-eventos-deportivos"                           },
  { title: "Eventos Masivos",          description: "Operación de seguridad para +10,000 asistentes. Drones, centro de comando y coordinación con Protección Civil.",                   features: ["Drones de vigilancia", "Puesto de mando", "Plan de contingencia"],            href: "/servicios/seguridad-masivos",                featured: true    },
  { title: "Montaje y Desmontaje",     description: "Resguardo de equipo, artistas, materiales y activos durante las fases de instalación y retiro del evento.",                         features: ["Custodia de equipo", "Control de proveedores", "Accesos restringidos"],       href: "/servicios/seguridad-montaje-desmontaje"                           },
];

const servImg: Record<string,string> = {
  "/servicios/seguridad-conciertos-festivales": "/img/eventos/seguridad-conciertos-festivales",
  "/servicios/seguridad-eventos-corporativos":  "/img/eventos/seguridad-eventos-corporativos",
  "/servicios/control-acceso-eventos":          "/img/eventos/control-acceso-eventos",
  "/servicios/seguridad-vip":                   "/img/eventos/seguridad-vip-eventos",
  "/servicios/proteccion-ejecutiva":            "/img/eventos/proteccion-ejecutiva-mexico",
  "/servicios/seguridad-ferias-exposiciones":   "/img/eventos/seguridad-empresarial-evento",
  "/servicios/seguridad-eventos-sociales":      "/img/eventos/seguridad-vip-gala",
  "/servicios/seguridad-eventos-deportivos":    "/img/eventos/seguridad-conciertos-multitud",
  "/servicios/seguridad-masivos":               "/img/eventos/guardias-seguridad-privada",
  "/servicios/seguridad-montaje-desmontaje":    "/img/eventos/equipo-seguridad-eventos",
};
---

<BaseLayout
  title="SeguridadEventos — Seguridad Privada para Eventos en México | DGSSP"
  description="Empresa líder en seguridad privada para eventos en México. Conciertos, corporativos, ferias, bodas y masivos. +500 eventos protegidos. Licencia DGSSP. Cotización en 24 hrs."
>
  <HeroSection />
  <SectionNav />

  <!-- Servicios destacados -->
  <section class="py-20 bg-dark" id="servicios">
    <div class="w-full px-[5%] xl:px-[7%]">

      <!-- Encabezado de dos columnas -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 mb-10 pb-10 border-b border-white/8 lg:items-stretch">

        <!-- Columna izquierda: título -->
        <div class="flex flex-col">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest mb-2">Nuestros servicios</span>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-3">
            Seguridad especializada para cada tipo de evento
          </h2>
          <p class="text-accent text-base leading-relaxed">
            10 servicios diseñados para cubrir cualquier necesidad de seguridad, desde una boda íntima hasta un festival con 100,000 asistentes.
          </p>
        </div>

        <!-- Columna derecha: párrafos SEO -->
        <div class="flex flex-col gap-3">
          <p class="text-accent text-sm leading-relaxed">
            En <strong class="text-light font-semibold">SEPRIEV</strong> hemos desarrollado a lo largo de 30 años una cartera de servicios de seguridad privada para eventos que cubre desde el control de accesos y la gestión de multitudes hasta la protección ejecutiva VIP y la coordinación con autoridades. Cada servicio está respaldado por <strong class="text-light font-semibold">personal certificado DGSSP y STPS</strong>, protocolos operativos documentados y un historial verificable de más de 500 eventos sin incidentes graves.
          </p>
          <p class="text-accent text-sm leading-relaxed">
            Ya sea un evento social íntimo, una convención corporativa de alto perfil, un concierto masivo o una feria de exposición internacional, nuestros equipos se integran de forma discreta y eficiente al operativo de cada cliente. Diseñamos el <strong class="text-light font-semibold">plan de seguridad específico para cada evento</strong>, ajustando el número de elementos, las posiciones, los protocolos de contingencia y la coordinación institucional según las necesidades reales de cada producción.
          </p>
        </div>

      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {serviciosHome.map((s: any) => (
          <ServiceCard
            title={s.title}
            description={s.description}
            features={s.features}
            href={s.href}
            image={servImg[s.href]}
            badge={s.badge}
            featured={s.featured}
          />
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/cotizar" class="inline-flex items-center gap-2 bg-secondary hover:bg-red-700 text-white px-8 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
          Solicitar Cotización
        </a>
      </div>

      <!-- Módulo marketing + galería -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 mt-20 pt-16 border-t border-white/8">

        <!-- Columna izquierda: servicio destacado -->
        <div class="flex flex-col h-full">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-secondary text-xs font-bold uppercase tracking-widest">Servicio destacado</span>
            <span class="bg-secondary text-white text-[10px] font-black uppercase tracking-widest px-2 py-0.5">Popular</span>
          </div>
          <div class="w-8 h-0.5 bg-secondary mb-3"></div>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-4">
            Conciertos y Festivales
          </h2>

          <p class="text-light/80 text-base leading-relaxed mb-5">
            SEPRIEV lleva más de 200 eventos musicales operados en México, desde foros íntimos con 500 personas hasta festivales de aforo superior a 80,000 asistentes. Cada operativo arranca con un análisis de riesgo específico para el recinto, el cartel artístico y el perfil de la afición esperada, porque no existe una sola fórmula válida para todos los conciertos. Lo que sí existe es un equipo entrenado para anticipar lo que puede salir mal antes de que ocurra.
          </p>

          <ul class="flex flex-col gap-5 mb-6">
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">Control de multitudes</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                Los flujos de entrada y salida se diseñan antes del día del evento, no se improvisan cuando el público ya está afuera. El equipo de SEPRIEV define puntos de acceso, velocidades de ingreso y zonas de amortiguamiento entre sectores, y entrena al personal para reconocer señales tempranas de compresión de multitudes o tensión entre aficionados. Actuar en los primeros segundos es la diferencia entre una situación controlada y un incidente con consecuencias.
              </p>
            </li>
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">Backstage seguro</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                El acceso a camerinos, plataformas técnicas y zonas de producción se regula mediante credencialización por niveles: cada persona entra solo a donde su función lo justifica. Los proveedores externos son verificados en cada acceso, no solo al inicio de la jornada, porque las fases de montaje y desmontaje concentran el mayor riesgo de extravío de equipo y de presencia no autorizada en áreas sensibles. La vigilancia perimetral no se detiene entre el soundcheck y el encendido del escenario.
              </p>
            </li>
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">Coordinación institucional</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                Policía Municipal, Protección Civil, Bomberos y servicios médicos de emergencia no son actores externos al operativo: son parte del mismo. SEPRIEV establece antes del evento un canal de radio exclusivo, un puesto de mando unificado y un protocolo de escalamiento con roles definidos para cada institución. Cuando ocurre un incidente simultáneo en dos sectores del recinto, la respuesta coordinada ya está ensayada y no depende de decisiones improvisadas.
              </p>
            </li>
          </ul>

          <div class="flex flex-col sm:flex-row gap-4 mt-auto">
            <a href="/servicios/seguridad-conciertos-festivales" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
              Ver servicio
            </a>
            <a href="/cotizar" class="inline-flex items-center justify-center gap-2 border border-white/20 hover:border-white/40 text-accent hover:text-light px-7 py-3 text-sm font-semibold transition-colors">
              Solicitar Cotización
            </a>
          </div>
        </div>

        <!-- Columna derecha: galería 1 grande + 2 pequeñas -->
        <div class="flex flex-col gap-4">

          <!-- Imagen grande -->
          <div class="relative w-full aspect-[16/9] overflow-hidden bg-primary">
            <picture>
              <source type="image/avif" srcset="/img/eventos/seguridad-conciertos-festivales-640.avif 640w, /img/eventos/seguridad-conciertos-festivales-1200.avif 1200w" sizes="(max-width: 1024px) 100vw, 600px" />
              <source type="image/jpeg" srcset="/img/eventos/seguridad-conciertos-festivales-640.jpg 640w, /img/eventos/seguridad-conciertos-festivales-1200.jpg 1200w" sizes="(max-width: 1024px) 100vw, 600px" />
              <img src="/img/eventos/seguridad-conciertos-festivales-1200.jpg" alt="Conciertos y Festivales — seguridad para eventos SEPRIEV" class="w-full h-full object-cover" loading="lazy" decoding="async" width="1200" height="675" />
            </picture>
          </div>

          <!-- Dos imágenes pequeñas -->
          <div class="grid grid-cols-2 gap-4">
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
              <picture>
                <source type="image/avif" srcset="/img/eventos/seguridad-conciertos-multitud-640.avif" />
                <img src="/img/eventos/seguridad-conciertos-multitud-640.jpg" alt="Conciertos y Festivales — SEPRIEV" class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
              </picture>
            </div>
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
              <picture>
                <source type="image/avif" srcset="/img/eventos/personal-seguridad-evento-640.avif" />
                <img src="/img/eventos/personal-seguridad-evento-640.jpg" alt="Conciertos y Festivales — SEPRIEV" class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
              </picture>
            </div>
          </div>

        </div>
      </div>

      <!-- Módulo Eventos Corporativos -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 mt-20 pt-16 border-t border-white/8">

        <!-- Columna izquierda: servicio destacado -->
        <div class="flex flex-col h-full">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-secondary text-xs font-bold uppercase tracking-widest">Servicio destacado</span>
          </div>
          <div class="w-8 h-0.5 bg-secondary mb-3"></div>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-4">
            Eventos Corporativos
          </h2>

          <p class="text-light/80 text-base leading-relaxed mb-5">
            Las convenciones, los lanzamientos de producto y las cenas de gala corporativas exigen un tipo de seguridad que muchas empresas nunca verán en operación, porque está diseñada para no verse. SEPRIEV despliega en eventos corporativos a través de México personal bilingüe formado en protocolo empresarial, capaz de moverse entre directivos y delegaciones internacionales sin generar fricciones ni llamar la atención. El objetivo es que la seguridad sea parte del ambiente, no un elemento que lo rompe.
          </p>

          <ul class="flex flex-col gap-5 mb-6">
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">Personal bilingüe</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                Los elementos asignados a eventos corporativos tienen dominio del inglés suficiente para interactuar con asistentes extranjeros, gestionar accesos con representantes de otras delegaciones y coordinar con equipos de seguridad internacionales cuando el evento lo requiere. Su formación incluye etiqueta corporativa, manejo de situaciones delicadas sin escalar el tono y comunicación con el equipo de producción del cliente sin interrumpir el ritmo del evento.
              </p>
            </li>
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">Dress code adaptable</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                Un mismo evento puede requerir traje en el salón principal, uniforme táctico en el área de carga y ropa de civil en los accesos perimetrales. SEPRIEV adapta la vestimenta del equipo a cada zona y momento del operativo, porque presentarse con uniforme de seguridad donde el cliente no lo espera puede comprometer tanto la imagen del evento como la efectividad del personal. La instrucción sobre vestimenta forma parte del briefing previo a cada operativo.
              </p>
            </li>
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">NDA incluido</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                Antes de cada evento corporativo, todo el personal firma un acuerdo de no divulgación que cubre información estratégica, identidades de asistentes, acuerdos comerciales observados durante el operativo y cualquier detalle de la logística interna del cliente. Este estándar no es opcional ni reservado para clientes de alto perfil: aplica en cada asignación corporativa de SEPRIEV, porque la confidencialidad es parte del servicio, no un plus negociable.
              </p>
            </li>
          </ul>

          <div class="flex flex-col sm:flex-row gap-4 mt-auto">
            <a href="/servicios/seguridad-eventos-corporativos" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
              Ver servicio
            </a>
            <a href="/cotizar" class="inline-flex items-center justify-center gap-2 border border-white/20 hover:border-white/40 text-accent hover:text-light px-7 py-3 text-sm font-semibold transition-colors">
              Solicitar Cotización
            </a>
          </div>
        </div>

        <!-- Columna derecha: galería 1 grande + 2 pequeñas -->
        <div class="flex flex-col gap-4">

          <!-- Imagen grande -->
          <div class="relative w-full aspect-[16/9] overflow-hidden bg-primary">
            <picture>
              <source type="image/avif" srcset="/img/eventos/seguridad-eventos-corporativos-640.avif 640w, /img/eventos/seguridad-eventos-corporativos-1200.avif 1200w" sizes="(max-width: 1024px) 100vw, 600px" />
              <source type="image/jpeg" srcset="/img/eventos/seguridad-eventos-corporativos-640.jpg 640w, /img/eventos/seguridad-eventos-corporativos-1200.jpg 1200w" sizes="(max-width: 1024px) 100vw, 600px" />
              <img src="/img/eventos/seguridad-eventos-corporativos-1200.jpg" alt="Eventos Corporativos — seguridad para eventos SEPRIEV" class="w-full h-full object-cover" loading="lazy" decoding="async" width="1200" height="675" />
            </picture>
          </div>

          <!-- Dos imágenes pequeñas -->
          <div class="grid grid-cols-2 gap-4">
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
              <picture>
                <source type="image/avif" srcset="/img/eventos/seguridad-empresarial-evento-640.avif" />
                <img src="/img/eventos/seguridad-empresarial-evento-640.jpg" alt="Eventos Corporativos — SEPRIEV" class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
              </picture>
            </div>
            <div class="relative w-full aspect-[4/3] overflow-hidden bg-primary">
              <picture>
                <source type="image/avif" srcset="/img/eventos/equipo-seguridad-eventos-640.avif" />
                <img src="/img/eventos/equipo-seguridad-eventos-640.jpg" alt="Eventos Corporativos — SEPRIEV" class="w-full h-full object-cover" loading="lazy" decoding="async" width="640" height="480" />
              </picture>
            </div>
          </div>

        </div>
      </div>

      <!-- Módulo Control de Acceso -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 mt-20 pt-16 border-t border-white/8">

        <!-- Columna izquierda: servicio destacado -->
        <div class="flex flex-col h-full">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-secondary text-xs font-bold uppercase tracking-widest">Servicio destacado</span>
            <span class="bg-secondary text-white text-[10px] font-black uppercase tracking-widest px-2 py-0.5">Esencial</span>
          </div>
          <div class="w-8 h-0.5 bg-secondary mb-3"></div>
          <h2 class="text-3xl sm:text-4xl font-black text-light leading-tight mb-4">
            Control de Acceso
          </h2>

          <p class="text-light/80 text-base leading-relaxed mb-5">
            El punto de acceso es donde se gana o se pierde la seguridad de un evento antes de que empiece. SEPRIEV opera control de acceso en eventos de todo tipo en México con personal entrenado específicamente para este rol, no con elementos reasignados de otras posiciones. Verificamos boletos, detectamos objetos prohibidos, gestionamos el aforo en tiempo real y credencializamos a cada categoría de participante con criterios distintos, porque el acceso de un técnico de producción no puede tratarse igual que el de un asistente general.
          </p>

          <ul class="flex flex-col gap-5 mb-6">
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">Detectores de metales</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                Los arcos detectores de metales fijos se complementan con detectores de mano para revisión secundaria cuando el arco genera señal. El personal que opera estos equipos está entrenado para mantener una cadencia de ingreso alta incluso en picos de demanda, evitando cuellos de botella que generan presión en el exterior del recinto. La configuración de sensibilidad se ajusta según el tipo de evento y el perfil de riesgo definido en el plan de seguridad.
              </p>
            </li>
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">Escaneo QR</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                La validación de boletos digitales y físicos se realiza con lectores conectados en tiempo real a la base de datos del organizador, lo que permite detectar duplicados y boletos falsificados en el momento del ingreso, no horas después. SEPRIEV coordina con el sistema de ticketing del cliente para asegurar compatibilidad operativa antes del día del evento, y dispone de un protocolo de contingencia para validación manual cuando la conectividad falla.
              </p>
            </li>
            <li class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-secondary flex-shrink-0"></span>
                <span class="text-light text-base font-semibold">Aforo en tiempo real</span>
              </div>
              <p class="text-light/70 text-sm leading-relaxed pl-4">
                El número de personas dentro del recinto se monitorea de forma continua con contadores en cada acceso, reportes periódicos al puesto de mando y alertas cuando se alcanzan los umbrales de capacidad definidos por el organizador y las autoridades. Los accesos se abren y cierran de forma coordinada para distribuir el flujo de ingreso entre distintas puertas, cumpliendo los límites de aforo sin detener masivamente el ingreso en un solo punto.
              </p>
            </li>
          </ul>

          <div class="flex flex-col sm:flex-row gap-4 mt-auto">
            <a href="/servicios/control-acceso-eventos" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3 text-sm font-bold uppercase tracking-wide transition-colors">
              Ver servicio
            </a>
