---
import BaseLayout from './BaseLayout.astro';
import CTABanner from '@/components/CTABanner.astro';
import { SERVICIOS_NAV, WHATSAPP_NUMBER, SITE } from '@/lib/config';
import { buildServiceSchema, buildFAQSchema } from '@/lib/seo';

export interface Props {
  titulo: string;
  descripcion: string;
  metaTitle?: string;
  metaDescription?: string;
  slug: string;
  emoji?: string;
  imagen?: string;
  faq?: Array<{ q: string; a: string }>;
  breadcrumbs?: Array<{ name: string; href?: string }>;
}

const {
  titulo,
  descripcion,
  metaTitle,
  metaDescription,
  slug,
  emoji = "🛡️",
  imagen,
  faq = [],
  breadcrumbs = [],
} = Astro.props;

const canonical = `https://seguridadeventos.com/servicios/${slug}`;
const ogImg = imagen ? new URL(`${imagen}-1200.jpg`, SITE).toString() : undefined;
const schemas = [
  buildServiceSchema(titulo, descripcion, canonical),
  ...(faq.length ? [buildFAQSchema(faq)] : []),
];

const allBreadcrumbs = [
  { name: "Inicio", href: "/" },
  { name: "Servicios", href: "/servicios" },
  { name: titulo },
  ...breadcrumbs,
];

// Servicios relacionados (todos excepto el actual)
const relacionados = SERVICIOS_NAV.filter(s => s.slug !== slug).slice(0, 4);
---

<BaseLayout title={metaTitle ?? titulo} description={metaDescription ?? descripcion} canonical={canonical} ogImage={ogImg} schema={schemas}>

  <!-- Breadcrumb -->
  <nav class="bg-primary/50 border-b border-primary py-3" aria-label="Breadcrumb">
    <div class="w-full px-[5%] xl:px-[7%]">
      <ol class="flex items-center gap-2 text-xs text-accent flex-wrap">
        {allBreadcrumbs.map((item, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" class="text-primary-light">›</span>}
            {item.href ? (
              <a href={item.href} class="hover:text-light transition-colors">{item.name}</a>
            ) : (
              <span class="text-light font-semibold" aria-current="page">{item.name}</span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- Imagen hero del servicio -->
  {imagen && (
    <div class="w-full h-56 md:h-80 overflow-hidden bg-primary relative">
      <picture>
        <source type="image/avif" srcset={`${imagen}-640.avif 640w, ${imagen}-1200.avif 1200w`} sizes="100vw" />
        <source type="image/jpeg" srcset={`${imagen}-640.jpg 640w, ${imagen}-1200.jpg 1200w`} sizes="100vw" />
        <img src={`${imagen}-1200.jpg`} alt={titulo} class="w-full h-full object-cover" loading="eager" fetchpriority="high" width="1200" height="675" />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-dark/80 via-dark/20 to-transparent"></div>
    </div>
  )}

  <!-- Hero del servicio -->
  <section class="relative bg-gradient-to-br from-dark via-primary to-dark py-16 lg:py-24 border-b border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Col 1 -->
        <div>
          <div class="text-5xl mb-4">{emoji}</div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-light leading-tight mb-5">
            {titulo}
          </h1>
          <p class="text-accent text-lg leading-relaxed mb-8">
            {descripcion}
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/cotizar" class="inline-flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-7 py-3.5 rounded-lg font-bold uppercase text-sm tracking-wide transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
              Cotizar este servicio
            </a>
            <a
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C+necesito+información+sobre+${encodeURIComponent(titulo)}`}
              target="_blank" rel="noopener"
              class="inline-flex items-center justify-center gap-2 border border-green-500/40 hover:border-green-400 text-light px-7 py-3.5 rounded-lg font-semibold text-sm transition-colors"
            >
              💬 Consultar por WhatsApp
            </a>
          </div>
        </div>
        <!-- Col 2: párrafos SEO -->
        <div class="flex flex-col gap-6">
          <div class="bg-primary/60 border border-primary-light rounded-2xl p-7">
            <p class="text-accent leading-relaxed text-sm"><strong class="text-light">SEPRIEV</strong> es la empresa líder en <strong class="text-light">{titulo.toLowerCase()}</strong> en México. Con más de <strong class="text-light">30 años de experiencia</strong> y más de <strong class="text-light">500 eventos protegidos</strong>, contamos con el equipo, la tecnología y los protocolos para garantizar la seguridad total de tu evento. Personal certificado <strong class="text-light">DGSSP y STPS</strong>, con presencia en CDMX, Guadalajara, Monterrey, Puebla y Cancún.</p>
          </div>
          <div class="bg-primary/60 border border-primary-light rounded-2xl p-7">
            <p class="text-accent leading-relaxed text-sm">Nuestra <strong class="text-light">licencia DGSSP federal vigente</strong>, certificaciones <strong class="text-light">STPS e ISO 9001</strong> respaldan cada operación con los más altos estándares de la industria. Elaboramos un <strong class="text-light">plan operativo específico</strong> para tu evento, coordinamos con Protección Civil y servicios de emergencia, y entregamos cotización personalizada en <strong class="text-light">menos de 24 horas</strong> — sin compromiso.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenido MDX -->
  <div class="w-full px-[5%] xl:px-[7%] py-16">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">

      <!-- Artículo principal -->
      <article class="lg:col-span-3 prose prose-invert prose-lg max-w-none
        prose-headings:font-black prose-headings:text-light
        prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-primary prose-h2:pb-3
        prose-h3:text-xl prose-h3:text-secondary prose-h3:mt-8
        prose-p:text-accent prose-p:leading-relaxed
        prose-li:text-accent prose-li:leading-relaxed
        prose-strong:text-light
        prose-a:text-secondary prose-a:no-underline hover:prose-a:underline
        prose-blockquote:border-secondary prose-blockquote:bg-primary/50 prose-blockquote:rounded-r-lg prose-blockquote:py-4 prose-blockquote:px-5
      ">
        <slot />
      </article>

      <!-- Sidebar -->
      <aside class="lg:col-span-1 space-y-6">

        <!-- CTA Sidebar -->
        <div class="bg-secondary rounded-xl p-6 text-center sticky top-24">
          <div class="text-3xl mb-3">🛡️</div>
          <h3 class="text-white font-black text-lg mb-2">¿Necesitas este servicio?</h3>
          <p class="text-red-100 text-sm mb-5">Cotización gratuita en menos de 24 hrs</p>
          <a href="/cotizar" class="block w-full bg-white text-secondary hover:bg-gray-100 px-4 py-3 rounded-lg font-bold text-sm uppercase tracking-wide transition-colors mb-3">
            Solicitar cotización
          </a>
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C+necesito+${encodeURIComponent(titulo)}`}
            target="_blank" rel="noopener"
            class="block w-full border border-white/30 hover:border-white text-white px-4 py-3 rounded-lg font-semibold text-sm transition-colors"
          >
            💬 WhatsApp
          </a>
        </div>

        <!-- Otros servicios -->
        <div class="bg-primary border border-primary-light rounded-xl p-5">
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4">Otros servicios</h3>
          <ul class="space-y-2">
            {relacionados.map(s => (
              <li>
                <a href={`/servicios/${s.slug}`} class="text-accent hover:text-secondary text-sm transition-colors flex items-center gap-2">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                  {s.nombre}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Certificaciones -->
        <div class="bg-primary border border-primary-light rounded-xl p-5">
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4">Certificaciones</h3>
          <div class="space-y-2">
            {[
              { label: "DGSSP", color: "text-secondary" },
              { label: "STPS", color: "text-gold" },
              { label: "ISO 9001", color: "text-green-400" },
            ].map(c => (
              <div class={`flex items-center gap-2 text-sm ${c.color} font-semibold`}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                {c.label} Certificado
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- FAQ si existe -->
  {faq.length > 0 && (
    <section class="py-16 bg-primary/30 border-t border-primary">
      <div class="w-[90%] mx-auto">
        <h2 class="text-2xl font-black text-light mb-8 text-center">Preguntas Frecuentes</h2>
        <div class="space-y-4" id="faq-{slug}">
          {faq.map((item, i) => (
            <div class="bg-primary border border-primary-light rounded-xl overflow-hidden faq-item">
              <button
                class="w-full text-left flex justify-between items-center gap-4 px-6 py-4 text-light font-semibold text-sm hover:text-secondary transition-colors"
                aria-expanded="false"
              >
                <span>{item.q}</span>
                <svg class="w-5 h-5 flex-shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </button>
              <div class="faq-answer hidden px-6 pb-5">
                <p class="text-accent text-sm leading-relaxed">{item.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA Final -->
  <CTABanner
    titulo={`¿Necesitas ${titulo.toLowerCase()} para tu evento?`}
    subtitulo="Contáctanos ahora y recibe una propuesta personalizada sin compromiso."
  />

</BaseLayout>

<script>
  document.querySelectorAll('.faq-item button').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const answer = item?.querySelector('.faq-answer');
      const icon = btn.querySelector('svg');
      const isOpen = !answer?.classList.contains('hidden');
      answer?.classList.toggle('hidden', isOpen);
      icon?.classList.toggle('rotate-180', !isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
