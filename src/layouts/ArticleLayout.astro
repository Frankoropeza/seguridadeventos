---
import BaseLayout from './BaseLayout.astro';
import CTABanner from '@/components/CTABanner.astro';
import BlogSidebar from '@/components/BlogSidebar.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { SITE } from '@/lib/config';
import { buildArticleSchema } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  categoria?: string;
  imagen?: string;
  readTime?: number;
  canonical?: string;
  slug?: string;
}

const {
  title,
  description,
  categoria = 'Blog',
  imagen,
  readTime = 5,
  canonical,
  slug,
} = Astro.props;

const ogImg = imagen ? new URL(`${imagen}-1200.jpg`, SITE).toString() : undefined;
const schema = buildArticleSchema(title, description, canonical || new URL(Astro.url.pathname, SITE).toString(), ogImg);
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImg} schema={schema}>

  <!-- Breadcrumb independiente -->
  <Breadcrumb items={[
    { label: 'Blog', href: '/blog' },
    { label: title }
  ]} />

  <!-- Imagen hero (si hay) -->
  {imagen && (
    <div class="w-full h-64 md:h-96 overflow-hidden bg-primary">
      <picture>
        <source type="image/avif" srcset={`${imagen}-640.avif 640w, ${imagen}-1200.avif 1200w`} sizes="100vw" />
        <source type="image/jpeg" srcset={`${imagen}-640.jpg 640w, ${imagen}-1200.jpg 1200w`} sizes="100vw" />
        <img src={`${imagen}-1200.jpg`} alt={title} class="w-full h-full object-cover" loading="eager" fetchpriority="high" width="1200" height="675" />
      </picture>
    </div>
  )}

  <!-- Layout: Artículo + Sidebar -->
  <div class="w-full px-[5%] xl:px-[7%] py-10 lg:py-14">
    <div class="flex flex-col lg:flex-row gap-10 items-start">

      <!-- Artículo (columna principal) -->
      <div class="flex-1 min-w-0">
        <!-- Header del artículo -->
        <div class="mb-8">
          <span class="bg-secondary/15 text-secondary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest">
            {categoria}
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-light mt-4 mb-4 leading-tight">
            {title}
          </h1>
          <div class="flex items-center gap-4 text-accent text-sm">
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/>
              </svg>
              {readTime} min de lectura
            </span>
            <span class="text-accent/30">·</span>
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              Equipo SEPRIEV
            </span>
          </div>
          <!-- Separator decorativo -->
          <div class="flex items-center gap-3 mt-6">
            <div class="h-px flex-1 bg-gradient-to-r from-secondary/40 to-transparent"></div>
            <div class="w-1.5 h-1.5 bg-secondary rounded-full"></div>
          </div>
        </div>

        <!-- Contenido del artículo -->
        <article class="article-body max-w-none">
          <slot />
        </article>

        <!-- Footer del artículo -->
        <div class="mt-12 pt-8 border-t border-primary">
          <!-- Tags / Categoría -->
          <div class="flex items-center gap-2 mb-6">
            <span class="text-accent text-xs">Categoría:</span>
            <a
              href={`/blog?cat=${encodeURIComponent(categoria)}`}
              class="bg-secondary/15 text-secondary text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest hover:bg-secondary/25 transition-colors"
            >
              {categoria}
            </a>
          </div>

          <!-- Navegación -->
          <div class="flex justify-between items-center flex-wrap gap-4">
            <a href="/blog" class="flex items-center gap-2 text-secondary hover:text-red-400 text-sm font-semibold transition-colors">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
              </svg>
              Volver al blog
            </a>
            <a href="/cotizar" class="bg-secondary hover:bg-red-700 text-white px-5 py-2.5 rounded-lg text-sm font-bold uppercase tracking-wide transition-colors">
              Cotizar seguridad
            </a>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="w-full lg:w-[300px] xl:w-[320px] flex-shrink-0 lg:sticky lg:top-24">
        <BlogSidebar currentSlug={slug} />
      </div>

    </div>
  </div>

  <CTABanner
    titulo="¿Buscas seguridad profesional para tu evento?"
    subtitulo="Cuéntanos sobre tu evento y te enviamos una propuesta personalizada en 24 horas."
    variant="dark"
  />

</BaseLayout>

<style is:global>
  /* ===== Tipografía profesional del cuerpo del artículo (SEPRIEV) ===== */
  .article-body {
    color: #cbd5e1;
    font-size: 1.0625rem;
    line-height: 1.8;
    word-break: break-word;
  }
  .article-body > :first-child { margin-top: 0; }

  /* Encabezados */
  .article-body h2 {
    color: #f9fafb;
    font-size: clamp(1.5rem, 3.5vw, 1.875rem);
    font-weight: 900;
    line-height: 1.25;
    margin: 2.75rem 0 1.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid #243154;
  }
  .article-body h3 {
    color: #f87171;
    font-size: clamp(1.2rem, 2.5vw, 1.4rem);
    font-weight: 800;
    line-height: 1.3;
    margin: 2rem 0 0.75rem;
  }
  .article-body h4 {
    color: #f9fafb;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.5rem 0 0.6rem;
  }

  /* Párrafos y énfasis */
  .article-body p { margin: 1.1rem 0; }
  .article-body strong { color: #f9fafb; font-weight: 700; }
  .article-body em { color: #e2e8f0; }

  /* Enlaces */
  .article-body a {
    color: #f87171;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid rgba(248, 113, 113, 0.35);
    transition: color .15s ease, border-color .15s ease;
  }
  .article-body a:hover { color: #fca5a5; border-bottom-color: #fca5a5; }

  /* Listas */
  .article-body ul,
  .article-body ol { margin: 1.1rem 0; padding-left: 1.5rem; }
  .article-body li { margin: 0.55rem 0; padding-left: 0.2rem; }
  .article-body ul li::marker { color: #dc2626; }
  .article-body ol li::marker { color: #f87171; font-weight: 700; }
  .article-body li > ul,
  .article-body li > ol { margin: 0.5rem 0; }

  /* Cita / Callout de marca ("SEPRIEV en campo") */
  .article-body blockquote {
    margin: 1.75rem 0;
    padding: 1.1rem 1.25rem 1.1rem 1.4rem;
    background: linear-gradient(180deg, rgba(26,37,64,.7), rgba(26,37,64,.45));
    border-left: 4px solid #dc2626;
    border-radius: 0 .6rem .6rem 0;
    color: #e2e8f0;
  }
  .article-body blockquote p { margin: 0.4rem 0; }
  .article-body blockquote p:first-child { margin-top: 0; }
  .article-body blockquote p:last-child { margin-bottom: 0; }
  .article-body blockquote strong { color: #fca5a5; }

  /* ===== Tablas comparativas ===== */
  .article-body table {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.9rem 0;
    font-size: 0.95rem;
    border: 1px solid #243154;
    border-radius: .6rem;
    -webkit-overflow-scrolling: touch;
  }
  .article-body thead { background: #1a2540; }
  .article-body th {
    color: #f9fafb;
    font-weight: 700;
    text-align: left;
    padding: 0.8rem 1rem;
    white-space: nowrap;
    border-bottom: 2px solid #dc2626;
    font-size: 0.8rem;
    letter-spacing: .03em;
    text-transform: uppercase;
  }
  .article-body td {
    padding: 0.75rem 1rem;
    border-top: 1px solid rgba(255,255,255,.06);
    color: #cbd5e1;
    vertical-align: top;
  }
  .article-body tbody tr:nth-child(even) { background: rgba(255,255,255,.025); }
  .article-body tbody tr:hover { background: rgba(220,38,38,.07); }
  .article-body tbody td:first-child { color: #f1f5f9; font-weight: 600; }

  /* Código en línea */
  .article-body code {
    background: rgba(255,255,255,.08);
    color: #fca5a5;
    padding: .12rem .4rem;
    border-radius: .3rem;
    font-size: .9em;
  }

  /* Separadores e imágenes */
  .article-body hr { border: 0; border-top: 1px solid #243154; margin: 2.25rem 0; }
  .article-body img { border-radius: .6rem; margin: 1.5rem 0; max-width: 100%; height: auto; }

  @media (max-width: 640px) {
    .article-body { font-size: 1rem; line-height: 1.75; }
    .article-body th, .article-body td { padding: 0.6rem 0.7rem; }
  }
</style>
