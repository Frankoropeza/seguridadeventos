---
import { organizationSchema, websiteSchema } from '@/lib/seo';
import { SITE, SITE_NAME, SITE_DESC, PHONE_DISPLAY, WHATSAPP_NUMBER, SERVICIOS_NAV, ZONAS_NAV } from '@/lib/config';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESC,
  canonical,
  ogImage = '/img/og-seguridadeventos.jpg',
  schema,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE).toString();
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const schemas = [
  organizationSchema,
  websiteSchema,
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];

// Navegación
const navMain = [
  { href: "/",             label: "Inicio" },
  { href: "/servicios",    label: "Servicios" },
  { href: "/nosotros",     label: "Nosotros" },
  { href: "/certificaciones", label: "Certificaciones" },
  { href: "/blog",         label: "Blog" },
  { href: "/contacto",     label: "Contacto" },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es-MX" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO Básico -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Geo -->
  <meta name="geo.region" content="MX" />
  <meta name="geo.placename" content="Ciudad de México" />
  <meta name="language" content="es-MX" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, SITE).toString()} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="es_MX" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, SITE).toString()} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Global width styles -->
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
    }
    /* Smooth section transitions */
    section { width: 100%; }
    /* Better scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0a0f1a; }
    ::-webkit-scrollbar-thumb { background: #1a2540; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #dc2626; }
  </style>

  <!-- Fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Schemas -->
  {schemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>

<body class="bg-dark text-light font-sans antialiased">

  <!-- TOPBAR -->
  <div class="bg-secondary/90 backdrop-blur text-white text-xs py-2 hidden md:block">
    <div class="w-full px-[5%] flex justify-between items-center">
      <span>🛡️ Licencia DGSSP · Certificados STPS · +500 eventos protegidos</span>
      <div class="flex items-center gap-4">
        <a href={`tel:${PHONE_DISPLAY.replace(/\s/g,'')}`} class="hover:underline">📞 {PHONE_DISPLAY}</a>
        <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" class="hover:underline">💬 WhatsApp</a>
      </div>
    </div>
  </div>

  <!-- HEADER -->
  <header class="sticky top-0 z-50 bg-dark/95 backdrop-blur border-b border-primary">
    <div class="w-full px-[5%] xl:px-[7%]">
      <div class="flex items-center justify-between h-16 md:h-20">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group" aria-label={SITE_NAME}>
          <div class="w-10 h-10 bg-secondary rounded-lg flex items-center justify-center flex-shrink-0">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <div class="leading-tight">
            <div class="text-light font-black text-lg tracking-tight group-hover:text-secondary transition-colors">SEGURIDAD</div>
            <div class="text-secondary font-bold text-sm -mt-1 tracking-widest uppercase">Eventos</div>
          </div>
        </a>

        <!-- Nav desktop -->
        <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
          {navMain.map(item => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`px-4 py-2 rounded-lg text-sm font-semibold transition-colors ${
                  isActive
                    ? 'bg-secondary text-white'
                    : 'text-accent hover:text-light hover:bg-primary'
                }`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- CTA -->
        <div class="flex items-center gap-3">
          <a
            href="/cotizar"
            class="hidden sm:inline-flex items-center gap-2 bg-secondary hover:bg-red-700 text-white px-5 py-2.5 rounded-lg text-sm font-bold uppercase tracking-wide transition-colors"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            Cotizar
          </a>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            class="lg:hidden p-2 text-accent hover:text-light rounded-lg"
            aria-label="Abrir menú"
            aria-expanded="false"
          >
            <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="icon-close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-primary bg-dark">
      <nav class="w-full px-[5%] py-4 flex flex-col gap-1">
        {navMain.map(item => (
          <a href={item.href} class="px-4 py-3 rounded-lg text-sm font-semibold text-accent hover:text-light hover:bg-primary transition-colors">
            {item.label}
          </a>
        ))}
        <a href="/cotizar" class="mt-2 bg-secondary text-white px-4 py-3 rounded-lg text-sm font-bold uppercase text-center">
          Solicitar Cotización
        </a>
      </nav>
    </div>
  </header>

  <!-- MAIN -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="bg-primary border-t border-primary-light mt-20">
    <div class="w-full px-[5%] xl:px-[7%] py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

        <!-- Marca -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-secondary rounded-lg flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div>
              <div class="text-light font-black text-base">SEGURIDAD</div>
              <div class="text-secondary font-bold text-xs -mt-0.5 tracking-widest uppercase">Eventos</div>
            </div>
          </div>
          <p class="text-accent text-sm leading-relaxed mb-4">
            Empresa líder en seguridad privada para eventos en México. Licencia DGSSP, personal certificado STPS.
          </p>
          <div class="flex gap-3">
            <span class="text-xs bg-secondary/20 border border-secondary/30 text-secondary px-2 py-1 rounded">DGSSP</span>
            <span class="text-xs bg-gold/20 border border-gold/30 text-gold px-2 py-1 rounded">STPS</span>
            <span class="text-xs bg-green-900/30 border border-green-700/30 text-green-400 px-2 py-1 rounded">ISO 9001</span>
          </div>
        </div>

        <!-- Servicios -->
        <div>
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4">Servicios</h3>
          <ul class="space-y-2">
            {SERVICIOS_NAV.slice(0, 6).map(s => (
              <li>
                <a href={`/servicios/${s.slug}`} class="text-accent hover:text-light text-sm transition-colors">
                  {s.nombre}
                </a>
              </li>
            ))}
            <li>
              <a href="/servicios" class="text-secondary hover:text-red-400 text-sm font-semibold transition-colors">
                Ver todos los servicios →
              </a>
            </li>
          </ul>
        </div>

        <!-- Cobertura -->
        <div>
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4">Cobertura</h3>
          <ul class="space-y-2">
            {ZONAS_NAV.map(z => (
              <li>
                <a href={`/zonas/${z.slug}`} class="text-accent hover:text-light text-sm transition-colors">
                  {z.nombre}
                </a>
              </li>
            ))}
          </ul>
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mt-6 mb-4">Empresa</h3>
          <ul class="space-y-2">
            <li><a href="/nosotros" class="text-accent hover:text-light text-sm transition-colors">Nosotros</a></li>
            <li><a href="/certificaciones" class="text-accent hover:text-light text-sm transition-colors">Certificaciones</a></li>
            <li><a href="/blog" class="text-accent hover:text-light text-sm transition-colors">Blog</a></li>
            <li><a href="/contacto" class="text-accent hover:text-light text-sm transition-colors">Contacto</a></li>
          </ul>
        </div>

        <!-- Contacto -->
        <div>
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4">Contacto</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <a href={`tel:${PHONE_DISPLAY.replace(/\s/g,'')}`} class="text-accent hover:text-light text-sm transition-colors">{PHONE_DISPLAY}</a>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-green-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener" class="text-accent hover:text-light text-sm transition-colors">WhatsApp</a>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span class="text-accent text-sm">Ciudad de México, CDMX</span>
            </li>
          </ul>
          <a href="/cotizar" class="mt-6 w-full block bg-secondary hover:bg-red-700 text-white px-4 py-3 rounded-lg text-sm font-bold uppercase text-center transition-colors">
            Solicitar Cotización
          </a>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="border-t border-primary-light mt-12 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-accent">
        <p>© {new Date().getFullYear()} {SITE_NAME}. Todos los derechos reservados.</p>
        <div class="flex gap-4">
          <a href="/aviso-de-privacidad" class="hover:text-light transition-colors">Aviso de Privacidad</a>
          <a href="/terminos" class="hover:text-light transition-colors">Términos y Condiciones</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- WhatsApp flotante -->
  <a
    href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C+necesito+información+sobre+seguridad+para+mi+evento`}
    target="_blank"
    rel="noopener"
    class="fixed bottom-6 right-6 z-50 bg-green-500 hover:bg-green-400 text-white w-14 h-14 rounded-full flex items-center justify-center shadow-2xl transition-colors"
    aria-label="Contactar por WhatsApp"
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <!-- Mobile menu script -->
  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    btn?.addEventListener('click', () => {
      const isOpen = !menu?.classList.contains('hidden');
      menu?.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden', !isOpen);
      iconClose?.classList.toggle('hidden', isOpen);
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  </script>
</body>
</html>
