---
import { organizationSchema, websiteSchema } from '@/lib/seo';
import { SITE, SITE_NAME, SITE_DESC, PHONE_DISPLAY, WHATSAPP_NUMBER, SERVICIOS_NAV, ZONAS_NAV } from '@/lib/config';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESC,
  canonical,
  ogImage = '/img/og-sepriev.jpg',
  schema,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, SITE).toString();
const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const schemas = [
  organizationSchema,
  websiteSchema,
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];

const currentPath = Astro.url.pathname;

const navMain = [
  { href: "/",                label: "Inicio",          dropdown: null },
  { href: "/servicios",       label: "Servicios",       dropdown: SERVICIOS_NAV.map(s => ({ href: `/servicios/${s.slug}`, label: s.nombre })) },
  { href: "/nosotros",        label: "Nosotros",        dropdown: null },
  { href: "/certificaciones", label: "Certificaciones", dropdown: null },
  { href: "/blog",            label: "Blog",            dropdown: null },
  { href: "/contacto",        label: "Contacto",        dropdown: null },
];
---

<!doctype html>
<html lang="es-MX" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO Básico -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Geo -->
  <meta name="geo.region" content="MX" />
  <meta name="geo.placename" content="Ciudad de México" />
  <meta name="language" content="es-MX" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, SITE).toString()} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="es_MX" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, SITE).toString()} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Global width styles -->
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
    }
    /* Smooth section transitions */
    section { width: 100%; }
    /* Better scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0a0f1a; }
    ::-webkit-scrollbar-thumb { background: #1a2540; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #dc2626; }
  </style>

  <!-- Fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Schemas -->
  {schemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>

<body class="bg-dark text-light font-sans antialiased">

  <!-- TOPBAR -->
  <div class="bg-secondary/90 backdrop-blur text-white text-xs py-2 hidden md:block">
    <div class="w-full px-[5%] flex justify-between items-center">
      <span class="font-semibold tracking-wide">SEGURIDAD PRIVADA PARA EVENTOS · Licencia DGSSP · Certificados STPS · +500 eventos protegidos</span>
      <div class="flex items-center gap-4">
        <a href={`tel:${PHONE_DISPLAY.replace(/\s/g,'')}`} class="hover:underline">{PHONE_DISPLAY}</a>
        <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" class="hover:underline">WhatsApp</a>
      </div>
    </div>
  </div>

  <!-- HEADER -->
  <header id="site-header" class="sticky top-0 z-50 transition-all duration-300 bg-white border-b border-gray-200">
    <div class="w-full px-[5%] xl:px-[7%] py-3 md:py-4">
      <div class="flex items-center justify-between">

        <!-- Logo -->
        <a href="/" class="flex items-center flex-shrink-0" aria-label="SEPRIEV — Seguridad Privada para Eventos">
          <img
            src="/img/logo-sepriev.png"
            alt="SEPRIEV — Seguridad Privada para Eventos"
            class="h-14 md:h-[68px] w-auto"
            loading="eager"
            decoding="async"
          />
        </a>

        <!-- Nav desktop -->
        <nav class="hidden lg:flex items-center gap-0.5" aria-label="Navegación principal">
          {navMain.map(item => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            if (item.dropdown) {
              return (
                <div class="relative group/dd">
                  <button
                    class={`flex items-center gap-1.5 px-4 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 ${
                      isActive ? 'text-secondary bg-secondary/10 border border-secondary/20' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
                    }`}
                    aria-haspopup="true"
                  >
                    {item.label}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform duration-200 group-hover/dd:rotate-180" aria-hidden="true">
                      <path d="M6 9l6 6 6-6"/>
                    </svg>
                  </button>
                  <!-- Dropdown -->
                  <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover/dd:opacity-100 group-hover/dd:visible transition-all duration-200 pointer-events-none group-hover/dd:pointer-events-auto">
                    <div class="bg-dark border border-white/10 rounded-xl shadow-2xl shadow-black/50 p-2 min-w-[220px]">
                      <div class="grid grid-cols-1 gap-0.5">
                        {item.dropdown.map((sub: {href: string; label: string}) => (
                          <a
                            href={sub.href}
                            class="px-3 py-2.5 rounded-lg text-sm text-gray-300 hover:text-white hover:bg-white/5 transition-colors flex items-center gap-2 group/sub"
                          >
                            <span class="w-1.5 h-1.5 rounded-full bg-secondary/40 group-hover/sub:bg-secondary transition-colors flex-shrink-0"></span>
                            {sub.label}
                          </a>
                        ))}
                        <div class="border-t border-white/5 mt-1 pt-1">
                          <a href={item.href} class="px-3 py-2.5 rounded-lg text-xs text-secondary hover:text-red-400 font-bold uppercase tracking-wide transition-colors flex items-center gap-2">
                            Ver todos los servicios
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              );
            }
            return (
              <a
                href={item.href}
                class={`relative px-4 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 ${
                  isActive
                    ? 'text-secondary bg-secondary/10 border border-secondary/20'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'
                }`}
              >
                {item.label}
                {isActive && <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-0.5 bg-secondary rounded-full"></span>}
              </a>
            );
          })}
        </nav>

        <!-- CTA + Hamburger -->
        <div class="flex items-center gap-3">
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}`}
            target="_blank"
            rel="noopener"
            class="hidden md:inline-flex items-center gap-2 border border-green-600/40 hover:border-green-600 hover:bg-green-50 text-green-700 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
          <a
            href="/cotizar"
            class="hidden sm:inline-flex items-center gap-2 bg-secondary hover:bg-red-700 text-white px-5 py-2.5 rounded-lg text-sm font-bold uppercase tracking-wide transition-all duration-200 shadow-md shadow-secondary/20 hover:shadow-secondary/40 hover:-translate-y-px"
          >
            Cotizar
          </a>

          <!-- Hamburger -->
          <button
            id="mobile-menu-btn"
            class="lg:hidden relative w-10 h-10 flex flex-col items-center justify-center gap-1.5 rounded-lg hover:bg-gray-100 transition-colors"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-drawer"
          >
            <span class="hamburger-line w-6 h-0.5 bg-gray-800 rounded-full transition-all duration-300 origin-center"></span>
            <span class="hamburger-line w-6 h-0.5 bg-gray-800 rounded-full transition-all duration-300"></span>
            <span class="hamburger-line w-4 h-0.5 bg-gray-800 rounded-full transition-all duration-300 origin-center self-start ml-1"></span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- MOBILE DRAWER OVERLAY -->
  <div id="drawer-overlay" class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm opacity-0 invisible transition-all duration-300 lg:hidden" aria-hidden="true"></div>

  <!-- MOBILE DRAWER -->
  <div
    id="mobile-drawer"
    class="fixed top-0 right-0 z-50 h-full w-[min(380px,90vw)] bg-dark border-l border-white/10 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col"
    aria-label="Menú de navegación"
    role="dialog"
    aria-modal="true"
  >
    <!-- Drawer header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-white/10 flex-shrink-0">
      <a href="/" class="flex items-center">
        <img
          src="/img/logo-sepriev.png"
          alt="SEPRIEV"
          class="h-8 w-auto brightness-0 invert"
          loading="lazy"
          decoding="async"
        />
      </a>
      <button
        id="drawer-close"
        class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-white/5 text-accent hover:text-light transition-colors"
        aria-label="Cerrar menú"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Drawer nav -->
    <nav class="flex-1 overflow-y-auto px-4 py-6 flex flex-col gap-1" aria-label="Navegación móvil">
      {navMain.map(item => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        if (item.dropdown) {
          return (
            <div class="mobile-accordion">
              <button
                class={`mobile-accordion-btn w-full flex items-center justify-between px-4 py-3.5 rounded-xl text-base font-semibold transition-colors ${
                  isActive ? 'text-white bg-secondary/20' : 'text-accent hover:text-light hover:bg-white/5'
                }`}
                aria-expanded="false"
              >
                {item.label}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="accordion-chevron transition-transform duration-200 flex-shrink-0" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </button>
              <div class="mobile-accordion-content hidden px-4 pb-2">
                <div class="border-l-2 border-secondary/30 ml-2 pl-4 flex flex-col gap-0.5 pt-1">
                  {item.dropdown.map((sub: {href: string; label: string}) => (
                    <a href={sub.href} class="py-2.5 text-sm text-accent hover:text-light transition-colors">
                      {sub.label}
                    </a>
                  ))}
                  <a href={item.href} class="py-2.5 text-sm text-secondary font-semibold hover:text-red-400 transition-colors">
                    Ver todos →
                  </a>
                </div>
              </div>
            </div>
          );
        }
        return (
          <a
            href={item.href}
            class={`flex items-center px-4 py-3.5 rounded-xl text-base font-semibold transition-colors ${
              isActive ? 'text-white bg-secondary/20 border border-secondary/20' : 'text-accent hover:text-light hover:bg-white/5'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Drawer footer CTAs -->
    <div class="flex-shrink-0 px-4 py-6 border-t border-white/10 flex flex-col gap-3">
      <a
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola%2C+necesito+información+sobre+seguridad+para+mi+evento`}
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 border border-green-500/40 hover:border-green-400 hover:bg-green-900/20 text-green-400 px-4 py-3.5 rounded-xl text-sm font-semibold transition-all duration-200"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Contactar por WhatsApp
      </a>
      <a
        href="/cotizar"
        class="flex items-center justify-center gap-2 bg-secondary hover:bg-red-700 text-white px-4 py-3.5 rounded-xl text-sm font-bold uppercase tracking-wide transition-all duration-200 shadow-lg shadow-secondary/30"
      >
        Solicitar Cotización
      </a>
      <p class="text-center text-xs text-accent/60">{PHONE_DISPLAY} · Respuesta en 24 hrs</p>
    </div>
  </div>

  <!-- MAIN -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="bg-primary border-t border-primary-light mt-20">
    <div class="w-full px-[5%] xl:px-[7%] py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

        <!-- Marca -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-secondary rounded-lg flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div>
              <div class="text-light font-black text-base">SEGURIDAD</div>
              <div class="text-secondary font-bold text-xs -mt-0.5 tracking-widest uppercase">Eventos</div>
            </div>
          </div>
          <p class="text-accent text-sm leading-relaxed mb-4">
            Empresa líder en seguridad privada para eventos en México. Licencia DGSSP, personal certificado STPS.
          </p>
          <div class="flex gap-3">
            <span class="text-xs bg-secondary/20 border border-secondary/30 text-secondary px-2 py-1 rounded">DGSSP</span>
            <span class="text-xs bg-gold/20 border border-gold/30 text-gold px-2 py-1 rounded">STPS</span>
            <span class="text-xs bg-green-900/30 border border-green-700/30 text-green-400 px-2 py-1 rounded">ISO 9001</span>
          </div>
        </div>

        <!-- Servicios -->
        <div>
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4">Servicios</h3>
          <ul class="space-y-2">
            {SERVICIOS_NAV.slice(0, 6).map(s => (
              <li>
                <a href={`/servicios/${s.slug}`} class="text-accent hover:text-light text-sm transition-colors">
                  {s.nombre}
                </a>
              </li>
            ))}
            <li>
              <a href="/servicios" class="text-secondary hover:text-red-400 text-sm font-semibold transition-colors">
                Ver todos los servicios →
              </a>
            </li>
          </ul>
        </div>

        <!-- Cobertura -->
        <div>
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4">Cobertura</h3>
          <ul class="space-y-2">
            {ZONAS_NAV.map(z => (
              <li>
                <a href={`/zonas/${z.slug}`} class="text-accent hover:text-light text-sm transition-colors">
                  {z.nombre}
                </a>
              </li>
            ))}
          </ul>
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mt-6 mb-4">Empresa</h3>
          <ul class="space-y-2">
            <li><a href="/nosotros" class="text-accent hover:text-light text-sm transition-colors">Nosotros</a></li>
            <li><a href="/certificaciones" class="text-accent hover:text-light text-sm transition-colors">Certificaciones</a></li>
            <li><a href="/blog" class="text-accent hover:text-light text-sm transition-colors">Blog</a></li>
            <li><a href="/contacto" class="text-accent hover:text-light text-sm transition-colors">Contacto</a></li>
          </ul>
        </div>

        <!-- Contacto -->
        <div>
          <h3 class="text-light font-bold text-sm uppercase tracking-widest mb-4">Contacto</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-secondary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <a href={`tel:${PHONE_DISPLAY.replace(/\s/g,'')}`} class="text-accent hover:text-light text-sm transition-colors">{PHONE_DISPLAY}</a>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-4 h-4 text-green-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
