  <!-- Header + Drawer script -->
  <script>
    // ── Scroll effect ──
    const header = document.getElementById('site-header');
    const onScroll = () => {
      if (!header) return;
      if (window.scrollY > 20) {
        header.classList.add('shadow-md', 'shadow-gray-200/80');
      } else {
        header.classList.remove('shadow-md', 'shadow-gray-200/80');
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });

    // ── Hamburger / Drawer ──
    const btn      = document.getElementById('mobile-menu-btn');
    const drawer   = document.getElementById('mobile-drawer');
    const overlay  = document.getElementById('drawer-overlay');
    const closeBtn = document.getElementById('drawer-close');
    const lines    = document.querySelectorAll('.hamburger-line');

    function openDrawer() {
      drawer?.classList.remove('translate-x-full');
      overlay?.classList.remove('opacity-0', 'invisible');
      overlay?.classList.add('opacity-100', 'visible');
      document.body.style.overflow = 'hidden';
      btn?.setAttribute('aria-expanded', 'true');
      // Animate hamburger → X
      if (lines[0]) { (lines[0] as HTMLElement).style.transform = 'rotate(45deg) translate(5px, 5px)'; }
      if (lines[1]) { (lines[1] as HTMLElement).style.opacity = '0'; (lines[1] as HTMLElement).style.transform = 'scaleX(0)'; }
      if (lines[2]) { (lines[2] as HTMLElement).style.transform = 'rotate(-45deg) translate(5px, -5px)'; (lines[2] as HTMLElement).style.width = '24px'; (lines[2] as HTMLElement).style.marginLeft = '0'; }
    }

    function closeDrawer() {
      drawer?.classList.add('translate-x-full');
      overlay?.classList.add('opacity-0', 'invisible');
      overlay?.classList.remove('opacity-100', 'visible');
      document.body.style.overflow = '';
      btn?.setAttribute('aria-expanded', 'false');
      // Reset hamburger
      if (lines[0]) { (lines[0] as HTMLElement).style.transform = ''; }
      if (lines[1]) { (lines[1] as HTMLElement).style.opacity = ''; (lines[1] as HTMLElement).style.transform = ''; }
      if (lines[2]) { (lines[2] as HTMLElement).style.transform = ''; (lines[2] as HTMLElement).style.width = ''; (lines[2] as HTMLElement).style.marginLeft = ''; }
    }

    btn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    overlay?.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

    // Close drawer on nav link click
    drawer?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));

    // ── Mobile accordion ──
    document.querySelectorAll('.mobile-accordion-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const parent  = btn.closest('.mobile-accordion');
        const content = parent?.querySelector('.mobile-accordion-content');
        const chevron = btn.querySelector('.accordion-chevron') as HTMLElement | null;
        const isOpen  = !content?.classList.contains('hidden');

        // Close all
        document.querySelectorAll('.mobile-accordion-content').forEach(c => c.classList.add('hidden'));
        document.querySelectorAll('.accordion-chevron').forEach(c => (c as HTMLElement).style.transform = '');
        document.querySelectorAll('.mobile-accordion-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));

        if (!isOpen) {
          content?.classList.remove('hidden');
          if (chevron) chevron.style.transform = 'rotate(180deg)';
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  </script>
</body>
