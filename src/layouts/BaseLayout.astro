---
import SEO from '@components/SEO.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const { title, description, ogImage, type, publishedTime } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      type={type}
      publishedTime={publishedTime}
    />

    <!-- Schema: LocalBusiness + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["LocalBusiness", "Organization"],
      "name": "Seguridad Eventos",
      "description": "Empresa de seguridad privada y control de acceso para eventos en México.",
      "url": "https://seguridadeventos.com.mx",
      "logo": "https://seguridadeventos.com.mx/favicon.svg",
      "telephone": "+525512345678",
      "email": "contacto@seguridadeventos.com.mx",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ciudad de México",
        "addressCountry": "MX"
      },
      "areaServed": {
        "@type": "Country",
        "name": "México"
      },
      "serviceType": [
        "Seguridad para eventos",
        "Control de acceso",
        "Vigilancia perimetral",
        "Guardias de seguridad",
        "Protección VIP",
        "Protección ejecutiva",
        "CCTV"
      ],
      "foundingDate": "2009",
      "numberOfEmployees": {
        "@type": "QuantitativeValue",
        "minValue": 500,
        "maxValue": 1500
      }
    })} />
  </head>
  <body class="bg-dark text-light font-sans antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
